---
import Button from './Button.astro';
---

<section class="hero" aria-labelledby="hero-title" data-hero-motion>
  <div class="artwork" aria-hidden="true">
    <div class="artwork-stack">
      <img
        class="art-bg"
        src="/images/hero/background.webp"
        width="1583"
        height="993"
        alt=""
        fetchpriority="high"
        decoding="async"
      />
      <img
        class="art-figure"
        src="/images/hero/figure.webp"
        width="1583"
        height="993"
        alt=""
        decoding="async"
      />
    </div>
  </div>
  <div class="hero-veil" aria-hidden="true"></div>
  <div class="hero-sweep" aria-hidden="true"></div>
  <div class="hero-content">
    <div class="copy">
      <h1 id="hero-title">
        <span>SORCERY IN DATA</span>
        <span>MAGIC IN AI</span>
      </h1>
      <p>
        An AI &amp; Data Innovation Community where people learn, experiment,
        research, and build meaningful technology together.
      </p>
    </div>
    <div class="actions" aria-label="Community actions">
      <Button>Join the Community</Button>
      <Button variant="glass">Explore Our Project</Button>
    </div>
  </div>
</section>
<script>
  import { initHeroMotion } from '../scripts/hero-motion';

  initHeroMotion();
</script>
<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: min(903px, 100svh);
    padding: 140px var(--page-gutter) 64px;
    overflow: clip;
  }
  .artwork {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .artwork-stack {
    position: absolute;
    inset: 0;
  }
  .artwork img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-content {
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 7svh, 96px);
    max-width: 1280px;
    margin-inline: auto;
    width: 100%;
  }
  .copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  h1 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 80px;
    font-weight: 400;
    line-height: 98px;
    background: linear-gradient(
      267.1deg,
      #fff 5.29%,
      #dfdfdf 46.05%,
      #dfdfdf 99.19%
    );
    background-clip: text;
    color: transparent;
  }
  h1 span {
    display: block;
  }
  p {
    margin: 0;
    max-width: 619px;
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    letter-spacing: -0.176px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    align-items: center;
  }
  .hero-veil,
  .hero-sweep {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hero-veil {
    z-index: 2;
    background: var(--color-background);
    opacity: 0;
  }
  .hero-sweep {
    z-index: 2;
    overflow: hidden;
  }
  .hero-sweep::before {
    content: '';
    position: absolute;
    top: -30%;
    bottom: -30%;
    left: 0;
    width: 38%;
    background: linear-gradient(
      90deg,
      transparent,
      rgb(216 209 240 / 12%),
      transparent
    );
    opacity: 0;
    transform: translate3d(-120%, 0, 0) skewX(-16deg);
  }
  .hero.is-motion .artwork {
    top: -6%;
    bottom: -6%;
  }
  .hero.is-motion .artwork img {
    will-change: transform;
  }
  .hero.is-motion .hero-content {
    will-change: transform;
  }
  .hero-content {
    position: relative;
    z-index: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .artwork-stack {
      animation: hero-art 1.6s cubic-bezier(0.22, 0.61, 0.36, 1) both;
    }
    .hero-veil {
      animation: hero-veil 1.1s ease-out both;
    }
    .hero-sweep::before {
      animation: hero-sweep 2.4s cubic-bezier(0.22, 0.61, 0.36, 1) 0.4s both;
    }
    h1 span {
      animation: hero-line 0.95s cubic-bezier(0.22, 0.61, 0.36, 1) both;
    }
    h1 span:nth-child(1) {
      animation-delay: 0.45s;
    }
    h1 span:nth-child(2) {
      animation-delay: 0.6s;
    }
    .copy p {
      animation: hero-up 0.9s cubic-bezier(0.22, 0.61, 0.36, 1) 0.78s both;
    }
    .actions {
      animation: hero-up 0.9s cubic-bezier(0.22, 0.61, 0.36, 1) 0.95s both;
    }
  }
  @keyframes hero-art {
    from {
      filter: blur(10px) brightness(0.72);
      transform: scale(1.1);
    }
    to {
      filter: blur(0) brightness(1);
      transform: scale(1);
    }
  }
  @keyframes hero-veil {
    from {
      opacity: 0.92;
    }
    to {
      opacity: 0;
    }
  }
  @keyframes hero-sweep {
    0% {
      opacity: 0;
      transform: translate3d(-120%, 0, 0) skewX(-16deg);
    }
    15% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translate3d(280%, 0, 0) skewX(-16deg);
    }
  }
  @keyframes hero-line {
    from {
      opacity: 0;
      transform: translateY(38px);
      filter: blur(10px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: blur(0);
    }
  }
  @keyframes hero-up {
    from {
      opacity: 0;
      transform: translateY(22px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (min-width: 1921px) {
    .artwork {
      left: 50%;
      right: auto;
      width: 1920px;
      transform: translateX(-50%);
      mask-image: linear-gradient(
        90deg,
        transparent,
        #000 12%,
        #000 88%,
        transparent
      );
    }
    .artwork img {
      object-position: center bottom;
    }
  }
  @media (max-width: 1100px) {
    h1 {
      font-size: clamp(42px, 6.5vw, 72px);
      line-height: 1.225;
    }
    .hero {
      min-height: min(820px, 100svh);
    }
  }
  @media (max-width: 600px) {
    .hero {
      min-height: 100vh;
      min-height: 100svh;
      padding-top: clamp(96px, 12svh, 120px);
      padding-bottom: clamp(64px, 9svh, 96px);
      align-items: center;
    }
    .artwork img {
      object-position: 61% center;
    }
    .artwork::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(
        180deg,
        rgb(5 5 7 / 25%),
        rgb(5 5 7 / 15%) 45%,
        transparent 70%
      );
    }
    .hero-content {
      gap: clamp(28px, 7vw, 48px);
    }
    .copy {
      gap: clamp(16px, 4.5vw, 24px);
    }
    h1 {
      font-size: clamp(28px, 7vw, 42px);
      line-height: 1.2;
    }
    p {
      max-width: 380px;
      font-size: clamp(15px, 3.9vw, 16px);
      line-height: 1.5;
    }
    .actions {
      gap: clamp(12px, 3.5vw, 20px);
    }
  }
  @media (max-width: 480px) {
    .actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
