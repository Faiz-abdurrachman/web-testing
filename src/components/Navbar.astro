---
import Button from './Button.astro';
interface Props {
  active?: string;
}
const { active = 'Home' } = Astro.props;
const links = [
  'Home',
  'About Us',
  'Recruitment',
  'Hall of Frames',
  'Partners',
  'Contact',
];
// Only pages that exist get a real destination; the rest stay unavailable.
const destinations: Record<string, string> = {
  Home: '/',
  Recruitment: '/recruitment',
};
---

<header class="navbar">
  <div class="navbar-inner">
    <a class="brand" href="/" aria-label="Data Sorcerers home">
      <img src="/images/logo.png" width="54" height="59" alt="Data Sorcerers" />
    </a>
    <div class="desktop-menu">
      <nav aria-label="Main navigation">
        {links.map((label) =>
          destinations[label] ? (
            <a
              class:list={['nav-link', { active: label === active }]}
              href={destinations[label]}
              aria-current={label === active ? 'page' : undefined}
            >
              {label}
            </a>
          ) : (
            <span class="nav-link" aria-disabled="true">
              {label}
            </span>
          ),
        )}
      </nav>
      <Button variant="white">Join Community</Button>
    </div>
    <details class="mobile-menu">
      <summary aria-label="Toggle navigation">
        <span></span>
        <span></span>
        <span></span>
      </summary>
      <nav aria-label="Mobile navigation">
        {links.map((label) =>
          destinations[label] ? (
            <a
              class:list={['nav-link', { active: label === active }]}
              href={destinations[label]}
              aria-current={label === active ? 'page' : undefined}
            >
              {label}
            </a>
          ) : (
            <span class="nav-link" aria-disabled="true">
              {label}
            </span>
          ),
        )}
        <Button variant="white">Join Community</Button>
      </nav>
    </details>
  </div>
</header>
<style>
  .navbar {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    background: linear-gradient(
      180deg,
      rgb(108 59 255 / 10%) 0%,
      rgb(11 7 18 / 0%) 100.19%
    );
  }
  .navbar::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    mask-image: linear-gradient(#000, transparent);
    -webkit-mask-image: linear-gradient(#000, transparent);
    pointer-events: none;
    transition:
      backdrop-filter 0.35s ease,
      -webkit-backdrop-filter 0.35s ease;
  }
  .navbar.is-scrolled::before {
    backdrop-filter: blur(12px) saturate(140%);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
  }
  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 1440px;
    height: 106.8px;
    margin-inline: auto;
    padding: 24px 80px;
  }
  .brand,
  .brand img {
    display: block;
    width: 54px;
    height: 58.8px;
  }
  .desktop-menu {
    display: flex;
    align-items: center;
    gap: 90px;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .nav-link {
    position: relative;
    padding: 8px 14px;
    color: #707070;
    font-size: 18px;
    font-weight: 500;
    line-height: 27px;
    white-space: nowrap;
  }
  .active {
    color: white;
  }
  .active::after {
    content: '';
    position: absolute;
    height: 1px;
    bottom: 6px;
    left: 14px;
    right: 14px;
    background: #9b7bff;
  }
  .mobile-menu {
    display: none;
  }
  @media (min-width: 1301px) {
    .desktop-menu nav {
      width: 753px;
      height: 45px;
    }
    .desktop-menu .nav-link:nth-child(1) {
      width: 78px;
      height: 45px;
    }
    .desktop-menu .nav-link:nth-child(2) {
      width: 106px;
    }
    .desktop-menu .nav-link:nth-child(3) {
      width: 134px;
    }
    .desktop-menu .nav-link:nth-child(4) {
      width: 146px;
    }
    .desktop-menu .nav-link:nth-child(5) {
      width: 101px;
    }
    .desktop-menu .nav-link:nth-child(6) {
      width: 98px;
    }
    .desktop-menu .active::after {
      left: 14.5px;
      right: auto;
      bottom: 8px;
    }
    .desktop-menu .active:nth-child(1)::after {
      width: 49px;
    }
    .desktop-menu .active:nth-child(3)::after {
      width: 106px;
      background: linear-gradient(
        163deg,
        #9b7bff 0%,
        #ede8ff 50%,
        #9b7bff 100%
      );
    }
  }
  @media (max-width: 1300px) {
    .desktop-menu {
      gap: 30px;
    }
    nav {
      gap: 8px;
    }
    .nav-link {
      padding-inline: 10px;
      font-size: 16px;
    }
  }
  @media (max-width: 1050px) {
    .navbar-inner {
      height: 94px;
      padding: 18px var(--page-gutter);
    }
    .desktop-menu {
      display: none;
    }
    .mobile-menu {
      display: block;
    }
    summary {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 44px;
      height: 44px;
      padding: 10px;
      cursor: pointer;
      background: none;
      border: 0;
      border-radius: 0;
      list-style: none;
    }
    summary::-webkit-details-marker {
      display: none;
    }
    summary span {
      display: block;
      height: 1px;
      width: 22px;
      background: white;
      filter: drop-shadow(0 1px 2px rgb(0 0 0 / 65%));
      transition:
        transform 0.25s ease,
        opacity 0.2s ease;
    }
    .mobile-menu[open] summary span:nth-child(1) {
      transform: translateY(6px) rotate(45deg);
    }
    .mobile-menu[open] summary span:nth-child(2) {
      opacity: 0;
    }
    .mobile-menu[open] summary span:nth-child(3) {
      transform: translateY(-6px) rotate(-45deg);
    }
    .mobile-menu nav {
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      max-height: calc(100vh - 94px);
      max-height: calc(100dvh - 94px);
      padding: 12px var(--page-gutter) max(48px, env(safe-area-inset-bottom));
      overflow-y: auto;
      overscroll-behavior: contain;
      background: rgb(5 5 7 / 90%);
      backdrop-filter: blur(22px) saturate(140%);
      -webkit-backdrop-filter: blur(22px) saturate(140%);
      mask-image: linear-gradient(#000 calc(100% - 36px), transparent);
      -webkit-mask-image: linear-gradient(#000 calc(100% - 36px), transparent);
      border: 0;
      border-radius: 0;
      box-shadow: none;
    }
    .mobile-menu .nav-link {
      padding: 13px 4px;
      font-size: 18px;
      line-height: 27px;
      color: rgb(255 255 255 / 70%);
      border-top: 1px solid rgb(203 197 255 / 12%);
    }
    .mobile-menu .nav-link:first-child {
      border-top: 0;
    }
    .mobile-menu .nav-link.active {
      color: #fff;
      background: linear-gradient(
        90deg,
        rgb(108 59 255 / 26%),
        rgb(108 59 255 / 0%)
      );
    }
    .mobile-menu .active::after {
      display: none;
    }
    .mobile-menu nav :global(.button) {
      width: 100%;
      margin-top: 24px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    summary span {
      transition: none;
    }
  }
  :global(body.menu-open) {
    overflow: hidden;
  }
</style>
<script>
  const navbar = document.querySelector('.navbar');
  const sync = () =>
    navbar?.classList.toggle('is-scrolled', window.scrollY > 8);
  sync();
  addEventListener('scroll', sync, { passive: true });

  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu?.open) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
  document.addEventListener('click', (event) => {
    if (
      menu?.open &&
      event.target instanceof Node &&
      !menu.contains(event.target)
    )
      menu.open = false;
  });

  const syncLock = () =>
    document.body.classList.toggle('menu-open', !!menu?.open);
  menu?.addEventListener('toggle', syncLock);
  addEventListener('resize', () => {
    if (menu?.open && innerWidth > 1050) menu.open = false;
  });
</script>
