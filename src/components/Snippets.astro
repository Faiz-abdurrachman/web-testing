---
// Figma node 706:2330 with the "galeryy ds" gallery (component 630:3687). The
// five DS variants use the same five photos with a different hero, so this is a
// fluid gallery: a hero carousel (with arrows, drag/swipe and keyboard) plus a
// thumbnail rail. The photos are exported from the DS renders as WebP (1x/2x).
const photos = [1, 2, 3, 4, 5];
---

<section id="snippets" class="snippets" aria-labelledby="snippets-title">
  <h2 id="snippets-title">Snippets of Life at data sorcerers</h2>

  <div
    class="gallery"
    data-gallery
    tabindex="0"
    role="group"
    aria-roledescription="carousel"
    aria-label="Snippets of life at Data Sorcerers"
  >
    <div class="gallery-hero">
      <div class="hero-viewport" data-viewport>
        <div class="hero-track" data-track>
          {photos.map((n) => (
            <div class="hero-slide">
              <img
                src={`/images/recruitment/snippet-hero-${n}.webp`}
                srcset={`/images/recruitment/snippet-hero-${n}.webp 1280w, /images/recruitment/snippet-hero-${n}-2x.webp 2560w`}
                sizes="1280px"
                width="1280"
                height="556"
                alt=""
                loading={n === 1 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="gallery-thumbs">
      {photos.map((n, index) => (
        <button
          class="thumb"
          type="button"
          data-thumb={index}
          aria-label={`Show snippet ${index + 1}`}
        >
          <img
            src={`/images/recruitment/snippet-thumb-${n}.webp`}
            srcset={`/images/recruitment/snippet-thumb-${n}.webp 246w, /images/recruitment/snippet-thumb-${n}-2x.webp 492w`}
            sizes="246px"
            width="246"
            height="103"
            alt=""
            loading="lazy"
            decoding="async"
          />
        </button>
      ))}
    </div>

    <button
      class="snippet-arrow prev"
      type="button"
      data-prev
      aria-label="Previous snippet"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M15 5l-7 7 7 7"></path>
      </svg>
    </button>
    <button
      class="snippet-arrow next"
      type="button"
      data-next
      aria-label="Next snippet"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M9 5l7 7-7 7"></path>
      </svg>
    </button>
  </div>
</section>
<script>
  document
    .querySelectorAll<HTMLElement>('[data-gallery]')
    .forEach((gallery) => {
      const track = gallery.querySelector<HTMLElement>('[data-track]');
      const viewport = gallery.querySelector<HTMLElement>('[data-viewport]');
      const thumbs = [...gallery.querySelectorAll<HTMLElement>('[data-thumb]')];
      const prev = gallery.querySelector<HTMLButtonElement>('[data-prev]');
      const next = gallery.querySelector<HTMLButtonElement>('[data-next]');
      if (!track || !viewport || thumbs.length === 0) return;

      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const count = thumbs.length;
      const slides = [...track.children];
      // Clone the ends so the carousel loops without a hard jump.
      track.appendChild(slides[0].cloneNode(true));
      track.insertBefore(slides[slides.length - 1].cloneNode(true), slides[0]);

      let pos = 1;
      let animating = false;
      const slideWidth = () =>
        (track.children[0] as HTMLElement).getBoundingClientRect().width;
      const render = (animate: boolean) => {
        track.style.transition =
          animate && !reduce
            ? 'transform 0.55s cubic-bezier(0.22, 0.61, 0.36, 1)'
            : 'none';
        track.style.transform = `translateX(${-pos * slideWidth()}px)`;
        const active = (pos - 1 + count) % count;
        thumbs.forEach((thumb, index) =>
          thumb.classList.toggle('active', index === active),
        );
      };
      const go = (delta: number) => {
        if (animating) return;
        pos += delta;
        if (reduce) {
          if (pos > count) pos = 1;
          else if (pos < 1) pos = count;
          render(false);
          return;
        }
        animating = true;
        render(true);
      };

      track.addEventListener('transitionend', (event) => {
        if (event.propertyName !== 'transform') return;
        if (pos === count + 1 || pos === 0) {
          pos = pos === count + 1 ? 1 : count;
          render(false);
        }
        animating = false;
      });

      prev?.addEventListener('click', () => go(-1));
      next?.addEventListener('click', () => go(1));
      thumbs.forEach((thumb) =>
        thumb.addEventListener('click', () => {
          if (animating) return;
          const target = Number(thumb.dataset.thumb) + 1;
          if (target === pos) return;
          pos = target;
          if (reduce) {
            render(false);
          } else {
            animating = true;
            render(true);
          }
        }),
      );

      // Pointer drag / swipe: follow the finger, then snap smoothly.
      let startX = 0;
      let moved = 0;
      let dragging = false;
      viewport.addEventListener('pointerdown', (event) => {
        if (event.pointerType === 'mouse' && event.button !== 0) return;
        dragging = true;
        moved = 0;
        startX = event.clientX;
        track.style.transition = 'none';
        viewport.setPointerCapture(event.pointerId);
      });
      viewport.addEventListener('pointermove', (event) => {
        if (!dragging) return;
        moved = event.clientX - startX;
        track.style.transform = `translateX(${-pos * slideWidth() + moved}px)`;
      });
      const endDrag = () => {
        if (!dragging) return;
        dragging = false;
        const threshold = slideWidth() * 0.18;
        if (moved < -threshold) go(1);
        else if (moved > threshold) go(-1);
        else render(true);
        moved = 0;
      };
      viewport.addEventListener('pointerup', endDrag);
      viewport.addEventListener('pointercancel', endDrag);

      gallery.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          go(1);
        } else if (event.key === 'ArrowLeft') {
          event.preventDefault();
          go(-1);
        }
      });
      // Arrow keys drive the carousel whenever its section is the one at the
      // viewport centre (no focus needed); the focused handler runs first.
      const section = gallery.closest('.snippets') ?? gallery;
      addEventListener('keydown', (event) => {
        if (event.defaultPrevented) return;
        const target = event.target as HTMLElement | null;
        if (
          target?.closest('input, textarea, select, [contenteditable="true"]')
        )
          return;
        const rect = section.getBoundingClientRect();
        const center = innerHeight / 2;
        if (rect.top > center || rect.bottom < center) return;
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          go(1);
        } else if (event.key === 'ArrowLeft') {
          event.preventDefault();
          go(-1);
        }
      });

      addEventListener('resize', () => render(false));
      render(false);
    });
</script>
<style>
  .snippets {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 58px;
    padding: 40px 80px;
    background: #050507;
  }
  h2 {
    margin: 0;
    width: 100%;
    max-width: 1280px;
    font: 400 56px/68px var(--font-heading);
    text-align: center;
    background: linear-gradient(90deg, #fff 0%, #ede8ff 100%);
    background-clip: text;
    color: transparent;
  }
  /* The gallery scales with its width (container query units for the gaps) so
     zooming changes the element sizes instead of overflowing. */
  .gallery {
    container-type: inline-size;
    position: relative;
    width: 100%;
    max-width: 1280px;
    display: flex;
    flex-direction: column;
    outline: none;
  }
  .gallery:focus-visible {
    outline: 2px solid #bba7ff;
    outline-offset: 8px;
    border-radius: 24px;
  }
  .gallery-hero {
    position: relative;
    width: 100%;
    aspect-ratio: 1280 / 556;
    border-radius: 20px;
    overflow: hidden;
    background: #0b0b10;
    touch-action: pan-y;
    cursor: grab;
  }
  .gallery-hero:active {
    cursor: grabbing;
  }
  .hero-viewport {
    position: absolute;
    inset: 0;
  }
  .hero-track {
    display: flex;
    height: 100%;
    will-change: transform;
  }
  .hero-slide {
    flex: 0 0 100%;
    height: 100%;
  }
  .hero-slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
    -webkit-user-drag: none;
  }
  .snippet-arrow {
    position: absolute;
    top: 21.71875cqw; /* centre of the 1280 : 556 hero */
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    transform: translateY(-50%);
    border: 1px solid rgb(203 197 255 / 60%);
    border-radius: 50%;
    background: rgb(16 9 35 / 85%);
    backdrop-filter: blur(6px);
    cursor: pointer;
  }
  .snippet-arrow svg {
    width: 26px;
    height: 26px;
    fill: none;
    stroke: #fff;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .snippet-arrow.prev {
    left: -66px;
  }
  .snippet-arrow.next {
    right: -66px;
  }
  .gallery-thumbs {
    display: flex;
    justify-content: space-between;
    margin-top: 2.734375cqw;
  }
  .thumb {
    flex: none;
    width: 19.21875%;
    aspect-ratio: 246 / 103;
    padding: 0;
    border: 0;
    border-radius: 20px;
    overflow: hidden;
    background: #0b0b10;
    cursor: pointer;
  }
  .thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
    -webkit-user-drag: none;
  }
  /* The active slide is shown by the hero; the thumbnails stay neutral. */
  @media (max-width: 760px) {
    .snippets {
      gap: 40px;
      padding: 40px 24px;
    }
    h2 {
      font-size: clamp(30px, 8vw, 48px);
      line-height: 1.214286;
    }
    .snippet-arrow {
      top: auto;
      bottom: -38px;
      transform: none;
      width: 36px;
      height: 36px;
    }
    .snippet-arrow svg {
      width: 18px;
      height: 18px;
    }
    .snippet-arrow.prev {
      left: 0;
    }
    .snippet-arrow.next {
      right: 0;
    }
  }
</style>
