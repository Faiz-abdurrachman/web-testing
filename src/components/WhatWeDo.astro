  @media (prefers-reduced-motion: no-preference) {
    .what-we-do::before {
      will-change: opacity;
      animation: wwd-glow-breathe 11s ease-in-out infinite alternate;
    }
    /* One full background tile per loop, linear → seamless outer-space drift. */
    .what-we-do::after {
      opacity: 0.8;
      will-change: transform;
      animation: wwd-drift-far 12s linear infinite;
    }
    .pillars-layout::after {
      opacity: 0.85;
      will-change: transform;
      animation: wwd-drift-near 7s linear infinite;
    }
    /* motion.ts toggles `is-idle` while the section is off-screen. */
    .what-we-do.is-idle::before,
    .what-we-do.is-idle::after,
    .what-we-do.is-idle .pillars-layout::after {
      animation-play-state: paused;
    }
