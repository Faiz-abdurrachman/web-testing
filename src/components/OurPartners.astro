---
import { partnerCategories, partnerLogo } from '../data/partners';
---

<section class="our-partners" aria-labelledby="our-partners-title">
  <h2 id="our-partners-title" class="sr-only">
    Our Partners
  </h2>
  {partnerCategories.map((category) => (
    <div class="partner-group">
      <div class="group-head">
        <span class="group-pill">{category.label}</span>
        <span class="group-line" aria-hidden="true" />
      </div>
      <ul class="partner-grid">
        {Array.from({ length: category.count }).map((_, index) => (
          <li class="partner-card">
            <img
              class="card-bg"
              src="/images/partners/partner-card-bg.webp"
              width="720"
              height="348"
              alt=""
              aria-hidden="true"
              loading="lazy"
              decoding="async"
            />
            <img
              class="card-logo"
              src={partnerLogo}
              width="78"
              height="84"
              alt={`${category.label} partner ${index + 1}`}
              loading="lazy"
              decoding="async"
            />
          </li>
        ))}
      </ul>
    </div>
  ))}
</section>

<style>
  /* Matches Figma node 1439:4793 (1440 x 1071, page 1439:4787): padding 80px,
     gap 100px, #050507. Three groups (gap 42px): a pill + gradient rule, then a
     5-column card grid (gap 16px, card 243.2 x 116, radius 20). */
  .our-partners {
    display: flex;
    flex-direction: column;
    gap: 100px;
    padding: 80px;
    box-sizing: border-box;
    background: #050507;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  .partner-group {
    display: flex;
    flex-direction: column;
    gap: 42px;
  }
  .group-head {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .group-pill {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px 16px;
    border-radius: 20px;
    background: radial-gradient(circle at 8% 19%, #6c3bff 0%, #3c2188 98%);
    box-shadow: inset 0 -1px 1.9px rgb(255 255 255 / 25%);
    color: #fff;
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 500;
    line-height: 27px;
    white-space: nowrap;
  }
  .group-line {
    flex: 1;
    height: 1px;
    margin-inline: 10px;
    background: linear-gradient(90deg, #9b7bff 0%, rgb(255 255 255 / 0%) 100%);
  }
  .partner-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .partner-card {
    position: relative;
    aspect-ratio: 243.2 / 116;
    border-radius: 20px;
    overflow: hidden;
  }
  .card-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .card-logo {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 32.07%;
    height: auto;
    transform: translate(-50%, -50%);
  }

  @media (max-width: 1050px) {
    .our-partners {
      gap: 64px;
      padding: 64px var(--page-gutter);
    }
    .partner-group {
      gap: 32px;
    }
    .partner-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 700px) {
    .our-partners {
      gap: 48px;
      padding: 48px var(--page-gutter);
    }
    .partner-group {
      gap: 24px;
    }
    .group-pill {
      font-size: 16px;
      line-height: 24px;
    }
    .partner-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }
  }
</style>
