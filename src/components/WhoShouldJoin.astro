---
import DomainRail from './DomainRail.astro';
---

<section
  id="who-should-join"
  class="who-should-join"
  aria-labelledby="who-should-join-title"
>
  <header>
    <h2 id="who-should-join-title">Who Should Join?</h2>
    <p>
      We welcome passionate individuals across technical, creative, and
      operational domains.
    </p>
  </header>
  <DomainRail suffix="?from=recruitment" />
</section>
<style>
  .who-should-join {
    scroll-margin-top: 110px;
    padding-block: 80px;
    /* Supplied Background.png = the Figma frame fill (near-black starfield). */
    background-color: #000;
    background-image: url('/images/backgrounds/stars.webp');
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
  }
  header {
    padding-inline: var(--page-gutter);
    text-align: center;
  }
  h2 {
    margin: 0;
    font: 400 56px/68px var(--font-heading);
    background: linear-gradient(14.17deg, #707070 16.09%, #fff 91.78%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  header p {
    margin: 24px 0 0;
    font-size: 18px;
    font-weight: 500;
    line-height: 27px;
    color: #fff;
  }
  @media (max-width: 760px) {
    .who-should-join {
      padding-block: 64px;
    }
    h2 {
      font-size: clamp(30px, 7vw, 48px);
      line-height: 1.214286;
    }
    header p {
      font-size: 16px;
    }
  }
</style>
