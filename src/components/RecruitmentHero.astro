---
import Button from './Button.astro';
---

<section class="recruitment-hero" aria-labelledby="recruitment-hero-title">
  <picture class="artwork">
    <img
      src="/images/backgrounds/recruitment.webp"
      width="1440"
      height="901"
      alt=""
      fetchpriority="high"
      decoding="async"
    />
  </picture>
  <div class="hero-content">
    <h1 id="recruitment-hero-title">
      <span>YOUR NEXT CHAPTER</span>
      <span>START HERE.</span>
    </h1>
    <p>
      Join Data Sorcerers and turn your curiosity into capability, experiments,
      research, and real-world projects.
    </p>
  </div>
  <Button variant="secondary">Apply Now</Button>
</section>
<style>
  .recruitment-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 63px;
    min-height: min(866px, 100svh);
    padding: 140px var(--page-gutter) 80px;
    overflow: clip;
    text-align: center;
  }
  .artwork {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .artwork img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .artwork::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(5 5 7 / 15%),
      rgb(5 5 7 / 45%) 50%,
      transparent
    );
  }
  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 34px;
    width: 100%;
  }
  h1 {
    margin: 0;
    width: 900px;
    max-width: 100%;
    font-family: var(--font-heading);
    font-size: 80px;
    font-weight: 400;
    line-height: 98px;
    background: linear-gradient(180deg, #fff 0%, #d8d1ed 55%, #fff 100%);
    background-clip: text;
    color: transparent;
  }
  h1 span {
    display: block;
  }
  p {
    margin: 0;
    width: 900px;
    max-width: 100%;
    color: #ede8ff;
    font-size: 18px;
    font-weight: 500;
    line-height: 27px;
  }
  @media (min-width: 1921px) {
    .artwork {
      left: 50%;
      right: auto;
      width: 1920px;
      transform: translateX(-50%);
      mask-image: linear-gradient(
        90deg,
        transparent,
        #000 12%,
        #000 88%,
        transparent
      );
    }
    .artwork img {
      object-position: center bottom;
    }
  }
  @media (max-width: 1100px) {
    .recruitment-hero {
      min-height: min(760px, 100svh);
      gap: 48px;
    }
    h1 {
      font-size: clamp(40px, 6vw, 72px);
      line-height: 1.225;
    }
  }
  @media (max-width: 600px) {
    .recruitment-hero {
      min-height: 100vh;
      min-height: 100svh;
      /* Track the visible viewport (see Hero.astro) so the next section cannot peek under the address bar. */
      min-height: 100dvh;
      gap: clamp(28px, 7vw, 48px);
      justify-content: center;
      padding-top: clamp(96px, 12svh, 120px);
      padding-bottom: clamp(64px, 9svh, 96px);
    }
    .hero-content {
      gap: clamp(16px, 4.5vw, 24px);
    }
    h1 {
      font-size: clamp(23px, 6.7vw, 40px);
      line-height: 1.2;
    }
    p {
      font-size: clamp(15px, 3.9vw, 18px);
      line-height: 1.5;
    }
  }
</style>
