---
import Button from './Button.astro';
interface Props {
  active?: string;
}
const { active = 'Home' } = Astro.props;
const links = [
  'Home',
  'About Us',
  'Recruitment',
  'Hall of Frames',
  'Partners',
  'Contact',
];
// Only pages that exist get a real destination; the rest stay unavailable.
const destinations: Record<string, string> = {
  Home: '/',
  Recruitment: '/recruitment',
};
---

<header class="navbar">
  <div class="navbar-inner">
    <a class="brand" href="/" aria-label="Data Sorcerers home">
      <img src="/images/logo.png" width="54" height="59" alt="Data Sorcerers" />
    </a>
    <div class="desktop-menu">
      <nav aria-label="Main navigation">
        {links.map((label, i) =>
          destinations[label] ? (
            <a
              class:list={['nav-link', { active: label === active }]}
              href={destinations[label]}
              aria-current={label === active ? 'page' : undefined}
              style={`--i:${i + 1}`}
            >
              {label}
            </a>
          ) : (
            <span class="nav-link" aria-disabled="true" style={`--i:${i + 1}`}>
              {label}
            </span>
          ),
        )}
        <span class="nav-indicator" aria-hidden="true"></span>
      </nav>
      <Button variant="white">Join Community</Button>
    </div>
    <details class="mobile-menu">
      <summary aria-label="Toggle navigation">
        <span></span>
        <span></span>
        <span></span>
      </summary>
      <nav aria-label="Mobile navigation">
        {links.map((label, i) =>
          destinations[label] ? (
            <a
              class:list={['nav-link', { active: label === active }]}
              href={destinations[label]}
              aria-current={label === active ? 'page' : undefined}
              style={`--i:${i + 1}`}
            >
              {label}
            </a>
          ) : (
            <span class="nav-link" aria-disabled="true" style={`--i:${i + 1}`}>
              {label}
            </span>
          ),
        )}
        <Button variant="white">Join Community</Button>
      </nav>
    </details>
  </div>
  <span class="navbar-flash" aria-hidden="true"></span>
</header>
<style>
  .navbar {
    --nb-h: 106.8px;
    --nb-h-condensed: 72px;
    /* Floating-bar geometry: flush and invisible over the hero, then it detaches. */
    --nb-gap: 0px;
    /* Lift the bar clear of the status bar / notch on installed PWAs. */
    --nb-safe: env(safe-area-inset-top, 0px);
    --nb-top: calc(var(--nb-gap) + var(--nb-safe));
    --nb-inset: 0px;
    --nb-radius: 0px;
    --nb-frame: 1600px;
    /* Slow, buttery ease: the bar settles like jelly rather than snapping. */
    --nb-ease: cubic-bezier(0.16, 1, 0.3, 1);
    --nb-dur: 0.9s;
    /* Springy ease for the indicator's travel. */
    --nb-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    /* At the very top the bar is invisible so it reads as part of the hero. */
    background: transparent;
  }
  .navbar.is-condensed {
    --nb-frame: 1440px;
  }
  .navbar.is-scrolled {
    --nb-gap: 10px;
    --nb-inset: 14px;
    /* Full capsule: both top and bottom are rounded once it detaches. */
    --nb-radius: 999px;
  }
  /* Panel edges track the content frame, then float out from it. */
  .navbar::after {
    content: '';
    position: absolute;
    top: var(--nb-top);
    right: max(var(--nb-inset), calc(50% - var(--nb-frame) / 2));
    bottom: 0;
    left: max(var(--nb-inset), calc(50% - var(--nb-frame) / 2));
    z-index: -1;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(
      180px 96px at var(--mx, 50%) 118%,
      rgb(108 59 255 / 34%),
      transparent 72%
    );
    transition:
      opacity 0.35s ease,
      top var(--nb-dur) var(--nb-ease),
      left var(--nb-dur) var(--nb-ease),
      right var(--nb-dur) var(--nb-ease);
  }
  @media (hover: hover) and (pointer: fine) {
    .navbar.is-scrolled.is-glowing::after {
      opacity: 1;
    }
  }
  /* One-shot diagonal glint that sweeps the capsule when it detaches. */
  .navbar-flash {
    position: absolute;
    top: var(--nb-top);
    right: max(var(--nb-inset), calc(50% - var(--nb-frame) / 2));
    bottom: 0;
    left: max(var(--nb-inset), calc(50% - var(--nb-frame) / 2));
    z-index: 0;
    overflow: hidden;
    border-radius: var(--nb-radius);
    pointer-events: none;
    transition: border-radius 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .navbar-flash::before {
    content: '';
    position: absolute;
    top: -30%;
    bottom: -30%;
    left: 0;
    width: 34%;
    opacity: 0;
    background: linear-gradient(
      90deg,
      transparent,
      rgb(232 224 255 / 55%),
      transparent
    );
    transform: translate3d(-160%, 0, 0) skewX(-15deg);
  }
  @media (prefers-reduced-motion: no-preference) {
    .navbar.is-scrolled .navbar-flash::before {
      animation: nav-flash 1.5s cubic-bezier(0.16, 1, 0.3, 1) 0.25s both;
    }
  }
  @keyframes nav-flash {
    0% {
      opacity: 0;
      transform: translate3d(-160%, 0, 0) skewX(-15deg);
    }
    18% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translate3d(420%, 0, 0) skewX(-15deg);
    }
  }
  /* Soft glass bar that detaches once the page is scrolled. */
  .navbar::before {
    content: '';
    position: absolute;
    top: var(--nb-top);
    right: max(var(--nb-inset), calc(50% - var(--nb-frame) / 2));
    bottom: 0;
    left: max(var(--nb-inset), calc(50% - var(--nb-frame) / 2));
    z-index: -1;
    opacity: 0;
    border-radius: var(--nb-radius);
    background: rgb(12 8 20 / 34%);
    box-shadow:
      0 20px 44px -28px rgb(0 0 0 / 66%),
      inset 0 1px 0 rgb(255 255 255 / 8%),
      inset 0 -1px 0 rgb(255 255 255 / 4%);
    pointer-events: none;
    transition:
      opacity 0.4s ease,
      top var(--nb-dur) var(--nb-ease),
      left var(--nb-dur) var(--nb-ease),
      right var(--nb-dur) var(--nb-ease),
      border-radius var(--nb-dur) var(--nb-ease);
  }
  /* Blur only paints once the bar detaches, so the top state owns no layer. */
  .navbar.is-scrolled::before {
    opacity: 1;
    backdrop-filter: blur(28px) saturate(180%) brightness(1.07);
    -webkit-backdrop-filter: blur(28px) saturate(180%) brightness(1.07);
  }
  .navbar-inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    /* At the top the bar breathes wider; on scroll it pulls back to the 1440 grid. */
    max-width: 1600px;
    height: var(--nb-h);
    margin-top: var(--nb-top);
    margin-inline: auto;
    padding: 24px clamp(56px, 4.5vw, 80px);
    transition:
      height var(--nb-dur) var(--nb-ease),
      margin-top var(--nb-dur) var(--nb-ease),
      padding var(--nb-dur) var(--nb-ease),
      max-width var(--nb-dur) var(--nb-ease);
  }
  .navbar.is-condensed .navbar-inner {
    height: var(--nb-h-condensed);
    max-width: 1440px;
    padding: 10px 80px;
  }
  .brand {
    position: relative;
    z-index: 3;
    transition: transform var(--nb-dur) var(--nb-ease);
  }
  .navbar.is-condensed .brand {
    transform: scale(0.86);
  }
  .brand,
  .brand img {
    display: block;
    width: 54px;
    height: 58.8px;
  }
  .desktop-menu {
    display: flex;
    align-items: center;
    gap: 90px;
    transition: gap var(--nb-dur) var(--nb-ease);
  }
  nav {
    position: relative;
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .nav-link {
    position: relative;
    z-index: 1;
    padding: 8px 14px;
    color: #ede8ff;
    font-size: 18px;
    font-weight: 500;
    line-height: 27px;
    white-space: nowrap;
    border-radius: 999px;
    transition:
      color 0.25s ease,
      background-color 0.25s ease;
  }
  .nav-link[aria-disabled='true'] {
    color: #b5aec9;
  }
  a.nav-link:hover,
  a.nav-link:focus-visible {
    color: #fff;
  }
  /* Sheen that sweeps across a hovered link, clipped to the pill radius. */
  a.nav-link::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    background: linear-gradient(
      105deg,
      transparent 34%,
      rgb(255 255 255 / 22%) 50%,
      transparent 66%
    );
    background-size: 240% 100%;
    background-position: 130% 0;
    background-repeat: no-repeat;
  }
  @media (prefers-reduced-motion: no-preference) {
    a.nav-link:not(.active):hover::before,
    a.nav-link:not(.active):focus-visible::before {
      animation: nav-sheen 0.7s ease both;
    }
  }
  @keyframes nav-sheen {
    0% {
      opacity: 0;
      background-position: 130% 0;
    }
    18% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      background-position: -30% 0;
    }
  }
  /* Sliding active pill: carries the charged violet fill and the gradient rim.
     JS moves it between links, so the highlight travels with a jelly spring
     instead of popping. */
  .nav-indicator {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 0;
    width: 0;
    height: 0;
    opacity: 0;
    border-radius: 999px;
    background: radial-gradient(
      120% 160% at 12% -20%,
      rgb(155 123 255 / 32%) 0%,
      rgb(108 59 255 / 24%) 45%,
      rgb(108 59 255 / 10%) 100%
    );
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 22%),
      0 8px 24px -12px rgb(108 59 255 / 80%);
    pointer-events: none;
    transform: translateX(var(--nb-x, 0px));
    transition:
      transform 0.6s var(--nb-spring),
      width 0.5s var(--nb-spring),
      opacity 0.4s ease;
    will-change: transform;
  }
  /* Gradient rim (not a flat line). */
  .nav-indicator::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(
      145deg,
      rgb(255 255 255 / 85%) 0%,
      rgb(155 123 255 / 35%) 26%,
      rgb(108 59 255 / 0%) 55%,
      rgb(200 180 255 / 70%) 100%
    );
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    pointer-events: none;
  }
  a.nav-link.active {
    color: #fff;
    text-shadow: 0 0 14px rgb(196 180 255 / 55%);
  }
  a.nav-link.active:hover,
  a.nav-link.active:focus-visible {
    color: #fff;
  }
  .mobile-menu {
    display: none;
  }
  @media (min-width: 1301px) {
    .desktop-menu {
      gap: 130px;
    }
    .navbar.is-condensed .desktop-menu {
      gap: 90px;
    }
    .desktop-menu nav {
      width: 753px;
      height: 45px;
    }
    .desktop-menu .nav-link:nth-child(1) {
      width: 78px;
      height: 45px;
    }
    .desktop-menu .nav-link:nth-child(2) {
      width: 106px;
    }
    .desktop-menu .nav-link:nth-child(3) {
      width: 134px;
    }
    .desktop-menu .nav-link:nth-child(4) {
      width: 146px;
    }
    .desktop-menu .nav-link:nth-child(5) {
      width: 101px;
    }
    .desktop-menu .nav-link:nth-child(6) {
      width: 98px;
    }
  }
  @media (max-width: 1300px) {
    .desktop-menu {
      gap: 30px;
    }
    nav {
      gap: 8px;
    }
    .nav-link {
      padding-inline: 10px;
      font-size: 16px;
    }
  }
  @media (max-width: 1050px) {
    .navbar {
      --nb-h: 94px;
      --nb-h-condensed: 64px;
    }
    .navbar-inner {
      height: var(--nb-h);
      padding: 18px var(--page-gutter);
    }
    .desktop-menu {
      display: none;
    }
    .mobile-menu {
      display: block;
    }
    a.nav-link::before {
      display: none;
    }
    summary {
      position: relative;
      z-index: 3;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 4px;
      width: 44px;
      height: 44px;
      padding: 10px;
      cursor: pointer;
      background: none;
      border: 1px solid transparent;
      border-radius: 14px;
      list-style: none;
      transition:
        background-color var(--nb-dur) var(--nb-ease),
        border-color var(--nb-dur) var(--nb-ease);
    }
    /* Once the capsule floats, the burger reads as its own glass button. */
    .navbar.is-scrolled summary {
      background: rgb(255 255 255 / 8%);
      border-color: rgb(255 255 255 / 12%);
    }
    summary::-webkit-details-marker {
      display: none;
    }
    summary span {
      display: block;
      height: 2px;
      width: 22px;
      border-radius: 2px;
      background: white;
      filter: drop-shadow(0 1px 2px rgb(0 0 0 / 65%));
      transition:
        transform 0.4s cubic-bezier(0.68, -0.6, 0.32, 1.6),
        opacity 0.2s ease;
    }
    summary span:nth-child(2) {
      width: 14px;
    }
    .mobile-menu[open] summary span:nth-child(1) {
      transform: translateY(6px) rotate(45deg);
    }
    .mobile-menu[open] summary span:nth-child(2) {
      opacity: 0;
    }
    .mobile-menu[open] summary span:nth-child(3) {
      transform: translateY(-6px) rotate(-45deg);
    }
    .mobile-menu nav {
      position: fixed;
      inset: 0;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 4px;
      opacity: 1;
      transform: none;
      padding: calc(94px + 32px + env(safe-area-inset-top, 0px))
        var(--page-gutter) max(32px, env(safe-area-inset-bottom));
      overflow-y: auto;
      overscroll-behavior: contain;
      background: rgb(5 5 7 / 94%);
      border: 0;
      border-radius: 0;
      box-shadow: none;
      transition:
        opacity 0.32s ease,
        transform 0.32s ease;
    }
    .mobile-menu:not([open]) nav {
      display: none;
    }
    .mobile-menu.is-closing nav {
      opacity: 0;
      transform: translateY(-10px);
    }
    @starting-style {
      .mobile-menu[open] nav {
        opacity: 0;
        transform: translateY(-10px);
      }
    }
    .mobile-menu .nav-link {
      padding: 16px 14px;
      font-size: 20px;
      line-height: 30px;
      color: rgb(255 255 255 / 72%);
      border-radius: 14px;
    }
    .mobile-menu .nav-link:not(.active):hover,
    .mobile-menu .nav-link:not(.active):focus-visible {
      color: #fff;
      background: rgb(255 255 255 / 8%);
    }
    .mobile-menu .nav-link.active {
      color: #fff;
      background: linear-gradient(
        90deg,
        rgb(108 59 255 / 30%),
        rgb(108 59 255 / 0%)
      );
      box-shadow: none;
      text-shadow: none;
    }
    .mobile-menu .active::after {
      display: none;
    }
    .mobile-menu nav :global(.button) {
      width: 100%;
      margin-top: 32px;
    }
  }
  /* Phones: a 28px glass blur plus a 0.9s morph of height/padding/max-width
     re-rasterises the fixed bar on every scroll frame and reads as stutter.
     Keep the glass look with a far cheaper blur, and let the capsule detach as
     an instant class swap so scrolling never restarts a layout transition. */
  @media (max-width: 760px) {
    .navbar.is-scrolled::before {
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      transition:
        opacity 0.3s ease,
        border-radius 0.3s ease;
    }
    .navbar-flash {
      transition: border-radius 0.3s ease;
    }
    .navbar-inner,
    .brand {
      transition: none;
    }
    /* Desktop condensed padding (10px 80px) is too inset on a phone. */
    .navbar.is-condensed .navbar-inner {
      height: var(--nb-h-condensed);
      padding: 18px var(--page-gutter);
    }
    summary {
      transition:
        background-color 0.3s ease,
        border-color 0.3s ease;
    }
    .mobile-menu nav {
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .navbar.is-ready .brand,
    .navbar.is-ready .desktop-menu .nav-link,
    .navbar.is-ready .desktop-menu .button {
      animation: nav-in 0.6s cubic-bezier(0.22, 0.61, 0.36, 1) both;
      animation-delay: calc(var(--i, 0) * 55ms + 80ms);
    }
    .navbar.is-ready .desktop-menu .button {
      animation-delay: 0.5s;
    }
  }
  @keyframes nav-in {
    from {
      opacity: 0;
      transform: translateY(-12px);
      filter: blur(6px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    summary span,
    .nav-link,
    .desktop-menu,
    .mobile-menu nav,
    .navbar,
    .navbar-inner,
    .brand,
    .nav-indicator,
    .navbar-flash,
    summary,
    .navbar::before,
    .navbar::after {
      transition: none;
    }
  }
  /* Premium hover for the navbar CTA only (keeps other white buttons as-is). */
  :global(.navbar .button.white) {
    transition:
      background 0.3s ease,
      color 0.3s ease,
      box-shadow 0.3s ease,
      transform 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.navbar .button.white:hover) {
      transform: translateY(-1px);
      box-shadow:
        inset -2px -2px 4px rgb(178 211 255 / 90%),
        inset -8px -6px 8px rgb(226 202 255 / 25%),
        inset -2px -2px 1.4px #97bfff,
        inset 0 2px 1.2px #cfdfff,
        0 10px 26px -10px rgb(108 59 255 / 75%);
    }
    :global(.navbar .button.white:active) {
      transform: translateY(0);
    }
  }
  :global(.navbar .button.white::before) {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    background: linear-gradient(
      105deg,
      transparent 34%,
      rgb(108 59 255 / 26%) 50%,
      transparent 66%
    );
    background-size: 240% 100%;
    background-position: 130% 0;
    background-repeat: no-repeat;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.navbar .button.white:hover::before) {
      animation: nav-sheen 0.7s ease both;
    }
  }
  :global(body.menu-open) {
    overflow: hidden;
  }
</style>
<script>
  const navbar = document.querySelector<HTMLElement>('.navbar');
  const indicator = navbar?.querySelector<HTMLElement>('.nav-indicator');
  const desktopLinks = navbar
    ? [...navbar.querySelectorAll<HTMLElement>('.desktop-menu a.nav-link')]
    : [];
  const reduceMotion = () =>
    matchMedia('(prefers-reduced-motion: reduce)').matches;
  const finePointer = () => matchMedia('(pointer: fine)').matches;

  const syncScroll = () => {
    if (!navbar) return false;
    const y = window.scrollY;
    const scrolled = y > 8;
    const condensed = y > 40;
    const changed =
      navbar.classList.contains('is-scrolled') !== scrolled ||
      navbar.classList.contains('is-condensed') !== condensed;
    navbar.classList.toggle('is-scrolled', scrolled);
    navbar.classList.toggle('is-condensed', condensed);
    return changed;
  };

  // The active pill slides between links instead of popping. Hovering another
  // link pulls it there too, so the highlight feels alive.
  let hoverLink: HTMLElement | null = null;
  // Last link the pill was placed on, so a scroll frame that does not change
  // the target can skip the offsetLeft/offsetWidth reads entirely.
  let indicatorTarget: HTMLElement | null = null;

  const moveIndicator = (el: HTMLElement) => {
    if (!indicator) return;
    indicator.style.opacity = '1';
    indicator.style.setProperty('--nb-x', `${el.offsetLeft}px`);
    indicator.style.top = `${el.offsetTop}px`;
    indicator.style.width = `${el.offsetWidth}px`;
    indicator.style.height = `${el.offsetHeight}px`;
  };

  const syncIndicator = (force = false) => {
    if (!indicator || !navbar) return;
    if (innerWidth <= 1050) {
      indicator.style.opacity = '0';
      indicatorTarget = null;
      return;
    }
    const target =
      hoverLink || navbar.querySelector<HTMLElement>('a.nav-link.active');
    if (!target) {
      indicator.style.opacity = '0';
      indicatorTarget = null;
      return;
    }
    if (!force && target === indicatorTarget) return;
    indicatorTarget = target;
    moveIndicator(target);
  };

  // While the bar morphs (is-scrolled / is-condensed change its padding and
  // gap) the links slide, so follow them frame-by-frame for that transition
  // instead of reading layout on every scroll event.
  let followRaf = 0;
  let followUntil = 0;
  const follow = () => {
    syncIndicator(true);
    followRaf =
      performance.now() < followUntil ? requestAnimationFrame(follow) : 0;
  };
  const followFor = (ms: number) => {
    followUntil = performance.now() + ms;
    if (!followRaf) followRaf = requestAnimationFrame(follow);
  };

  syncScroll();
  let scrollRaf = 0;
  addEventListener(
    'scroll',
    () => {
      if (scrollRaf) return;
      scrollRaf = requestAnimationFrame(() => {
        scrollRaf = 0;
        if (syncScroll()) followFor(1000);
        else syncIndicator();
      });
    },
    { passive: true },
  );
  addEventListener('resize', () => {
    syncScroll();
    syncIndicator(true);
  });

  desktopLinks.forEach((link) => {
    link.addEventListener('mouseenter', () => {
      hoverLink = link;
      syncIndicator();
    });
    link.addEventListener('focus', () => {
      hoverLink = link;
      syncIndicator();
    });
  });
  const desktopNav = navbar?.querySelector<HTMLElement>('.desktop-menu nav');
  desktopNav?.addEventListener('mouseleave', () => {
    hoverLink = null;
    syncIndicator();
  });
  desktopNav?.addEventListener('blur', () => {
    hoverLink = null;
    syncIndicator();
  });

  // While the bar morphs its padding/gap the links move, so re-measure once the
  // transition settles.
  for (const el of [
    navbar?.querySelector('.desktop-menu'),
    navbar?.querySelector('.navbar-inner'),
  ]) {
    el?.addEventListener('transitionend', () => syncIndicator(true));
  }

  requestAnimationFrame(() => syncIndicator(true));
  document.fonts?.ready.then(() => syncIndicator(true)).catch(() => {});
  addEventListener('load', () => syncIndicator(true), { once: true });

  const armNav = () => navbar?.classList.add('is-ready');
  if (document.documentElement.classList.contains('splash-done')) {
    armNav();
  } else {
    addEventListener('ds:splash-done', armNav, { once: true });
    setTimeout(armNav, 7000);
  }

  if (navbar && finePointer() && !reduceMotion()) {
    navbar.addEventListener(
      'pointermove',
      (event) => {
        const rect = navbar.getBoundingClientRect();
        navbar.style.setProperty('--mx', `${event.clientX - rect.left}px`);
        navbar.classList.add('is-glowing');
      },
      { passive: true },
    );
    navbar.addEventListener('mouseleave', () =>
      navbar.classList.remove('is-glowing'),
    );
  }

  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  const nav = menu?.querySelector<HTMLElement>('nav');
  const summary = menu?.querySelector<HTMLElement>('summary');

  let closeTimer: ReturnType<typeof setTimeout> | undefined;

  const openMenu = () => {
    if (!menu) return;
    clearTimeout(closeTimer);
    menu.classList.remove('is-closing');
    menu.open = true;
    nav?.querySelector<HTMLElement>('a')?.focus();
  };

  const closeMenu = () => {
    if (!menu?.open) return;
    if (reduceMotion() || !nav) {
      menu.classList.remove('is-closing');
      menu.open = false;
      return;
    }
    if (menu.classList.contains('is-closing')) return;
    menu.classList.add('is-closing');
    const finish = (event?: Event) => {
      if (event && event.target !== nav) return;
      nav.removeEventListener('transitionend', finish);
      clearTimeout(closeTimer);
      menu.classList.remove('is-closing');
      menu.open = false;
    };
    nav.addEventListener('transitionend', finish);
    closeTimer = setTimeout(finish, 450);
  };

  summary?.addEventListener('click', (event) => {
    event.preventDefault();
    if (menu?.open) closeMenu();
    else openMenu();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu?.open) {
      closeMenu();
      summary?.focus();
    }
  });
  document.addEventListener('click', (event) => {
    if (
      menu?.open &&
      event.target instanceof Node &&
      !menu.contains(event.target)
    )
      closeMenu();
  });

  // Keep the obscured page out of the tab order while the full-screen menu is
  // open, so keyboard focus cannot leak behind the overlay.
  const background = [
    document.querySelector('main'),
    document.querySelector('.footer'),
    document.querySelector('.skip-link'),
  ].filter((el): el is HTMLElement => el instanceof HTMLElement);
  const syncLock = () => {
    const open = !!menu?.open;
    document.body.classList.toggle('menu-open', open);
    for (const el of background) el.toggleAttribute('inert', open);
  };
  menu?.addEventListener('toggle', syncLock);
  addEventListener('resize', () => {
    if (menu?.open && innerWidth > 1050) {
      clearTimeout(closeTimer);
      menu.classList.remove('is-closing');
      menu.open = false;
    }
  });
</script>
