---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import AboutHero from '../components/AboutHero.astro';
import VisiMisi from '../components/VisiMisi.astro';
import Philosophy from '../components/Philosophy.astro';
import OurEcosystem from '../components/OurEcosystem.astro';
import Footer from '../components/Footer.astro';
import Motion from '../components/Motion.astro';
---

<BaseLayout
  title="About Us — Data Sorcerers"
  description="Architecting the future of AI & data innovation. An AI & data innovation community developing people, research, and technology through collaborative learning."
>
  <Navbar active="About Us" />
  <main id="main">
    <AboutHero />
    <VisiMisi />
    <Philosophy variant="about" />
    <OurEcosystem />
  </main>
  <Footer />
  <Motion />
</BaseLayout>
