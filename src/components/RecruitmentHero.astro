---
import Button from './Button.astro';
---

<section class="recruitment-hero" aria-labelledby="recruitment-hero-title">
  <div class="artwork" aria-hidden="true">
    <img
      class="art-fallback"
      src="/images/backgrounds/recruitment.webp"
      width="1440"
      height="901"
      alt=""
      fetchpriority="high"
      decoding="async"
    />
    <video class="art-video" muted loop playsinline preload="none">
      <source src="/images/recruitment/hero-bg.webm" type="video/webm" />
      <source src="/images/recruitment/hero-bg.mp4" type="video/mp4" />
    </video>
  </div>
  <canvas class="hero-canvas" aria-hidden="true"></canvas>
  <div class="hero-content">
    <div class="hero-header-group">
      <h1 id="recruitment-hero-title">
        <span>Your Next Chapter</span>
        <span>Start here</span>
      </h1>
      <p>
        Join Data Sorcerers and turn your curiosity into capability,
        experiments, research, and real-world projects.
      </p>
    </div>
    <Button variant="apply">Apply Now</Button>
  </div>
</section>
<script>
  import { mountHeroParticles } from '../scripts/hero-particles';

  let disposeParticles: (() => void) | void;
  let videoCleanups: (() => void)[] = [];
  let currentHero: HTMLElement | null = null;

  // Animated hero plate. Same contract as `Hero.astro`: only fetched on larger,
  // motion-OK viewports, and the clip keeps its own frame 0 as the poster so the
  // static `recruitment.webp` never swaps to a different composition mid-view.
  // Under reduced motion (or <=600px) playback never starts and the static art
  // stays the reference render.
  const initHeroVideo = (hero: HTMLElement) => {
    const preload = (window as unknown as { __dsPreload?: Promise<unknown>[] })
      .__dsPreload;
    const reduce = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches;
    const video = hero.querySelector<HTMLVideoElement>('.art-video');
    if (!video) return;
    const wide = window.matchMedia('(min-width: 601px)').matches;
    const conn = (
      navigator as unknown as {
        connection?: { saveData?: boolean; effectiveType?: string };
      }
    ).connection;
    const constrained =
      conn?.saveData === true ||
      conn?.effectiveType === 'slow-2g' ||
      conn?.effectiveType === '2g';
    if (reduce || !wide || constrained) return;
    const artwork = video.closest('.artwork');
    const start = () => {
      artwork?.classList.add('is-video');
      video.classList.add('is-ready');
      void video.play().catch(() => {});
    };
    if (video.readyState >= 2) start();
    else video.addEventListener('loadeddata', start, { once: true });

    // The clip loops forever, so stop decoding once the hero scrolls away
    // (this page is long) and restart it when it comes back.
    const section = video.closest('.recruitment-hero');
    if (section) {
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (!artwork?.classList.contains('is-video')) return;
          if (entry.isIntersecting) void video.play().catch(() => {});
          else video.pause();
        },
        { rootMargin: '160px' },
      );
      observer.observe(section);
      const onVisibility = () => {
        if (!artwork?.classList.contains('is-video')) return;
        if (document.hidden) video.pause();
        else if (section.getBoundingClientRect().bottom > 0)
          void video.play().catch(() => {});
      };
      document.addEventListener('visibilitychange', onVisibility);
      videoCleanups.push(() => {
        observer.disconnect();
        document.removeEventListener('visibilitychange', onVisibility);
      });
    }

    const load = () => {
      // Attach the poster only when the clip is actually about to load, so
      // phones and reduced-motion never fetch the extra frame.
      if (!video.poster) video.poster = '/images/recruitment/hero-poster.webp';
      video.preload = 'auto';
      video.load();
    };
    const armed = document.documentElement.classList.contains('splash-armed');
    const warm = document.documentElement.classList.contains('nav-warm');
    if (armed) {
      // Fetch during the splash (Vite HMR: see Hero.astro) so the clip is
      // ready instead of competing with the reveal.
      preload?.push(
        new Promise<void>((resolve) => {
          if (video.readyState >= 2) resolve();
          else
            video.addEventListener('loadeddata', () => resolve(), {
              once: true,
            });
        }),
      );
      load();
    } else if (warm) {
      load();
    } else if (typeof window.requestIdleCallback === 'function') {
      window.requestIdleCallback(load, { timeout: 2000 });
    } else {
      window.setTimeout(load, 300);
    }
  };

  // Ember field over the plate — the shared particle module on its `embers`
  // preset (rising, warmer, no camera rush) so this hero reads differently from
  // the home one. Mounts only at >=768px with motion allowed; below that, and
  // under reduced motion, the static/video plate stays.
  const initHeroParticles = (hero: HTMLElement) => {
    const preload = (window as unknown as { __dsPreload?: Promise<unknown>[] })
      .__dsPreload;
    const canvas =
      hero.querySelector<HTMLCanvasElement>('.hero-canvas') ?? undefined;
    const host = canvas?.parentElement;
    if (!canvas || !host) return;
    void mountHeroParticles(canvas, host, preload, { preset: 'embers' })
      .then((dispose) => {
        disposeParticles = dispose;
      })
      .catch(() => {});
  };

  const initRecruitmentHero = () => {
    const hero = document.querySelector<HTMLElement>('.recruitment-hero');
    if (!hero || hero === currentHero) return;
    currentHero = hero;
    videoCleanups.forEach((fn) => fn());
    videoCleanups = [];
    initHeroVideo(hero);
    initHeroParticles(hero);
  };

  initRecruitmentHero();
  document.addEventListener('astro:page-load', initRecruitmentHero);
  document.addEventListener('astro:before-swap', () => {
    videoCleanups.forEach((fn) => fn());
    videoCleanups = [];
    if (typeof disposeParticles === 'function') disposeParticles();
    disposeParticles = undefined;
    currentHero = null;
  });
</script>
<style>
  .recruitment-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 866px;
    padding: 0 var(--page-gutter);
    overflow: clip;
    text-align: center;
  }
  .artwork {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .artwork :is(img, video) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .art-video {
    opacity: 0;
  }
  /* At >=601px with motion allowed the clip's own frame 0 (poster) owns the hero
     from the first paint, so the static art never swaps mid-view. Under reduced
     motion, or <=600px, the video stays hidden and `recruitment.webp` remains
     the reference render. */
  @media (prefers-reduced-motion: no-preference) and (min-width: 601px) {
    .art-video {
      opacity: 1;
    }
  }
  /* Once the clip is live, drop the static layer underneath it. */
  .artwork.is-video .art-fallback {
    opacity: 0;
  }
  .artwork::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(5 5 7 / 15%),
      rgb(5 5 7 / 45%) 50%,
      transparent
    );
  }
  .hero-canvas {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 48px;
    width: 1280px;
    max-width: 100%;
  }
  .hero-header-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    width: 100%;
  }
  /* Keep the CTA above the particle canvas and match Figma 120px hug width. */
  .hero-content :global(.button) {
    position: relative;
    z-index: 1;
    width: 120px;
  }
  h1 {
    margin: 0;
    width: 900px;
    max-width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    font-family: var(--font-display);
    font-size: 72px;
    font-weight: 700;
    line-height: 86px;
    letter-spacing: 0;
    text-align: center;
  }
  h1 span {
    display: block;
    height: 86px;
    background: linear-gradient(180deg, #ffffff 15%, #999999 42%, #ffffff 80%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  p {
    margin: 0;
    width: 900px;
    max-width: 100%;
    color: #ede8ff;
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 500;
    line-height: 27px;
    letter-spacing: -0.176px;
  }
  @media (min-width: 1921px) {
    .artwork {
      left: 50%;
      right: auto;
      width: 1920px;
      transform: translateX(-50%);
      mask-image: linear-gradient(
        90deg,
        transparent,
        #000 12%,
        #000 88%,
        transparent
      );
    }
    .artwork :is(img, video) {
      object-position: center bottom;
    }
  }
  @media (max-width: 1100px) {
    .recruitment-hero {
      height: auto;
      min-height: min(760px, 100svh);
      padding: 120px var(--page-gutter) 60px;
    }
    .hero-content {
      gap: 32px;
    }
    .hero-header-group {
      gap: 16px;
    }
    h1 {
      font-size: clamp(40px, 6vw, 72px);
      line-height: 1.225;
    }
    h1 span {
      height: auto;
    }
  }
  @media (max-width: 600px) {
    .recruitment-hero {
      /* svh, not dvh — see Hero.astro: dvh reflows with the address bar. */
      height: auto;
      min-height: 100vh;
      min-height: 100svh;
      justify-content: center;
      padding-top: clamp(96px, 12svh, 120px);
      padding-bottom: clamp(64px, 9svh, 96px);
    }
    .hero-content {
      gap: clamp(24px, 6vw, 36px);
    }
    .hero-header-group {
      gap: clamp(12px, 3.5vw, 16px);
    }
    h1 {
      font-size: clamp(23px, 6.7vw, 40px);
      line-height: 1.2;
    }
    h1 span {
      height: auto;
    }
    p {
      font-size: clamp(15px, 3.9vw, 18px);
      line-height: 1.5;
    }
  }
</style>
