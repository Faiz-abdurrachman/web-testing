---
interface Props {
  href?: string;
  variant?: 'primary' | 'glass' | 'white';
}
const { href, variant = 'primary' } = Astro.props;
---

{href ? (
  <a class:list={['button', variant]} href={href}>
    <slot />
  </a>
) : (
  <button class:list={['button', variant]} type="button" aria-disabled="true">
    <slot />
  </button>
)}
<style>
  .button {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    height: 51px;
    padding: 8px 16px;
    border: 0;
    border-radius: 200px;
    font-size: 18px;
    font-weight: 600;
    line-height: 34.098px;
    white-space: nowrap;
    color: white;
    cursor: pointer;
  }
  .button[aria-disabled] {
    cursor: default;
  }
  .primary,
  .white {
    box-shadow:
      inset 0 2px 1.2px #cfdfff,
      inset -2px -2px 1.4px #97bfff,
      inset -8px -6px 8px rgb(226 202 255 / 25%),
      inset -2px -2px 4px rgb(178 211 255 / 90%);
    outline: 2px solid #cbc5ff;
    outline-offset: -1px;
  }
  .primary {
    width: 205px;
    background: #6c3bff;
    overflow: hidden;
  }
  /* A rotated elliptical gradient reproduces the Figma radial paint in CSS. */
  .primary::before {
    content: '';
    position: absolute;
    z-index: -1;
    width: 20px;
    height: 20px;
    left: 44.211px;
    top: -10px;
    background: radial-gradient(
      circle closest-side at center,
      #6c3bff 0%,
      #845bff 25%,
      #9b7bff 50%,
      #845bff 75%,
      #6c3bff 100%
    );
    transform: matrix(13.439, 5.508, -22.14, 30.09, 0, 0);
  }
  .primary::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    pointer-events: none;
    box-shadow:
      inset 0 2px 1.2px #cfdfff,
      inset -2px -2px 1.4px #97bfff,
      inset -8px -6px 8px rgb(226 202 255 / 25%),
      inset -2px -2px 4px rgb(178 211 255 / 90%);
  }
  .white {
    height: 43px;
    width: 172px;
    background: white;
    color: #1e1e1e;
  }
  .glass {
    width: 198px;
    overflow: hidden;
    background: rgb(217 217 217 / 10%);
    backdrop-filter: blur(6px);
    box-shadow:
      inset 6px 6px 1.06557px -6px rgb(255 255 255 / 50%),
      inset 4px 4px 2px -4px #b3b3b3,
      inset -6px -6px 2px -4px #b3b3b3,
      inset 0 0 0 2px #999,
      inset -3px -3px 3px -1px rgb(255 255 255 / 85%),
      inset 0 0 40px rgb(242 242 242 / 25%);
  }
  .glass::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: radial-gradient(
      ellipse 54px 30px at 30% 110%,
      transparent 40%,
      rgb(255 255 255 / 24%) 55%,
      transparent 75%
    );
  }
  .glass::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 2px;
    background: linear-gradient(
      130deg,
      #fff 4%,
      #ffffff20 20%,
      #ffffff50 70%,
      #fff 92%
    );
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    pointer-events: none;
  }
  @media (max-width: 600px) {
    .button {
      font-size: 15px;
      height: 48px;
    }
    .primary {
      width: 184px;
    }
    .glass {
      width: 180px;
    }
  }
</style>
