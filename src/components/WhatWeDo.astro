  .section-heading {
    position: relative;
    isolation: isolate;
    grid-area: 2 / 1 / 3 / -1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    margin-inline: -80px;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 26px;
    width: 84px;
    padding: 4px 8px;
    border-radius: 32px;
    background: rgb(255 255 255 / 15%);
    box-shadow: inset 0 1px 1px rgb(255 255 255 / 40%);
    font-size: 12px;
    line-height: 18px;
    white-space: nowrap;
  }
  h2 {
    margin: 0;
    width: 100%;
    font-family: var(--font-heading);
    font-size: 56px;
    font-weight: 400;
    line-height: 68px;
    text-align: center;
    background: linear-gradient(270deg, #fff, #ede8ff);
    background-clip: text;
    color: transparent;
  }
  h2 span {
    display: block;
  }
  .pillar {
    position: relative;
    isolation: isolate;
    height: 254px;
    overflow: hidden;
    border-radius: 20px 0;
    background: rgb(255 255 255 / 15%);
  }
  .pillar::after {
    content: '';
    position: absolute;
    inset: 0;
    padding: 1px;
    border-radius: inherit;
    background: linear-gradient(
      135deg,
      #e0dcff,
      #7868a5 40%,
      #3a226e 70%,
      #e0dcff
    );
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    pointer-events: none;
  }
  .pillar-01 {
    grid-area: 1 / 1;
    width: 311px;
  }
  .pillar-02 {
    grid-area: 1 / 3;
    justify-self: end;
    width: 309px;
  }
  .pillar-03 {
    grid-area: 3 / 1;
    width: 309px;
  }
  .pillar-04 {
    grid-area: 3 / 3;
    width: 310px;
  }
  .pillar-copy {
    position: relative;
    z-index: 2;
    margin-top: 37px;
    margin-left: 22px;
    width: 267px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 17px;
    text-align: center;
  }
  .pillar-02 .pillar-copy {
    margin-left: 20px;
  }
  .pillar-03 .pillar-copy,
  .pillar-04 .pillar-copy {
    margin-left: 19px;
  }
  .pillar-heading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
  }
  .number {
    font-size: 16px;
    line-height: 24px;
    letter-spacing: -0.176px;
    color: #ede8ff;
  }
  h3 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 400;
    line-height: 36px;
    letter-spacing: -0.264px;
    white-space: nowrap;
  }
  p {
    margin: 0;
    font-size: 16px;
    line-height: 24px;
    letter-spacing: -0.176px;
  }
  .card-glow {
    position: absolute;
    left: -237.4px;
    top: 101.6px;
    width: 1230.8px;
    height: 357px;
    max-width: none;
    pointer-events: none;
  }
  .pillar::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    background: radial-gradient(
      240px 240px at var(--mx, 50%) var(--my, 50%),
      rgb(155 123 255 / 32%),
      rgb(108 59 255 / 12%) 46%,
      transparent 72%
    );
    opacity: 0;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .pillar {
      transition: box-shadow 0.5s ease;
    }
    .pillar::before {
      transition: opacity 0.45s ease;
    }
    .card-glow {
      transition:
        filter 0.5s ease,
        transform 0.5s ease;
    }
  }
  @media (hover: hover) {
    .pillar:hover {
      box-shadow:
        0 30px 70px -28px rgb(108 59 255 / 75%),
        inset 0 0 0 1px rgb(155 123 255 / 35%);
    }
    .pillar:hover::before {
      opacity: 1;
    }
    .pillar:hover::after {
      filter: brightness(1.5);
    }
    .pillar:hover .card-glow {
      filter: brightness(1.4) saturate(1.15);
      transform: scale(1.04);
    }
  }
  @media (min-width: 761px) and (max-width: 1199px) {
    .what-we-do {
      padding: 64px var(--page-gutter);
    }
    .pillars-layout {
      grid-template-columns: 1fr 32px 1fr;
      grid-template-rows: auto 176px auto;
    }
    .pillar {
      width: 100%;
      max-width: 311px;
    }
    .pillar-04 {
      justify-self: end;
    }
    .pillar-copy,
    .pillar-02 .pillar-copy,
    .pillar-03 .pillar-copy,
    .pillar-04 .pillar-copy {
      width: calc(100% - 40px);
      margin-inline: 20px;
    }
    h3 {
      font-size: clamp(19px, 2vw, 24px);
    }
    p {
      font-size: 15px;
    }
    .section-heading {
      margin-inline: 0;
    }
    h2 {
      font-size: 48px;
      line-height: 60px;
    }
  }
  @media (max-width: 760px) {
    .what-we-do {
      padding: 64px var(--page-gutter);
    }
    .pillars-layout {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 24px;
    }
    .section-heading {
      margin: 0 0 16px;
      width: 100%;
    }
    h2 {
      font-size: clamp(30px, 7vw, 48px);
      line-height: 1.214286;
    }
    .pillar {
