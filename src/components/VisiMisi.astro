---
import Starfield from './Starfield.astro';
---

<section id="visi-misi" class="visi-misi" aria-labelledby="vision-title">
  <Starfield />

  <div class="visi-misi-canvas">
    <div class="visi-misi-inner">
      <!-- Vision block (Figma 1439:4191: 1280 x 145 at y=80, gap 24). -->
      <div class="vm-block vision-block">
        <h2 id="vision-title" class="vm-heading">
          OUR VISION
        </h2>
        <p class="vm-desc vision-desc">
          Data Sorcerers is an AI &amp; Data Innovation Community dedicated to
          developing people, knowledge, research, and technology through
          collaborative learning and real-world experimentation.
        </p>
      </div>

      <!-- Mission block (Figma 1439:4195: 1280 x 435, gap 24). -->
      <div class="vm-block mission-block">
        <h2 id="mission-title" class="vm-heading">
          OUR MISION
        </h2>
        <p class="vm-desc mission-desc">
          Data Sorcerers builds an environment where people can learn deeply,
          experiment boldly, conduct meaningful research, and build real-world
          solutions through collaboration
        </p>

        <ol class="mission-list" aria-label="Our mission objectives">
          <li class="mission-item">
            <span class="item-num" aria-hidden="true">
              1.
            </span>
            <span class="item-text">
              Develop practical AI &amp; Data capabilities.
            </span>
          </li>
          <li class="mission-item">
            <span class="item-num" aria-hidden="true">
              2.
            </span>
            <span class="item-text">
              Encourage experimentation and research.
            </span>
          </li>
          <li class="mission-item">
            <span class="item-num" aria-hidden="true">
              3.
            </span>
            <span class="item-text">
              Create meaningful technology projects.
            </span>
          </li>
          <li class="mission-item">
            <span class="item-num" aria-hidden="true">
              4.
            </span>
            <span class="item-text">
              Connect academia, industry, and community.
            </span>
          </li>
          <li class="mission-item">
            <span class="item-num" aria-hidden="true">
              5.
            </span>
            <span class="item-text">Turn knowledge into tangible outputs.</span>
          </li>
          <li class="mission-item">
            <span class="item-num" aria-hidden="true">
              6.
            </span>
            <span class="item-text">
              Develop talent that can contribute to real-world problems.
            </span>
          </li>
        </ol>
      </div>
    </div>

    <!-- Tarot card artwork (Figma 1439:4218: 356 x 430 at (1028, 261)). -->
    <div class="tarot-card-art" aria-hidden="true">
      <picture>
        <source
          srcset="
            /images/about/tarot-cards.webp    1x,
            /images/about/tarot-cards-2x.webp 2x,
            /images/about/tarot-cards-3x.webp 3x
          "
          sizes="356px"
          type="image/webp"
        />
        <img
          src="/images/about/tarot-cards.webp"
          width="356"
          height="430"
          alt=""
          loading="lazy"
          decoding="async"
        />
      </picture>
    </div>
  </div>
</section>

<style>
  /* Matches Figma node 1439:4190 (1440 x 840), page 1439:4184.
     Section: column, padding 80px, gap 100px, IMAGE fill (starfield).
     Vision block 1439:4191 (1280 x 145): heading 586 x 67 + body 906 x 54.
     Mission block 1439:4195 (1280 x 435): heading 586 x 67 + body 828 x 54 +
     list 797 x 266 (6 rows, gap 16px). Tarot 1439:4218 at (1028, 261). */
  .visi-misi {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    min-height: 100svh;
    padding: 80px;
    overflow: clip;
    background-color: #050507;
  }

  .visi-misi-canvas {
    position: relative;
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
  }

  /* Match the section fill (Figma 1439:4190) under the shared living starfield. */
  .visi-misi :global(.starfield) {
    background-color: #050507;
  }

  .visi-misi-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 100px;
  }

  .vm-block {
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 100%;
  }

  .vm-heading {
    margin: 0;
    width: 100%;
    max-width: 586px;
    font-family: var(--font-display);
    font-size: 56px;
    font-weight: 700;
    line-height: 67.2px;
    letter-spacing: 0;
    background: linear-gradient(181deg, #ffffff 15%, #999999 42%, #ffffff 79%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .vm-desc {
    margin: 0;
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 500;
    line-height: 27px;
    color: #ffffff;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .vision-desc {
    max-width: 906px;
  }

  .mission-desc {
    max-width: 828px;
  }

  /* Mission list (Figma 1439:4199: 797 x 266, gap 16). */
  .mission-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
    max-width: 797px;
  }

  .mission-item {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 31px;
    padding: 2px 16px;
    box-sizing: border-box;
    background: linear-gradient(
      100deg,
      #ffffff -3.5%,
      #6c3bff 3.6%,
      #6c3bff 56.7%,
      rgba(108, 59, 255, 0) 100%
    );
  }

  .mission-item:nth-child(1) {
    width: 713px;
  }
  .mission-item:nth-child(2) {
    width: 733px;
  }
  .mission-item:nth-child(3) {
    width: 746px;
  }
  .mission-item:nth-child(4) {
    width: 775px;
  }
  .mission-item:nth-child(5) {
    width: 786px;
  }
  .mission-item:nth-child(6) {
    width: 797px;
  }

  .item-num {
    flex: none;
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 500;
    line-height: 27px;
    background: linear-gradient(180deg, #9b7bff 0%, #ffffff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .item-text {
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 500;
    line-height: 27px;
    color: #ffffff;
    white-space: nowrap;
  }

  .tarot-card-art {
    position: absolute;
    left: 948px;
    top: 181px;
    z-index: 2;
    width: 356px;
    height: 430px;
    pointer-events: none;
  }

  .tarot-card-art img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  @media (max-width: 1300px) {
    .tarot-card-art {
      left: auto;
      right: clamp(16px, 2.5vw, 40px);
    }
  }

  @media (max-width: 1050px) {
    .visi-misi {
      padding: 64px;
    }
    .visi-misi-inner {
      gap: 64px;
    }
    .vm-heading {
      font-size: clamp(36px, 5vw, 48px);
      line-height: 1.2;
    }
    .tarot-card-art {
      position: relative;
      top: 0;
      left: 0;
      right: 0;
      width: min(300px, 80vw);
      height: auto;
      margin: 32px auto 0;
    }
    .mission-item {
      width: 100% !important;
    }
  }

  @media (max-width: 760px) {
    .visi-misi {
      padding: 48px;
    }
    .visi-misi-inner {
      gap: 48px;
    }
    .vm-heading {
      font-size: clamp(28px, 7vw, 38px);
      line-height: 1.2;
    }
    .vm-desc {
      font-size: 16px;
      line-height: 24px;
    }
    .mission-item {
      height: auto;
      min-height: 34px;
      padding: 6px 14px;
    }
    .item-text {
      white-space: normal;
      font-size: 15px;
      line-height: 22px;
    }
    .tarot-card-art {
      width: 220px;
      height: 265px;
    }
  }
</style>
