---
import DomainRail from './DomainRail.astro';
---

<section id="domains" class="domains" aria-labelledby="domains-title">
  <header>
    <div class="header-inner">
      <div class="heading-group">
        <span class="eyebrow">House of Data Sorcerers</span>
        <h2 id="domains-title">
          <span class="line">
            <span>Choose Your Domain</span>
          </span>
        </h2>
      </div>
      <p>
        Every Sorcerer specializes. Find your domain and go deep with a
        community of experts.
      </p>
    </div>
  </header>
  <DomainRail />
</section>
<style>
  .domains {
    scroll-margin-top: 110px;
    padding-block: 80px;
    background: var(--color-background);
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  header {
    text-align: center;
  }
  .header-inner {
    margin: 0 auto;
    width: min(1280px, calc(100% - 2 * var(--page-gutter)));
    height: 149px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
  }
  .heading-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    width: 100%;
    height: 101px;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 159px;
    height: 26px;
    padding: 4px 12px;
    border-radius: 32px;
    background: rgb(255 255 255 / 15%);
    box-shadow: inset 0 1px 1px rgb(255 255 255 / 40%);
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 400;
    line-height: 18px;
    color: #fff;
    white-space: nowrap;
  }
  h2 {
    margin: 0;
    width: 538px;
    height: 67px;
    font-family: var(--font-display);
    font-size: 56px;
    font-weight: 700;
    line-height: 67.2px;
    letter-spacing: 0;
    text-align: center;
    color: transparent;
  }
  h2 > .line {
    display: inline-block;
    height: 67px;
  }
  h2 > .line > span {
    background: linear-gradient(181deg, #ffffff 15%, #999999 42%, #ffffff 79%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    white-space: nowrap;
  }
  header p {
    margin: 24px 0 0 0;
    width: 100%;
    height: 24px;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    letter-spacing: -0.176px;
    color: #fff;
    text-align: center;
  }
  @media (max-width: 760px) {
    .domains {
      padding-block: 64px;
    }
    .header-inner {
      height: auto;
    }
    .heading-group {
      height: auto;
    }
    h2 {
      width: auto;
      height: auto;
      font-size: clamp(30px, 7vw, 48px);
      line-height: 1.214286;
    }
    h2 > .line {
      height: auto;
    }
    h2 > .line > span {
      white-space: normal;
    }
    header p {
      height: auto;
      margin-top: 16px;
      font-size: 14px;
      line-height: 21px;
    }
  }
</style>
