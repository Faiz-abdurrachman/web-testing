            </svg>
            <svg viewBox="0 0 16 16" width="16" height="16" fill="none">
              <path
                d="M14.8156 0H1.18125C0.528125 0 0 0.515625 0 1.15313V14.8438C0 15.4813 0.528125 16 1.18125 16H14.8156C15.4688 16 16 15.4813 16 14.8469V1.15313C16 0.515625 15.4688 0 14.8156 0ZM4.74687 13.6344H2.37188V5.99687H4.74687V13.6344ZM3.55938 4.95625C2.79688 4.95625 2.18125 4.34062 2.18125 3.58125C2.18125 2.82188 2.79688 2.20625 3.55938 2.20625C4.31875 2.20625 4.93437 2.82188 4.93437 3.58125C4.93437 4.3375 4.31875 4.95625 3.55938 4.95625ZM13.6344 13.6344H11.2625V9.92188C11.2625 9.0375 11.2469 7.89687 10.0281 7.89687C8.79375 7.89687 8.60625 8.8625 8.60625 9.85938V13.6344H6.2375V5.99687H8.5125V7.04063H8.54375C8.85938 6.44063 9.63438 5.80625 10.7875 5.80625C13.1906 5.80625 13.6344 7.3875 13.6344 9.44375V13.6344Z"
                fill="white"
                fill-opacity="0.53"
              />
            </svg>
          </span>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  /* Matches Figma node 1439:4512 (1440 × 1241): padding 80, header (768 wide,
     gap 24) then a gap 80 to the gallery (two rows of four 302×400 cards,
     column gap 24 / row gap 66). The card is proportional via container queries
     (1cqw = 3.02px at the 302px reference card) like `AvailableRoles`. */
  .hof-featured {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 80px;
    padding: 80px;
    background: #050507;
  }

  .featured-header {
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 768px;
    max-width: 100%;
    text-align: center;
  }

  .featured-header h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 56px;
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: -0.011em;
    background: linear-gradient(181deg, #fff 15%, #999 42%, #fff 79%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .featured-header p {
    margin: 0;
    color: #fff;
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 500;
    line-height: 27px;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: 24px;
    row-gap: 66px;
    width: 100%;
    max-width: 1280px;
  }

  /* Figma does not clip the card: the portrait bleeds above the 302×400 frame
     (the exported photo rects keep their own bottom radius). */
  .featured-card {
    position: relative;
    container-type: inline-size;
    aspect-ratio: 302 / 400;
    border-radius: 10px;
    background: rgb(255 255 255 / 10%);
  }

  .card-photo {
    position: absolute;
    top: -13.91cqw;
    left: 0;
    display: block;
    width: 100cqw;
    height: 146.36cqw;
    object-fit: fill;
  }
  .featured-card.is-lead .card-photo {
    top: -43.71cqw;
    height: 176.16cqw;
  }

  .card-frame {
    position: absolute;
    top: 4.3cqw;
    left: 0.99cqw;
    width: 97.68cqw;
    height: 91.72cqw;
    pointer-events: none;
  }

  .card-fade {
    position: absolute;
    inset: auto 0 0;
    display: block;
    width: 100%;
    height: 50.66cqw;
    border-radius: 0 0 10px 10px;
    pointer-events: none;
  }

  .card-meta {
    position: absolute;
    top: 94.04cqw;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.32cqw;
    width: 71.85cqw;
    text-align: center;
  }
  .featured-card.is-lead .card-meta {
    width: max-content;
  }

  .card-name {
    color: #fff;
    font-family: var(--font-body);
    font-size: 7.28cqw;
    font-weight: 700;
    line-height: 10.93cqw;
    white-space: nowrap;
  }

  .card-divider {
    display: block;
    width: 100%;
    height: 1px;
    background: rgb(255 255 255 / 30%);
  }

  .card-role {
    color: #fff;
    font-family: var(--font-body);
    font-size: 5.3cqw;
    font-weight: 400;
    line-height: 7.95cqw;
  }
  .card-role.is-muted {
    color: #d8d1d1;
  }

  .card-socials {
    display: flex;
    align-items: center;
    gap: 3.31cqw;
    height: 5.3cqw;
  }
  .card-socials svg {
    display: block;
    width: 5.3cqw;
    height: 5.3cqw;
  }

  @media (max-width: 1100px) {
    .hof-featured {
      padding: 64px var(--page-gutter);
      gap: 56px;
    }
    .featured-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .hof-featured {
      padding: 56px var(--page-gutter);
      gap: 44px;
    }
    .featured-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .featured-header h2 {
      font-size: clamp(34px, 9vw, 56px);
      line-height: 1.3;
    }
    .featured-header p {
      font-size: 16px;
      line-height: 24px;
    }
  }
</style>
