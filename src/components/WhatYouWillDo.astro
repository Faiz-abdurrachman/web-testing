---
import Starfield from './Starfield.astro';

// Layout comes from Figma node 1436:3517 (Section 3 Recruitment Page).
// The Header Frame 2734 is 1280x118 at (80, 80) with 24px gap.
// Section gap to Body is 20px (Body at 64, 218).
// The Body Frame 2542 is a fixed 1312x625 collage and the eight labels live in
// the 1125x409 "Content" frame (at 94, 130 of the Body; absolute 158, 348).
const labels: [string, number, number, number | null, number][] = [
  ['LEARN WITH OTHERS', 0, 0, 58, 462],
  ['PRACTICE YOUR SKILLS', 0, 47, 58, 461],
  ['WORK ON EXPERIMENTS', 222, 102, null, 462],
  ['CONTRIBUTE TO PROJECTS', 222, 149, null, 462],
  ['PARTICIPATE IN RESEARCH', 442, 204, 30, 462],
  ['SHARE KNOWLEDGE', 442, 251, 30, 462],
  ['BUILD YOUR PORTOFOLIO', 663, 306, 46, 462],
  ['COLLABORATE ACROSS DISCIPLINES', 663, 353, 46, 462],
];
const gradient = (stop: number | null) =>
  stop === null
    ? 'linear-gradient(134deg, #fff 0%, #6c3bff 8%, rgb(108 59 255 / 0%) 100%)'
    : `linear-gradient(134deg, #fff 0%, #6c3bff 8%, #6c3bff ${stop}%, rgb(108 59 255 / 0%) 100%)`;
---

<section
  id="what-you-will-do"
  class="what-you-will-do"
  aria-labelledby="what-you-will-do-title"
>
  <Starfield />
  <header class="wyd-header">
    <h2 id="what-you-will-do-title">What You Will Do</h2>
    <p>Life inside the Data Sorcerers ecosystem</p>
  </header>

  <div class="wyd-body">
    <img
      class="card card-1"
      src="/images/what-you-will-do/card-1-356.webp"
      srcset="
        /images/what-you-will-do/card-1-356.webp 356w,
        /images/what-you-will-do/card-1-712.webp 712w
      "
      sizes="356px"
      width="356"
      height="430"
      alt=""
      loading="lazy"
      decoding="async"
    />
    <img
      class="card card-2"
      src="/images/what-you-will-do/card-2-295.webp"
      srcset="
        /images/what-you-will-do/card-2-295.webp 295w,
        /images/what-you-will-do/card-2-590.webp 590w
      "
      sizes="296px"
      width="295"
      height="362"
      alt=""
      loading="lazy"
      decoding="async"
    />
    <img
      class="connector"
      src="/images/what-you-will-do/connector.svg"
      width="1312"
      height="531"
      alt=""
      loading="lazy"
      decoding="async"
    />
    <div class="content">
      {labels.map(([text, x, y, stop, width]) => (
        <div
          class="label"
          style={`--x:${x}px;--y:${y}px;--w:${width}px;--grad:${gradient(stop)}`}
        >
          <span class="dot" aria-hidden="true" />
          <span class="label-text">{text}</span>
        </div>
      ))}
    </div>
  </div>
</section>
<style>
  .what-you-will-do {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    height: 903px;
    padding: 80px;
    /* Living star sky, same as the home "Four Pillars of Innovation" section. */
    position: relative;
    isolation: isolate;
    background-color: #000;
    overflow: clip;
  }
  .wyd-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    width: 1280px;
    max-width: 100%;
    flex: none;
  }
  h2 {
    margin: 0;
    width: 1280px;
    max-width: 100%;
    font-family: var(--font-display);
    font-size: 56px;
    font-weight: 700;
    line-height: 67px;
    letter-spacing: 0;
    text-align: center;
    background: linear-gradient(181deg, #ffffff 15%, #999999 42%, #ffffff 79%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
    flex: none;
  }
  p {
    margin: 0;
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 500;
    line-height: 27px;
    letter-spacing: 0;
    color: #fff;
    text-align: center;
    flex: none;
  }
  .wyd-body {
    position: relative;
    width: 1312px;
    height: 625px;
    flex: none;
  }
  .card {
    position: absolute;
    display: block;
  }
  .card-1 {
    left: 919px;
    top: 0;
    width: 356px;
    height: 430px;
  }
  .card-2 {
    left: 65px;
    top: 216px;
    width: 295.39px;
    height: 361.78px;
  }
  .connector {
    position: absolute;
    left: 0;
    /* Figma y=96, but the reference PNG aligns at 95 (SVG 531 vs node 529). */
    top: 95px;
    display: block;
    width: 1312px;
    height: 531px;
  }
  .content {
    position: absolute;
    left: 94px;
    top: 130px;
    width: 1125px;
    height: 409px;
  }
  .label {
    position: absolute;
    left: var(--x);
    top: var(--y);
    display: flex;
    align-items: center;
    gap: 10px;
    width: var(--w);
    height: 31px;
    padding: 2px 16px;
    background: var(--grad);
  }
  .dot {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: linear-gradient(135deg, #6c3bff 17%, #ede8ff 50%, #6c3bff 83%);
  }
  .label-text {
    font-size: 18px;
    font-weight: 500;
    line-height: 27px;
    color: #fff;
    white-space: nowrap;
  }
  @media (max-width: 1320px) {
    .what-you-will-do {
      height: auto;
      padding: 64px 24px;
    }
    .wyd-header {
      width: 100%;
    }
    h2 {
      font-size: clamp(30px, 7vw, 48px);
      line-height: 1.214286;
    }
    p {
      font-size: 16px;
    }
    .wyd-body {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
      width: 100%;
      height: auto;
    }
    .card,
    .connector {
      display: none;
    }
    .content {
      position: static;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
      width: 100%;
      height: auto;
    }
    .label {
      position: static;
      width: 100%;
      max-width: 462px;
      height: auto;
      min-height: 31px;
    }
    .label-text {
      font-size: 16px;
      line-height: 24px;
      white-space: normal;
    }
  }
</style>
