---
import Button from './Button.astro';
---

<section class="recruitment-hero" aria-labelledby="recruitment-hero-title">
  <div class="artwork" aria-hidden="true">
    <img
      class="art-fallback"
      src="/images/backgrounds/recruitment.webp"
      width="1440"
      height="901"
      alt=""
      fetchpriority="high"
      decoding="async"
    />
    <video
      class="art-video"
      muted
      loop
      playsinline
      preload="none"
      poster="/images/recruitment/hero-poster.webp"
    >
      <source src="/images/recruitment/hero-bg.webm" type="video/webm" />
      <source src="/images/recruitment/hero-bg.mp4" type="video/mp4" />
    </video>
  </div>
  <div class="hero-content">
    <h1 id="recruitment-hero-title">
      <span>YOUR NEXT CHAPTER</span>
      <span>START HERE.</span>
    </h1>
    <p>
      Join Data Sorcerers and turn your curiosity into capability, experiments,
      research, and real-world projects.
    </p>
  </div>
  <Button variant="secondary">Apply Now</Button>
</section>
<script>
  // Animated hero plate. Same contract as `Hero.astro`: only fetched on larger,
  // motion-OK viewports, and the clip keeps its own frame 0 as the poster so the
  // static `recruitment.webp` never swaps to a different composition mid-view.
  // Under reduced motion (or <=600px) playback never starts and the static art
  // stays the reference render.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const preload = (window as unknown as { __dsPreload?: Promise<unknown>[] })
    .__dsPreload;
  const video = document.querySelector<HTMLVideoElement>(
    '.recruitment-hero .art-video',
  );
  if (video) {
    const wide = window.matchMedia('(min-width: 601px)').matches;
    const conn = (
      navigator as unknown as {
        connection?: { saveData?: boolean; effectiveType?: string };
      }
    ).connection;
    const constrained =
      conn?.saveData === true ||
      conn?.effectiveType === 'slow-2g' ||
      conn?.effectiveType === '2g';
    if (!reduce && wide && !constrained) {
      const artwork = video.closest('.artwork');
      const start = () => {
        artwork?.classList.add('is-video');
        video.classList.add('is-ready');
        void video.play().catch(() => {});
      };
      if (video.readyState >= 2) start();
      else video.addEventListener('loadeddata', start, { once: true });

      // The clip loops forever, so stop decoding once the hero scrolls away
      // (this page is long) and restart it when it comes back.
      const section = video.closest('.recruitment-hero');
      if (section) {
        new IntersectionObserver(
          ([entry]) => {
            if (!artwork?.classList.contains('is-video')) return;
            if (entry.isIntersecting) void video.play().catch(() => {});
            else video.pause();
          },
          { rootMargin: '160px' },
        ).observe(section);
        document.addEventListener('visibilitychange', () => {
          if (!artwork?.classList.contains('is-video')) return;
          if (document.hidden) video.pause();
          else if (section.getBoundingClientRect().bottom > 0)
            void video.play().catch(() => {});
        });
      }

      const load = () => {
        video.preload = 'auto';
        video.load();
      };
      const armed = document.documentElement.classList.contains('splash-armed');
      const warm = document.documentElement.classList.contains('nav-warm');
      if (armed) {
        // Fetch during the splash (Vite HMR: see Hero.astro) so the clip is
        // ready instead of competing with the reveal.
        preload?.push(
          new Promise<void>((resolve) => {
            if (video.readyState >= 2) resolve();
            else
              video.addEventListener('loadeddata', () => resolve(), {
                once: true,
              });
          }),
        );
        load();
      } else if (warm) {
        load();
      } else if (typeof window.requestIdleCallback === 'function') {
        window.requestIdleCallback(load, { timeout: 2000 });
      } else {
        window.setTimeout(load, 300);
      }
    }
  }
</script>
<style>
  .recruitment-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 63px;
    min-height: min(866px, 100svh);
    padding: 140px var(--page-gutter) 80px;
    overflow: clip;
    text-align: center;
  }
  .artwork {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .artwork :is(img, video) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .art-video {
    opacity: 0;
  }
  /* At >=601px with motion allowed the clip's own frame 0 (poster) owns the hero
     from the first paint, so the static art never swaps mid-view. Under reduced
     motion, or <=600px, the video stays hidden and `recruitment.webp` remains
     the reference render. */
  @media (prefers-reduced-motion: no-preference) and (min-width: 601px) {
    .art-video {
      opacity: 1;
    }
  }
  /* Once the clip is live, drop the static layer underneath it. */
  .artwork.is-video .art-fallback {
    opacity: 0;
  }
  .artwork::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(5 5 7 / 15%),
      rgb(5 5 7 / 45%) 50%,
      transparent
    );
  }
  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 34px;
    width: 100%;
  }
  h1 {
    margin: 0;
    width: 900px;
    max-width: 100%;
    font-family: var(--font-heading);
    font-size: 80px;
    font-weight: 400;
    line-height: 98px;
    background: linear-gradient(180deg, #fff 0%, #d8d1ed 55%, #fff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  h1 span {
    display: block;
  }
  p {
    margin: 0;
    width: 900px;
    max-width: 100%;
    color: #ede8ff;
    font-size: 18px;
    font-weight: 500;
    line-height: 27px;
  }
  @media (min-width: 1921px) {
    .artwork {
      left: 50%;
      right: auto;
      width: 1920px;
      transform: translateX(-50%);
      mask-image: linear-gradient(
        90deg,
        transparent,
        #000 12%,
        #000 88%,
        transparent
      );
    }
    .artwork :is(img, video) {
      object-position: center bottom;
    }
  }
  @media (max-width: 1100px) {
    .recruitment-hero {
      min-height: min(760px, 100svh);
      gap: 48px;
    }
    h1 {
      font-size: clamp(40px, 6vw, 72px);
      line-height: 1.225;
    }
  }
  @media (max-width: 600px) {
    .recruitment-hero {
      /* svh, not dvh — see Hero.astro: dvh reflows with the address bar. */
      min-height: 100vh;
      min-height: 100svh;
      gap: clamp(28px, 7vw, 48px);
      justify-content: center;
      padding-top: clamp(96px, 12svh, 120px);
      padding-bottom: clamp(64px, 9svh, 96px);
    }
    .hero-content {
      gap: clamp(16px, 4.5vw, 24px);
    }
    h1 {
      font-size: clamp(23px, 6.7vw, 40px);
      line-height: 1.2;
    }
    p {
      font-size: clamp(15px, 3.9vw, 18px);
      line-height: 1.5;
    }
  }
</style>
