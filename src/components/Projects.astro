---
import { projects } from '../data/projects';
---

<section id="projects" class="projects" aria-labelledby="projects-title">
  <div class="projects-inner">
    <header>
      <span class="eyebrow">Our Project</span>
      <h2 id="projects-title">What Our Sorcery Create</h2>
    </header>
    <div
      class="project-stage"
      tabindex="0"
      role="group"
      aria-roledescription="carousel"
      aria-label="Projects — use the arrow keys to browse"
    >
      <div class="project-track">
        {projects.map((project, index) => (
          <article
            class:list={['project-card', { 'is-active': index === 0 }]}
            data-index={index}
            aria-hidden={index === 0 ? undefined : 'true'}
            aria-labelledby={`project-${project.id}`}
          >
            <div class="project-inner">
              <div class="project-image">
                <img
                  src={project.image}
                  width="1799"
                  height="1102"
                  alt=""
                  loading={index === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </div>
              <div class="project-tags" aria-label="Project categories">
                {project.tags.map((tag) => (
                  <span>{tag}</span>
                ))}
              </div>
              <div class="project-copy">
                <h3 id={`project-${project.id}`}>{project.title}</h3>
                <p>{project.description}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
      <button
        class="project-arrow prev"
        type="button"
        aria-label="Previous project"
        data-dir="-1"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M15 5l-7 7 7 7"></path>
        </svg>
      </button>
      <button
        class="project-arrow next"
        type="button"
        aria-label="Next project"
        data-dir="1"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M9 5l7 7-7 7"></path>
        </svg>
      </button>
    </div>
    <div class="project-dots" role="tablist" aria-label="Select project">
      {projects.map((project, index) => (
        <button
          class="dot"
          type="button"
          role="tab"
          aria-label={project.title}
          aria-selected={index === 0}
          data-index={index}
        />
      ))}
    </div>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('.project-stage').forEach((stage) => {
    const cards = [...stage.querySelectorAll<HTMLElement>('.project-card')];
    const arrows = [
      ...stage.querySelectorAll<HTMLButtonElement>('.project-arrow'),
    ];
    const dots = [
      ...(stage
        .closest('.projects')
        ?.querySelectorAll<HTMLButtonElement>('.project-dots .dot') ?? []),
    ];
    if (!cards.length) return;
    const count = cards.length;
    let active = 0;

    const render = () => {
      const width = 549;
      const stageWidth = stage.clientWidth || 1280;
      const base = Math.min(1, (stageWidth * 0.9) / width);
      stage.style.height = `${567 * base}px`;
      // Left / centre / right slots: the side cards sit where the reference's
      // decorative panels are (centres at x = 260 and 1180 on the 1440 grid).
      const sideOffset = width * 0.838 * base;
      const step = width * 0.62 * base;
      cards.forEach((card, index) => {
        let slot = index - active;
        if (slot > count / 2) slot -= count;
        else if (slot < -count / 2) slot += count;
        const distance = Math.abs(slot);
        const direction = Math.sign(slot);
        const x =
          direction * (sideOffset + (distance > 1 ? (distance - 1) * step : 0));
        const scale =
          slot === 0
            ? base
            : base * Math.max(0.35, 0.661 - (distance - 1) * 0.18);
        const rotate = slot === 0 ? 0 : -direction * 24;
        const depth = slot === 0 ? 0 : -110 * distance * base;
        card.style.transform =
          `translate(-50%, -50%) ` +
          `translateX(${x}px) translateZ(${depth}px) ` +
          `rotateY(${rotate}deg) scale(${scale})`;
        card.style.opacity =
          distance > 2
            ? '0'
            : slot === 0
              ? '1'
              : String(Math.max(0.3, 0.85 - (distance - 1) * 0.35));
        card.style.filter =
          slot === 0
            ? 'none'
            : `blur(${6 + (distance - 1) * 3}px) brightness(0.72)`;
        card.style.zIndex = String(100 - distance);
        card.style.pointerEvents = slot === 0 ? 'auto' : 'none';
        card.classList.toggle('is-active', index === active);
        card.setAttribute('aria-hidden', index === active ? 'false' : 'true');
      });
      dots.forEach((dot, index) =>
        dot.setAttribute('aria-selected', String(index === active)),
      );
    };

    const go = (delta: number) => {
      active = (active + delta + count) % count;
      render();
    };

    arrows.forEach((arrow) =>
      arrow.addEventListener('click', () => go(Number(arrow.dataset.dir))),
    );
    dots.forEach((dot, index) =>
      dot.addEventListener('click', () => {
        active = index;
        render();
      }),
    );
    stage.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        go(-1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        go(1);
      }
    });
    // Arrow keys drive the carousel whenever its section is the one at the
    // viewport centre (no focus needed); the focused stage handler runs first
    // and sets defaultPrevented, so this one skips.
    const section = stage.closest('.projects') ?? stage;
    addEventListener('keydown', (event) => {
      if (event.defaultPrevented) return;
      const target = event.target as HTMLElement | null;
      if (target?.closest('input, textarea, select, [contenteditable="true"]'))
        return;
      const rect = section.getBoundingClientRect();
      const center = innerHeight / 2;
      if (rect.top > center || rect.bottom < center) return;
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        go(-1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        go(1);
      }
    });
    let startX: number | null = null;
    stage.addEventListener('pointerdown', (event) => {
      startX = event.clientX;
    });
    const end = (event: PointerEvent) => {
      if (startX === null) return;
      const delta = event.clientX - startX;
      startX = null;
      if (Math.abs(delta) > 40) go(delta < 0 ? 1 : -1);
    };
    stage.addEventListener('pointerup', end);
    stage.addEventListener('pointercancel', () => {
      startX = null;
    });
    addEventListener('resize', render, { passive: true });
    render();
  });
</script>
<style>
  .projects {
    position: relative;
    padding: 80px var(--page-gutter);
    background: var(--color-background);
    overflow: clip;
  }
  .projects-inner {
    max-width: 1280px;
    margin-inline: auto;
  }
  header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 26px;
    padding: 4px 12px;
    border-radius: 32px;
    background: rgb(255 255 255 / 15%);
    box-shadow: inset 0 1px 1px rgb(255 255 255 / 40%);
    font-size: 12px;
    line-height: 18px;
  }
  h2 {
    margin: 0;
    font: 400 56px/68px var(--font-heading);
    background: linear-gradient(270deg, #fff, #ede8ff);
    background-clip: text;
    color: transparent;
  }
  .project-stage {
    position: relative;
    height: 567px;
    margin-top: 82px;
    perspective: 1800px;
    outline: none;
    touch-action: pan-y;
    cursor: grab;
  }
  .project-stage:active {
    cursor: grabbing;
  }
  .project-stage:focus-visible {
    outline: 2px solid #bba7ff;
    outline-offset: 12px;
    border-radius: 24px;
  }
  .project-track {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }
  .project-card {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 549px;
    height: 567px;
    border-radius: 20px;
    opacity: 0;
    transform: translate(-50%, -50%);
    transition:
      transform 0.62s cubic-bezier(0.22, 0.61, 0.36, 1),
      opacity 0.5s ease,
      filter 0.5s ease,
      box-shadow 0.5s ease;
    will-change: transform, opacity, filter;
  }
  .project-card.is-active {
    opacity: 1;
  }
  .project-card::before {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -26px;
    z-index: -1;
    width: 68%;
    height: 152px;
    transform: translateX(-50%);
    background: radial-gradient(
      closest-side,
      rgb(108 59 255 / 68%),
      rgb(108 59 255 / 0%)
    );
    filter: blur(24px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease;
  }
  .project-card.is-active::before {
    opacity: 1;
  }
  .project-inner {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    clip-path: inset(0 round 20px);
    background: rgb(98 80 255 / 10%);
  }
  .project-inner::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(
      135deg,
      #e0dcff,
      #332959 52%,
      #332959 75%,
      #e0dcff
    );
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    pointer-events: none;
  }
  .project-image {
    position: absolute;
    top: 0.176%;
    left: 0;
    width: 106.921676%;
    height: 61.552028%;
    overflow: hidden;
    opacity: 0.8;
  }
  .project-image img {
    display: block;
    position: absolute;
    top: -0.03%;
    width: 100%;
    height: 102.90974%;
    max-width: none;
  }
  .project-tags {
    position: absolute;
    top: 53.791888%;
    left: 10.018215%;
    display: flex;
    gap: 16px;
  }
  .project-tags span {
    padding: 4px 12px;
    border-radius: 32px;
    background: #6c3bff;
    font-size: 12px;
    line-height: 18px;
    white-space: nowrap;
  }
  .project-copy {
    position: absolute;
    left: 9.562841%;
    top: 67.724868%;
    width: 82.149362%;
  }
  h3 {
    margin: 0 0 15px 0.5px;
    font-size: 26px;
    line-height: 39px;
    font-weight: 700;
  }
  .project-copy p {
    margin: 0;
    font-size: 16px;
    line-height: 24px;
  }
  .project-arrow {
    position: absolute;
    top: 50%;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    transform: translateY(-50%);
    border: 1px solid rgb(203 197 255 / 60%);
    border-radius: 50%;
    background: rgb(16 9 35 / 85%);
    backdrop-filter: blur(6px);
    cursor: pointer;
  }
  .project-arrow svg {
    width: 26px;
    height: 26px;
    fill: none;
    stroke: #fff;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .project-arrow.prev {
    left: 0;
  }
  .project-arrow.next {
    right: 0;
  }
  .project-arrow:disabled {
    opacity: 0.25;
    cursor: default;
  }
  .project-dots {
    position: absolute;
    bottom: 26px;
    left: 50%;
    display: flex;
    gap: 10px;
    transform: translateX(-50%);
  }
  .dot {
    width: 9px;
    height: 9px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 25%);
    cursor: pointer;
    transition:
      background 0.3s ease,
      transform 0.3s ease;
  }
  .dot[aria-selected='true'] {
    background: #9b7bff;
    transform: scale(1.35);
  }
  @media (max-width: 1050px) {
    .project-arrow {
      top: auto;
      bottom: -66px;
      transform: none;
    }
  }
  @media (max-width: 760px) {
    .projects {
      padding-block: 64px;
    }
    h2 {
      font-size: clamp(30px, 7vw, 48px);
      line-height: 1.214286;
    }
    .project-stage {
      margin-top: 40px;
    }
    .project-arrow {
      top: auto;
      bottom: -52px;
      width: 40px;
      height: 40px;
      transform: none;
    }
    .project-arrow svg {
      width: 20px;
      height: 20px;
    }
    .project-arrow.prev {
      left: 0;
    }
    .project-arrow.next {
      right: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .project-card {
      transition: none;
    }
  }
</style>
