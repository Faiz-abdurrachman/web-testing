---
import HeroVideo from './HeroVideo.astro';
---

<section class="partners-hero" aria-labelledby="partners-hero-title">
  <div class="artwork" aria-hidden="true">
    <picture>
      <source
        type="image/webp"
        srcset="/images/partners/hero-bg.webp 1x, /images/partners/hero-bg-2x.webp 2x"
        width="1440"
        height="665"
      />
      <img
        class="art-bg"
        src="/images/partners/hero-bg.webp"
        width="1440"
        height="665"
        alt=""
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <HeroVideo
      webm="/images/partners/hero-bg.webm"
      mp4="/images/partners/hero-bg.mp4"
      poster="/images/partners/hero-poster.webp"
    />
  </div>
  <div class="hero-content">
    <span class="pill">Create · Collaborate · Make an impact</span>
    <h1 id="partners-hero-title">
      <span>Let's Build Something</span>
      <span>Meaningful Together.</span>
    </h1>
  </div>
</section>

<script>
  import { mountHeroVideo } from '../scripts/hero-video';

  let currentVideo: HTMLVideoElement | null = null;
  let disposeVideo: (() => void) | undefined;
  const initVideo = () => {
    const video = document.querySelector<HTMLVideoElement>(
      '.partners-hero .art-video',
    );
    if (!video || video === currentVideo) return;
    disposeVideo?.();
    currentVideo = video;
    disposeVideo = mountHeroVideo(video);
  };
  initVideo();
  document.addEventListener('astro:page-load', initVideo);
  document.addEventListener('astro:before-swap', () => {
    disposeVideo?.();
    disposeVideo = undefined;
    currentVideo = null;
  });
</script>

<style>
  /* Matches Figma node 1439:4788 (1440 x 659, page 1439:4787): column,
     padding 242px 80px 160px, align centre, gap 8px, IMAGE fill. CTA pill
     1439:4789 228x26 on rgba(255,255,255,.15); heading 1439:4791 is a single
     Bluu Next Bold 700 80/102 text node (789x180 ink @ 326,295) whose gradient
     181deg #fff 15% / #999 42% / #fff 79% spans the whole 223px box. */
  .partners-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    min-height: 659px;
    padding: 242px 80px 160px;
    box-sizing: border-box;
    overflow: clip;
    background: var(--color-background);
    text-align: center;
  }
  .artwork {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .artwork picture,
  .artwork .art-bg,
  .artwork :global(.art-video) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .artwork :global(.art-video) {
    opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) and (min-width: 601px) {
    .artwork :global(.art-video.is-ready) {
      opacity: 1;
    }
  }
  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    width: 100%;
    max-width: 1280px;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px 12px;
    border-radius: 32px;
    background: rgb(255 255 255 / 15%);
    color: #fff;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 400;
    line-height: 18px;
    white-space: nowrap;
  }
  h1 {
    margin: 0;
    width: 100%;
    height: 223px;
    font-family: var(--font-display);
    font-size: 80px;
    font-weight: 700;
    line-height: 102px;
    letter-spacing: normal;
    text-align: center;
    /* One gradient across the whole 2-line text node (not per line). */
    background: linear-gradient(181deg, #ffffff 15%, #999999 42%, #ffffff 79%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  h1 span {
    display: block;
  }

  @media (max-width: 1100px) {
    .partners-hero {
      min-height: min(760px, 100svh);
      padding: calc(94px + 64px) 48px 96px;
    }
    h1 {
      height: auto;
      font-size: clamp(40px, 6.5vw, 68px);
      line-height: 1.2;
    }
  }
  @media (max-width: 760px) {
    h1 span {
      display: inline;
    }
  }
  @media (max-width: 600px) {
    .partners-hero {
      min-height: 100vh;
      min-height: 100svh;
      justify-content: center;
      padding: clamp(110px, 18svh, 150px) 24px clamp(48px, 10svh, 72px);
    }
    h1 {
      font-size: clamp(30px, 8.4vw, 44px);
      line-height: 1.2;
    }
  }
</style>
