---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="The Observatory — Data Sorcerers 3D Lab" noindex>
  <main id="main" class="lab" data-mode="hero">
    <div id="scene" aria-label="Interactive sorcerer observatory"></div>
    <div class="shade"></div>
    <header>
      <a href="/" class="brand">
        <img
          src="/images/logo.png"
          alt="Data Sorcerers"
          width="38"
          height="42"
        />
        <span>
          DATA
          <br />
          SORCERERS
        </span>
      </a>
      <span class="edition">EXPERIMENT 001 / THE OBSERVATORY</span>
      <a class="home" href="/">
        Back to website ↗
      </a>
    </header>
    <div class="hero-copy">
      <p class="eyebrow">
        <span></span> A WORLD BUILT FROM POSSIBILITY
      </p>
      <h1>
        SORCERY
        <br />
        IN DATA.
        <br />
        <em>MAGIC IN AI.</em>
      </h1>
      <p class="intro">
        Where curiosity becomes discovery.
        <br />
        Step inside the world of Data Sorcerers.
      </p>
      <button id="enter" class="enter">
        Enter the observatory <span>↗</span>
      </button>
    </div>
    <div class="compare-copy">
      <p class="eyebrow">THE SAME LIGHT. THE SAME SCALE.</p>
      <h1>Choose your sorcerer.</h1>
      <p>Drag to orbit both models. Scroll over the scene to zoom.</p>
    </div>
    <div class="model-labels" hidden>
      <span>
        01 / HUNYUAN<small>370,732 triangles · 6.67 MB</small>
      </span>
      <span>
        02 / HI3DGEN<small>486,444 triangles · 8.76 MB</small>
      </span>
    </div>
    <p id="status" role="status" aria-live="polite">
      A real-time 3D study. Load the scene to explore.
    </p>
    <div class="toolbar" aria-label="Preview controls">
      <div class="mode-switch">
        <button data-mode="hero" aria-pressed="true">
          World
        </button>
        <button data-mode="compare" aria-pressed="false">
          Compare models
        </button>
      </div>
      <label class="model-select">
        Sorcerer{' '}
        <select id="model">
          <option value="hi3dgen">Hi3DGen</option>
          <option value="hunyuan">Hunyuan</option>
        </select>
      </label>
      <div class="views" hidden aria-label="Camera views">
        <button data-view="front">Front</button>
        <button data-view="side">Side</button>
        <button data-view="back">Back</button>
      </div>
      <button id="motion" aria-pressed="false">
        Pause motion
      </button>
    </div>
    <footer>
      <span>
        3D ART DIRECTION STUDY <b> / 01</b>
      </span>
      <span class="footnote">Untextured models · provisional materials</span>
    </footer>
  </main>
  <section class="notes" aria-label="About this prototype">
    <p class="eyebrow">FROM AN IMAGE TO A WORLD</p>
    <h2>
      One scene.
      <br />
      Infinite possibility.
    </h2>
    <p>
      This study explores depth, violet light, and a slow camera journey. The
      original generated geometry is preserved for comparison. Character
      textures, staff, and final optimization are the next art pass.
    </p>
    <a href="/">Return to Data Sorcerers ↗</a>
  </section>
</BaseLayout>

<script>
  const status = document.querySelector<HTMLElement>('#status')!;
  let boot: Promise<void> | undefined;
  const start = (mode: 'hero' | 'compare' = 'hero') => {
    if (boot) return boot;
    status.textContent = 'Opening the observatory…';
    boot = import('../../scripts/hero-lab')
      .then((module) => module.initHeroLab(mode))
      .catch(() => {
        status.textContent =
          'The 3D scene could not load. Reload to try again; the original website is still available.';
      });
    return boot;
  };
  document
    .querySelector('#enter')
    ?.addEventListener('click', () => void start());
  document
    .querySelectorAll<HTMLButtonElement>('.mode-switch button')
    .forEach((button) =>
      button.addEventListener(
        'click',
        () => void start(button.dataset.mode as 'hero' | 'compare'),
      ),
    );
</script>

<style>
  :global(body) {
    background: #07060c;
  }
  .lab {
    position: relative;
    height: max(850px, 100svh);
    overflow: hidden;
    background: #080711 url('/images/hero-1440.webp') center / cover;
  }
  #scene,
  .shade {
    position: absolute;
    inset: 0;
  }
  #scene {
    opacity: 0;
    transition: opacity 0.7s;
  }
  .lab.ready #scene {
    opacity: 1;
  }
  .shade {
    pointer-events: none;
    background: linear-gradient(90deg, rgb(6 5 13 / 88%), transparent 75%);
  }
  header {
    position: absolute;
    z-index: 2;
    top: 30px;
    left: 5%;
    right: 5%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 10px;
    letter-spacing: 2px;
    line-height: 1.5;
  }
  .brand img {
    object-fit: contain;
  }
  .edition,
  .home,
  footer {
    font-size: 10px;
    letter-spacing: 1.6px;
  }
  .edition {
    color: #a9a0c0;
  }
  .home {
    border-bottom: 1px solid #81798c;
    padding-bottom: 6px;
  }
  .hero-copy {
    position: absolute;
    left: 8%;
    top: 25%;
    pointer-events: none;
  }
  .eyebrow {
    font-size: 10px;
    letter-spacing: 2.5px;
    color: #c4b5e9;
  }
  .eyebrow span {
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #b893ff;
    margin-right: 10px;
    box-shadow: 0 0 14px #b893ff;
  }
  h1 {
    font-family: var(--font-heading);
    font-size: clamp(45px, 5.5vw, 94px);
    font-weight: 400;
    line-height: 1.07;
    letter-spacing: -0.045em;
    margin: 30px 0;
  }
  h1 em {
    font-style: normal;
    color: #b397e8;
  }
  .intro {
    color: #c3bdce;
    font-size: 14px;
    line-height: 1.8;
  }
  button,
  select {
    font: inherit;
    color: #eee7ff;
    cursor: pointer;
  }
  button {
    border: 1px solid #ffffff26;
    background: #ffffff08;
    border-radius: 100px;
    padding: 11px 18px;
    font-size: 12px;
  }
  button:hover {
    background: #7b4bc844;
  }
  button:focus-visible,
  a:focus-visible,
  select:focus-visible {
    outline: 2px solid #d9bcff;
    outline-offset: 5px;
  }
  button[aria-pressed='true'] {
    background: #d3b9ff;
    color: #170c2a;
  }
  .enter {
    margin-top: 25px;
    pointer-events: auto;
    background: #ede4ff;
    color: #20152f;
    border: 0;
    padding: 16px 22px;
  }
  .enter span {
    margin-left: 24px;
  }
  .lab.ready .enter {
    display: none;
  }
  #status {
    position: absolute;
    bottom: 135px;
    left: 5%;
    right: 5%;
    font-size: 11px;
    color: #c7bed6;
    pointer-events: none;
  }
  .toolbar {
    position: absolute;
    bottom: 65px;
    left: 5%;
    right: 5%;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  .mode-switch {
    display: flex;
    gap: 4px;
    padding: 4px;
    background: #0b0814d9;
    border: 1px solid #ffffff20;
    border-radius: 100px;
  }
  .mode-switch button {
    border: 0;
  }
  .model-select {
    font-size: 11px;
    color: #c7bed6;
    margin-left: auto;
  }
  select {
    background: #171021;
    border: 1px solid #ffffff26;
    padding: 10px;
    border-radius: 8px;
    margin-left: 8px;
    font-size: 12px;
  }
  .views {
    margin-left: auto;
  }
  footer {
    position: absolute;
    bottom: 23px;
    left: 5%;
    right: 5%;
    display: flex;
    justify-content: space-between;
    color: #8f859f;
    gap: 20px;
  }
  footer b {
    color: #ddc3ff;
    font-weight: 400;
  }
  .compare-copy {
    display: none;
    position: absolute;
    top: 120px;
    width: 100%;
    text-align: center;
    pointer-events: none;
  }
  .compare-copy h1 {
    font-size: clamp(28px, 4vw, 48px);
    margin: 15px 0;
  }
  .compare-copy p:last-child {
    font-size: 12px;
    color: #a9a0c0;
  }
  .model-labels {
    position: absolute;
    top: 79%;
    left: 0;
    right: 0;
    justify-content: space-around;
    text-align: center;
    pointer-events: none;
    font-size: 12px;
    letter-spacing: 2px;
  }
  .model-labels:not([hidden]) {
    display: flex;
  }
  .model-labels > span {
    width: 50%;
  }
  .model-labels small {
    display: block;
    color: #a9a0c0;
    font-size: 10px;
    letter-spacing: 0;
    margin-top: 10px;
  }
  .lab[data-mode='compare'] .hero-copy,
  .lab[data-mode='compare'] .shade {
    display: none;
  }
  .lab[data-mode='compare'] .compare-copy {
    display: block;
  }
  .notes {
    padding: 100px 8%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 25px 80px;
  }
  .notes .eyebrow {
    grid-column: 1 / -1;
  }
  .notes h2 {
    font-size: clamp(32px, 4vw, 60px);
    line-height: 1.15;
    font-weight: 400;
    margin: 0;
  }
  .notes > p:not(.eyebrow) {
    color: #a9a0c0;
    max-width: 470px;
    font-size: 14px;
    line-height: 1.9;
  }
  .notes a {
    font-size: 12px;
    color: #d4bcff;
  }
  @media (max-width: 700px) {
    .lab {
      height: max(950px, 100svh);
    }
    header {
      top: 20px;
    }
    .edition {
      display: none;
    }
    .hero-copy {
      top: 125px;
      left: 7%;
    }
    h1 {
      font-size: clamp(38px, 9vw, 58px);
      margin: 20px 0;
    }
    .intro {
      font-size: 12px;
    }
    .eyebrow {
      font-size: 8px;
      letter-spacing: 1.5px;
    }
    .shade {
      background: linear-gradient(180deg, #080611aa, transparent 65%);
    }
    .toolbar {
      bottom: 68px;
      gap: 8px;
    }
    .toolbar button {
      font-size: 11px;
      padding: 9px 12px;
    }
    .model-select,
    .views {
      margin-left: 0;
    }
    #motion {
      margin-left: auto;
    }
    #status {
      bottom: 190px;
      line-height: 1.6;
    }
    .footnote {
      max-width: 130px;
      text-align: right;
    }
    footer {
      font-size: 8px;
      letter-spacing: 1px;
    }
    .model-labels {
      left: 1%;
      right: 1%;
      top: 67%;
      font-size: 10px;
      letter-spacing: 1px;
    }
    .model-labels > span {
      width: 50%;
    }
    .model-labels small {
      font-size: 8px;
    }
    .notes {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 65px 7%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    #scene {
      transition: none;
    }
  }
</style>
