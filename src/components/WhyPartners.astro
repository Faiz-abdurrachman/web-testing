---
import { whyPartners } from '../data/partners';
---

<section class="why-partners" aria-labelledby="why-partners-title">
  <div class="why-head">
    <span class="pill">Why Data Sorcerers?</span>
    <h2 id="why-partners-title">
      <span>More Than A Network</span>
      <span>A Building Partner</span>
    </h2>
  </div>
  <ul class="why-grid">
    {whyPartners.map((card) => (
      <li class="why-card">
        <img
          class="card-glow"
          src="/images/partners/why-glow.webp"
          srcset="/images/partners/why-glow.webp 1x, /images/partners/why-glow-2x.webp 2x"
          width="792"
          height="413"
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
        />
        <div class="card-head">
          <img
            class="card-icon"
            src={card.icon}
            width="58"
            height="63"
            alt=""
            aria-hidden="true"
            loading="lazy"
            decoding="async"
          />
          <h3>{card.title}</h3>
        </div>
        <p>{card.description}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  /* Matches Figma node 1439:4937 (1440 x 656, page 1439:4787): column,
     padding 80px, align centre, gap 48px, #050507. Header 1439:4938 (fixed
     263, gap 8): pill + Bluu Next Bold 700 80/102 headline (single 181deg
     gradient across the 2-line node). Four 309.5px cards (gap 16, min-height
     185), rgba(255,255,255,.15) + 1px 135deg rim; the violet glow is the raw
     IMAGE-SVG 1439:4949 (why-glow.webp) positioned at (-59.45%, -9.73%). */
  .why-partners {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 48px;
    padding: 80px;
    box-sizing: border-box;
    background: #050507;
  }
  .why-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    /* Figma top-aligns this fixed 263px frame, not centres it. */
    justify-content: flex-start;
    width: 100%;
    height: 263px;
    gap: 8px;
    text-align: center;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px 12px;
    border-radius: 32px;
    background: rgb(255 255 255 / 15%);
    color: #fff;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 400;
    line-height: 18px;
    white-space: nowrap;
  }
  h2 {
    margin: 0;
    width: 100%;
    height: 229px;
    font-family: var(--font-display);
    font-size: 80px;
    font-weight: 700;
    line-height: 102px;
    text-align: center;
    /* One gradient across the whole 2-line text node (not per line). */
    background: linear-gradient(181deg, #ffffff 15%, #999999 42%, #ffffff 79%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  h2 span {
    display: block;
  }
  .why-grid {
    display: grid;
    grid-template-columns: repeat(4, 309.5px);
    gap: 16px;
    width: 1286px;
    max-width: none;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .why-card {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 28px;
    box-sizing: border-box;
    min-height: 185px;
    border-radius: 20px;
    background: rgb(255 255 255 / 15%);
    overflow: hidden;
  }
  /* Raw IMAGE-SVG 1439:4949: 792x413 node placed at (-184,-18) of a 309.5x185
     card (fitted), expressed as percentages so it scales with the card. */
  .card-glow {
    position: absolute;
    left: -59.45%;
    top: -9.73%;
    width: 255.9%;
    height: 223.24%;
    z-index: 0;
    pointer-events: none;
    object-fit: fill;
  }
  /* 1px 135deg gradient rim. */
  .why-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
    padding: 1px;
    pointer-events: none;
    background: linear-gradient(135deg, #ede8ff 0%, #2e276c 50%, #ede8ff 100%);
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
  }
  .card-head {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .card-head img {
    width: 58px;
    height: 63px;
    object-fit: contain;
  }
  h3 {
    margin: 0;
    color: #fff;
    font-family: var(--font-body);
    font-size: 26px;
    font-weight: 700;
    line-height: 39px;
  }
  p {
    position: relative;
    z-index: 1;
    margin: 0;
    color: #ede8ff;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
  }

  /* Four cards need ~1366px to keep the icon + title on one line; use three
     columns below that so nothing clips. */
  @media (min-width: 1051px) and (max-width: 1365px) {
    .why-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      width: 100%;
    }
  }
  @media (max-width: 1050px) {
    .why-partners {
      gap: 44px;
      padding: 64px var(--page-gutter);
    }
    .why-head {
      height: auto;
    }
    h2 {
      height: auto;
      font-size: clamp(38px, 6.5vw, 56px);
      line-height: 1.2;
    }
    .why-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: 100%;
    }
  }
  @media (max-width: 700px) {
    .why-partners {
      gap: 32px;
      padding: 48px var(--page-gutter);
    }
    h2 {
      font-size: clamp(28px, 8vw, 40px);
    }
    .why-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .why-card {
      padding: 24px;
    }
  }
</style>
