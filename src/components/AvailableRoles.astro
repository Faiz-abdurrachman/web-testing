---
import { roles } from '../data/roles';
---

<section
  id="available-roles"
  class="available-roles"
  aria-labelledby="available-roles-title"
>
  <header>
    <h2 id="available-roles-title">Available Roles</h2>
    <p>
      Find your place. Explore each role, what you will build, and the skills
      you can bring.
    </p>
  </header>
  <div class="role-list">
    {roles.map((role, index) => (
      <a class="role-row" href={`/recruitment/roles/${role.id}`}>
        <span class="role-number" aria-hidden="true">
          0{index + 1} / OPEN ROLE
        </span>
        <h3 class="role-name">{role.title}</h3>
        <p class="role-summary">{role.about.split(/(?<=\.)\s/)[0]}</p>
        <ul class="role-tags" aria-label="Areas of focus">
          {role.chips.slice(0, 3).map((chip) => (
            <li>{chip}</li>
          ))}
        </ul>
        <span class="role-link">
          View role <span aria-hidden="true">↗</span>
        </span>
      </a>
    ))}
  </div>
</section>
<style>
  .available-roles {
    scroll-margin-top: 110px;
    padding: 80px var(--page-gutter);
    background: #050507;
  }
  header,
  .role-list {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
  }
  header {
    margin-bottom: 58px;
  }
  h2 {
    margin: 0;
    font: 400 56px/68px var(--font-heading);
    color: #ede8ff;
  }
  header p {
    margin: 20px 0 0;
    font-size: 18px;
    line-height: 27px;
    color: #ede8ff;
  }
  .role-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .role-row {
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-width: 0;
    padding: 28px;
    border: 1px solid #645487;
    border-radius: 20px;
    background: linear-gradient(145deg, #211735, #100d18);
    transition:
      border-color 180ms ease,
      background-color 180ms ease;
  }
  .role-row:hover {
    border-color: #c5b4ff;
    background: #24183c;
  }
  .role-number {
    color: #bba7eb;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
  }
  .role-name {
    margin: 0;
    font: 700 23px/1.4 var(--font-body);
  }
  .role-summary {
    margin: 0;
    color: #ddd6ec;
    font-size: 16px;
    line-height: 1.65;
  }
  .role-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0;
    margin: 0 0 8px;
    list-style: none;
  }
  .role-tags li {
    padding: 5px 10px;
    border: 1px solid #625078;
    border-radius: 999px;
    color: #e6ddfa;
    font-size: 12px;
    line-height: 1.5;
  }
  .role-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    padding-top: 18px;
    border-top: 1px solid #493859;
    font-weight: 600;
    color: #e0d4ff;
  }
  .role-link span {
    font-size: 24px;
  }
  @media (max-width: 1100px) {
    .role-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .available-roles {
      padding-block: 64px;
    }
    header {
      margin-bottom: 32px;
    }
    h2 {
      font-size: clamp(30px, 8vw, 48px);
      line-height: 1.22;
    }
    .role-list {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .role-row {
      padding: 24px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .role-row {
      transition: none;
    }
  }
</style>
