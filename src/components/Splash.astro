  </div>
  <div class="splash-ground-haze" aria-hidden="true"></div>

  <div class="splash-cliffs" aria-hidden="true">
    <div class="splash-cliff splash-cliff--l">
      <svg viewBox="0 0 400 400" preserveAspectRatio="xMinYMax slice">
        <path class="back" d={cliffBack}></path>
        <path class="front" d={cliffFront}></path>
        <path class="rim" d={cliffFront}></path>
      </svg>
    </div>
    <div class="splash-cliff splash-cliff--r">
      <svg viewBox="0 0 400 400" preserveAspectRatio="xMinYMax slice">
