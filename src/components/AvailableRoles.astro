---
import { roles } from '../data/roles';
import { domains } from '../data/domains';

const domainTitle = Object.fromEntries(domains.map((d) => [d.id, d.title]));
---

<section
  id="available-roles"
  class="available-roles"
  aria-labelledby="available-roles-title"
>
  <header>
    <h2 id="available-roles-title">Available Roles</h2>
    <p>
      Find your place. Explore each role, what you will build, and the skills
      you can bring.
    </p>
  </header>
  <div class="role-list">
    {roles.map((role, index) => (
      <a class="role-row" href={`/recruitment/roles/${role.id}`}>
        <div class="role-card">
          <img
            class="sparkle sparkle-tl"
            src="/images/recruitment/card-sparkle.svg"
            alt=""
            aria-hidden="true"
            width="44"
            height="52"
            loading="lazy"
            decoding="async"
          />
          <img
            class="sparkle sparkle-tr"
            src="/images/recruitment/card-sparkle.svg"
            alt=""
            aria-hidden="true"
            width="44"
            height="52"
            loading="lazy"
            decoding="async"
          />
          <img
            class="sparkle sparkle-bl"
            src="/images/recruitment/card-sparkle.svg"
            alt=""
            aria-hidden="true"
            width="44"
            height="52"
            loading="lazy"
            decoding="async"
          />
          <img
            class="sparkle sparkle-br"
            src="/images/recruitment/card-sparkle.svg"
            alt=""
            aria-hidden="true"
            width="44"
            height="52"
            loading="lazy"
            decoding="async"
          />
          <span class="role-number" aria-hidden="true">
            0{index + 1} / OPEN ROLE
          </span>
          <h3 class="role-name">{domainTitle[role.id] ?? role.title}</h3>
          <p class="role-summary">{role.about.split(/(?<=\.)\s/)[0]}</p>
          <ul class="role-tags" aria-label="Areas of focus">
            {role.chips.slice(0, 3).map((chip) => (
              <li>{chip}</li>
            ))}
          </ul>
          <span class="role-link">
            <span class="role-link-mark" aria-hidden="true">
              ↗
            </span>
            View role
          </span>
        </div>
      </a>
    ))}
  </div>
</section>
<style>
  .available-roles {
    scroll-margin-top: 110px;
    padding: 80px var(--page-gutter);
    background: #050507;
  }
  header,
  .role-list {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
  }
  header {
    margin-bottom: 58px;
  }
  h2 {
    margin: 0;
    font: 400 56px/68px var(--font-heading);
    color: #ede8ff;
  }
  header p {
    margin: 20px 0 0;
    font-size: 18px;
    line-height: 27px;
    color: #ede8ff;
  }
  .role-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  /* Proportional card: the container drives every inner size via cqw so the
     layout tracks the 1350x795 reference at any column width. */
  .role-row {
    position: relative;
    display: block;
    align-self: start;
    aspect-ratio: 1350 / 795;
    min-width: 0;
    container-type: inline-size;
  }
  .role-card {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 3.4cqw;
    border: 1px solid rgb(255 255 255 / 7%);
    background:
      radial-gradient(
        58% 52% at 78% 28%,
        rgb(108 59 255 / 34%),
        transparent 72%
      ),
      radial-gradient(
        52% 56% at 16% 92%,
        rgb(155 123 255 / 16%),
        transparent 76%
      ),
      linear-gradient(160deg, #1c1533 0%, #130d20 100%);
  }
  /* Inset gold frame from the new card design. */
  .role-card::after {
    content: '';
    position: absolute;
    inset: 1.19cqw;
    border-radius: 2.22cqw;
    padding: max(1px, 0.3cqw);
    background: linear-gradient(
      178deg,
      #ffe6a3 0%,
      #f4cd80 26%,
      #a97a50 58%,
      #e9bd71 100%
    );
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    pointer-events: none;
  }
  .sparkle {
    position: absolute;
    width: 2.9cqw;
    height: auto;
    pointer-events: none;
  }
  .sparkle-tl {
    top: 1.5cqw;
    left: 2.1cqw;
  }
  .sparkle-tr {
    top: 1.5cqw;
    right: 2.1cqw;
  }
  .sparkle-bl {
    bottom: 1.5cqw;
    left: 2.1cqw;
  }
  .sparkle-br {
    bottom: 1.5cqw;
    right: 2.1cqw;
  }
  .role-number {
    position: absolute;
    top: 7.85cqw;
    left: 7.41cqw;
    color: #f4db98;
    font-size: 2.05cqw;
    font-weight: 600;
    letter-spacing: 0.12em;
  }
  .role-name {
    position: absolute;
    top: 14.37cqw;
    left: 7.41cqw;
    right: 7.41cqw;
    margin: 0;
    color: #ede8ff;
    font-size: 6cqw;
    font-weight: 700;
    line-height: 1;
  }
  .role-summary {
    position: absolute;
    top: 23.85cqw;
    left: 7.41cqw;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
    width: 56.2cqw;
    margin: 0;
    color: #d8d4e5;
    font-size: 2.75cqw;
    line-height: 1.45;
  }
  .role-tags {
    position: absolute;
    top: 38.52cqw;
    left: 7.41cqw;
    right: 7.41cqw;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6cqw 2.2cqw;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .role-tags li {
    color: #dccae1;
    font-size: 2.1cqw;
    line-height: 1.3;
  }
  .role-tags li::before {
    content: '(';
  }
  .role-tags li::after {
    content: ')';
  }
  .role-link {
    position: absolute;
    top: 51.04cqw;
    left: 7.41cqw;
    display: flex;
    align-items: center;
    gap: 4.7cqw;
    color: #f5d28d;
    font-size: 2.3cqw;
    font-weight: 600;
  }
  .role-link-mark {
    font-size: 2.5cqw;
  }
  .role-card:is(:hover, :focus-visible) {
    border-color: rgb(255 224 160 / 45%);
  }
  @media (max-width: 1100px) {
    .role-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .available-roles {
      padding-block: 64px;
    }
    header {
      margin-bottom: 32px;
    }
    h2 {
      font-size: clamp(30px, 8vw, 48px);
      line-height: 1.22;
    }
    .role-list {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
