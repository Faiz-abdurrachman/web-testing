---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import RecruitmentHero from '../components/RecruitmentHero.astro';
import WhoShouldJoin from '../components/WhoShouldJoin.astro';
import WhatYouWillDo from '../components/WhatYouWillDo.astro';
import AvailableRoles from '../components/AvailableRoles.astro';
import SelectionTimeline from '../components/SelectionTimeline.astro';
import Faq from '../components/Faq.astro';
import Snippets from '../components/Snippets.astro';
import Cta from '../components/Cta.astro';
---

<BaseLayout title="Recruitment — Data Sorcerers">
  <Navbar active="Recruitment" />
  <main id="main">
    <RecruitmentHero />
    <WhoShouldJoin />
    <WhatYouWillDo />
    <AvailableRoles />
    <SelectionTimeline />
    <Faq />
    <Snippets />
    <Cta />
  </main>
</BaseLayout>
