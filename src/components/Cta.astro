---
import Button from './Button.astro';
---

<section class="cta" aria-labelledby="cta-title">
  <div class="cta-panel">
    <div class="cta-copy">
      <h2 id="cta-title">READY TO BECOME A SORCERY?</h2>
      <p>
        Join a community where your learning can become experimentation, your
        ideas can become projects, and your work can create real impact.
      </p>
    </div>
    <div class="cta-actions">
      <Button variant="primary">Join the Community</Button>
    </div>
    <img
      class="cta-glow"
      src="/images/recruitment/cta-glow.webp"
      srcset="
        /images/recruitment/cta-glow.webp     1000w,
        /images/recruitment/cta-glow-2x.webp  2001w
      "
      sizes="1000px"
      width="1000"
      height="272"
      alt=""
      loading="lazy"
      decoding="async"
    />
  </div>
</section>
<style>
  .cta {
    padding: 80px;
    background: #050507;
  }
  .cta-panel {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 44px;
    padding: 73px 0 79px;
    border-radius: 20px;
    background: rgb(98 80 255 / 10%);
    overflow: hidden;
  }
  .cta-panel::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(135deg, #e0dcff 0%, #2e276c 50%, #e0dcff 100%);
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    pointer-events: none;
  }
  .cta-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    width: 100%;
    text-align: center;
  }
  h2 {
    margin: 0;
    font: 400 56px/68px var(--font-heading);
    background: linear-gradient(270deg, #fff 0%, #ede8ff 100%);
    background-clip: text;
    color: transparent;
  }
  p {
    margin: 0;
    width: 586px;
    max-width: 100%;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: -0.011em;
    color: #fff;
  }
  .cta-glow {
    position: absolute;
    left: 269.83px;
    top: 271px;
    display: block;
    width: 1000.33px;
    height: 271.5px;
    pointer-events: none;
  }
  @media (max-width: 760px) {
    .cta {
      padding: 40px 24px;
    }
    .cta-panel {
      gap: 32px;
      padding: 48px 0;
    }
    h2 {
      font-size: clamp(30px, 8vw, 48px);
      line-height: 1.214286;
    }
    .cta-glow {
      left: 50%;
      width: 1000px;
      max-width: none;
      transform: translateX(-50%);
    }
  }
</style>
