---
import type { Domain } from '../data/domains';
interface Props {
  domain: Domain;
  href?: string;
  index?: number;
}
const { domain, href = `/hods/${domain.id}`, index = 0 } = Astro.props;
const large = ['product', 'growth'].includes(domain.id);
// Deterministic ember seeds so the markup is stable (no layout-affecting random).
const embers = Array.from({ length: 7 }, (_, i) => ({
  x: 8 + ((i * 37) % 84),
  d: 6 + (i % 4) * 1.6,
  delay: (i * 0.9) % 6,
  s: 0.6 + ((i * 13) % 5) / 10,
}));
---

<a
  class:list={['domain-card', domain.id, { large }]}
  style={`--tint:${domain.tint};--di:${index}`}
  href={href}
  aria-labelledby={`domain-${domain.id}`}
>
  <h3 id={`domain-${domain.id}`}>{domain.title}</h3>
  <p>{domain.description}</p>
  <img
    class="glow"
    src={`/images/domains/${domain.id}.svg`}
    alt=""
    loading="lazy"
  />
  <svg class="sigil" viewBox="0 0 200 200" aria-hidden="true">
    <circle class="ring" cx="100" cy="100" r="98" />
    <circle class="ring dashed" cx="100" cy="100" r="82" />
    {Array.from({ length: 24 }).map((_, i) => (
      <line
        class="tick"
        x1="100"
        y1="2"
        x2="100"
        y2="12"
        transform={`rotate(${i * 15} 100 100)`}
      />
    ))}
  </svg>
  <div class="embers" aria-hidden="true">
    {embers.map((e) => (
      <span
        style={`--ex:${e.x};--ed:${e.d}s;--delay:${e.delay}s;--scale:${e.s}`}
      />
    ))}
  </div>
  <div class="cloud-frame">
    <div class="cloud">
      {!large &&
        [
          [0, 59.85],
          [-22.49, 126.57],
          [553.5, 59.85],
          [563.48, 121.92],
          ...(domain.id === 'vision' ? [] : [[402.85, 243.58]]),
        ].map(([x, y]) => (
          <span
            class="blank extra"
            aria-hidden="true"
            style={`left:${x}px;top:${y}px`}
          />
        ))}
      {domain.rows.map((row, i) => (
        <div
          class:list={['chip-row', `row-${i}`]}
          style={`left:${row.x}px;top:${row.y}px;gap:${row.gap}px`}
        >
          {row.labels.map((label) => (
            <span
              class:list={[label ? 'chip' : 'blank']}
              aria-hidden={label ? undefined : 'true'}
            >
              {label}
            </span>
          ))}
        </div>
      ))}
    </div>
  </div>
</a>
<style>
  .domain-card {
    position: relative;
    display: block;
    isolation: isolate;
    flex: 0 0 394px;
    height: 436px;
    overflow: hidden;
    border-radius: 20px 0;
    background: rgb(var(--tint) / 10%);
  }
  .domain-card::after {
    content: '';
    position: absolute;
    inset: 0;
    padding: 1px;
    border-radius: inherit;
    background: linear-gradient(
      135deg,
      #fff,
      rgb(var(--tint)) 52%,
      rgb(var(--tint)) 75%,
      #fff
    );
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    pointer-events: none;
  }
  h3 {
    position: relative;
    margin: 16px 14px 0;
    font-size: 22px;
    line-height: 33px;
    font-weight: 700;
  }
  p {
    position: relative;
    margin: 11px 14px 0;
    font-size: 16px;
    line-height: 24px;
    color: #d8d1d1;
  }
  .glow {
    position: absolute;
    z-index: -1;
    left: 65.34px;
    top: 166.18px;
    width: 1298.94px;
    height: 456.375px;
    max-width: none;
    pointer-events: none;
  }
  /* --- Magic layers (Phase 1) ------------------------------------------
     Hidden by default so the reduced-motion render stays pixel-identical to
     the reference frame; they only light up under `no-preference`. */
  .sigil {
    position: absolute;
    left: 50%;
    top: 250px;
    z-index: -1;
    width: 340px;
    height: 340px;
    margin: -170px 0 0 -170px;
    fill: none;
    stroke: rgb(var(--tint));
    opacity: 0;
    pointer-events: none;
  }
  .sigil .ring,
  .sigil .tick {
    stroke-width: 0.75;
  }
  .sigil .dashed {
    stroke-dasharray: 2 7;
  }
  .embers {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }
  .embers span {
    position: absolute;
    bottom: -8px;
    left: calc(var(--ex) * 1%);
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: rgb(var(--tint));
    box-shadow: 0 0 6px rgb(var(--tint));
    opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .sigil {
      opacity: 0.4;
      animation: sigil-spin 60s linear infinite;
      animation-delay: calc(var(--di) * -4s);
    }
    .embers span {
      opacity: 0.7;
      animation: ember-rise var(--ed) linear var(--delay) infinite;
    }
    .glow {
      animation: glow-breathe 7s ease-in-out infinite;
      animation-delay: calc(var(--di) * -1.1s);
    }
    .cloud {
      animation: cloud-float 7.5s ease-in-out infinite;
      animation-delay: calc(var(--di) * -1.3s);
    }
  }
  @keyframes sigil-spin {
    from {
      rotate: 0deg;
    }
    to {
      rotate: 360deg;
    }
  }
  @keyframes ember-rise {
    0% {
      transform: translateY(0) scale(var(--scale));
      opacity: 0;
    }
    15% {
      opacity: 0.7;
    }
    100% {
      transform: translateY(-460px) scale(var(--scale));
      opacity: 0;
    }
  }
  @keyframes glow-breathe {
    0%,
    100% {
      opacity: 0.82;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.03);
    }
  }
  @keyframes cloud-float {
    0%,
    100% {
      translate: 0 -6px;
    }
    50% {
      translate: 0 6px;
    }
  }
  /* Park every ambient animation while the section is off-screen. */
  :global(.domains.is-idle) .sigil,
  :global(.domains.is-idle) .embers span,
  :global(.domains.is-idle) .glow,
  :global(.domains.is-idle) .cloud {
    animation-play-state: paused;
  }
  .cloud-frame {
    position: absolute;
    left: -169px;
    top: 131px;
    width: 750.85px;
    height: 381.861px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .cloud {
    position: relative;
    flex: none;
    width: 718.644px;
    height: 287.647px;
    transform: rotate(-7.74deg);
  }
  .chip-row {
    position: absolute;
    display: flex;
    align-items: center;
    white-space: nowrap;
  }
  .chip {
    flex: none;
    padding: 6.789px 20.367px;
    border-radius: 54.312px;
    background: rgb(255 255 255 / 15%);
    box-shadow:
      inset 0 1px 1px rgb(255 255 255 / 70%),
      inset 0 -1px 1px rgb(255 255 255 / 40%);
    font-size: 20.367px;
    line-height: 30.551px;
  }
  .blank {
    display: block;
    flex: none;
    width: 155.17px;
    height: 44.334px;
    border: 0.554px solid rgb(255 255 255 / 5%);
    border-radius: 54.312px;
    background: rgb(255 255 255 / 5%);
  }
  .extra {
    position: absolute;
  }
  .row-0 .blank:first-child {
    height: 38.841px;
  }
  .row-2 .blank {
    width: 168.153px;
    height: 44.578px;
    background: rgb(255 255 255 / 15%);
  }
  .language .row-2 .chip:last-child {
    box-shadow: none;
  }
  .vision .cloud-frame {
    width: 740.188px;
    height: 303.46px;
  }
  .vision .cloud {
    height: 208.523px;
  }
  .large h3 {
    margin-left: 21px;
  }
  .large p {
    margin-left: 21px;
    margin-right: 18px;
  }
  .large .cloud-frame {
    left: -180.63px;
    top: 167.91px;
    width: 758.281px;
    height: 276.416px;
  }
  .large .cloud {
    width: 741.027px;
    height: 178.24px;
  }
  .large .chip {
    font-size: 21.945px;
    line-height: 32.918px;
    padding: 7.315px 21.945px;
    border-radius: 58.521px;
  }
  .large .blank,
  .large .row-0 .blank:first-child,
  .large .row-2 .blank {
    width: 167.193px;
    height: 47.769px;
    background: rgb(255 255 255 / 5%);
  }
  .product .glow {
    left: -374.58px;
    width: 1279.97px;
    height: 453.37px;
  }
  .growth h3 {
    margin-top: 14px;
  }
  .growth p {
    margin: 8px 16px 0 25px;
  }
  .growth .cloud-frame {
    top: 168.16px;
    width: 754.543px;
    height: 275.618px;
  }
  .growth .cloud {
    width: 737.296px;
    height: 177.941px;
  }
  .growth .glow {
    left: -766.66px;
    top: 170.18px;
    width: 1256.04px;
    height: 439.876px;
  }
  @media (max-width: 600px) {
    .domain-card {
      flex-basis: calc(100vw - 48px);
      max-width: 394px;
    }
    .large .cloud-frame {
      transform-origin: 180.63px 268.09px;
    }
    h3 {
      font-size: 20px;
    }
    .cloud-frame {
      top: 150px;
      transform: scale(min(1, calc((100vw - 48px) / 394px)));
      transform-origin: 169px 286px;
    }
  }
</style>
