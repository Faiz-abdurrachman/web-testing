---
import Button from './Button.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="artwork" aria-hidden="true">
    <div class="artwork-entrance">
      <div class="artwork-stack">
        <img
          class="art-bg"
          src="/images/hero/background.webp"
          width="1583"
          height="993"
          alt=""
          fetchpriority="high"
          decoding="async"
        />
        <img
          class="art-figure"
          src="/images/hero/figure.webp"
          width="1583"
          height="993"
          alt=""
          decoding="async"
        />
        <video
          class="art-video"
          muted
          loop
          playsinline
          preload="none"
          poster="/images/hero/background.webp"
        >
          <source src="/images/hero/hero-bg.webm" type="video/webm" />
          <source src="/images/hero/hero-bg.mp4" type="video/mp4" />
        </video>
      </div>
    </div>
  </div>
  <canvas class="hero-canvas" aria-hidden="true"></canvas>
  <div class="hero-veil" aria-hidden="true"></div>
  <div class="hero-sweep" aria-hidden="true"></div>
  <div class="hero-flare" aria-hidden="true"></div>
  <div class="hero-content">
    <div class="copy">
      <h1 id="hero-title">
        <span>SORCERY IN DATA</span>
        <span>MAGIC IN AI</span>
      </h1>
      <p>
        An AI &amp; Data Innovation Community where people learn, experiment,
        research, and build meaningful technology together.
      </p>
    </div>
    <div class="actions" aria-label="Community actions">
      <Button>Join the Community</Button>
      <Button variant="glass">Explore Our Project</Button>
    </div>
  </div>
</section>
<script>
  // Three.js particle field over the hero art. Dynamically imported so it stays
  // out of the initial bundle, and skipped entirely under reduced motion. The
  // scroll sequence in `motion.ts` drives `window.__heroParticles.burst` so the
  // field rushes toward the viewer as the hero zooms in.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Animated background. Only fetched on larger, motion-OK viewports; under
  // reduced motion (or ≤600px) the static art stays and the clip is never
  // downloaded, so the fallback is always the reference art. It plays on a
  // continuous loop (the clip is a seamless ping-pong boomerang), and is never
  // scrubbed by scroll, so it keeps moving whether or not the visitor scrolls.
  const video = document.querySelector<HTMLVideoElement>('.art-video');
  if (video) {
    const wide = window.matchMedia('(min-width: 601px)').matches;
    if (!reduce && wide) {
      const start = () => {
        video.classList.add('is-ready');
        void video.play().catch(() => {});
      };
      if (video.readyState >= 2) start();
      else video.addEventListener('loadeddata', start, { once: true });
      video.preload = 'auto';
      video.load();
    }
  }

  const canvas = document.querySelector<HTMLCanvasElement>('.hero-canvas');
  const host = canvas?.parentElement;

  if (canvas && host && !reduce) {
    const THREE = await import('three');
    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.75));

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(60, 1, 0.1, 100);
    camera.position.z = 9;

    const count = 700;
    const positions = new Float32Array(count * 3);
    const colors = new Float32Array(count * 3);
    const speeds = new Float32Array(count);
    const palette = [
      new THREE.Color(0x9b7bff),
      new THREE.Color(0xd9c7ff),
      new THREE.Color(0xffffff),
      new THREE.Color(0x6c3bff),
    ];
    for (let i = 0; i < count; i++) {
      positions[i * 3] = (Math.random() - 0.5) * 20;
      positions[i * 3 + 1] = (Math.random() - 0.5) * 11;
      positions[i * 3 + 2] = (Math.random() - 0.5) * 8;
      speeds[i] = 0.002 + Math.random() * 0.008;
      const color = palette[i % palette.length];
      colors[i * 3] = color.r;
      colors[i * 3 + 1] = color.g;
      colors[i * 3 + 2] = color.b;
    }
    const geometry = new THREE.BufferGeometry();
    geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));

    // A soft radial sprite so points read as glowing motes, not squares.
    const sprite = (() => {
      const size = 64;
      const el = document.createElement('canvas');
      el.width = el.height = size;
      const ctx = el.getContext('2d');
      if (!ctx) return null;
      const grad = ctx.createRadialGradient(
        size / 2,
        size / 2,
        0,
        size / 2,
        size / 2,
        size / 2,
      );
      grad.addColorStop(0, 'rgba(255,255,255,1)');
      grad.addColorStop(0.35, 'rgba(206,186,255,0.65)');
      grad.addColorStop(1, 'rgba(120,80,255,0)');
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, size, size);
      return new THREE.CanvasTexture(el);
    })();

    const material = new THREE.PointsMaterial({
      size: 0.14,
      map: sprite,
      vertexColors: true,
      transparent: true,
      opacity: 0.85,
      depthWrite: false,
      blending: THREE.AdditiveBlending,
    });
    const points = new THREE.Points(geometry, material);
    scene.add(points);

    const state = { burst: 0 };
    (
      window as unknown as { __heroParticles?: { burst: number } }
    ).__heroParticles = state;

    const resize = () => {
      const width = host.clientWidth;
      const height = host.clientHeight;
      renderer.setSize(width, height, false);
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
    };
    resize();
    window.addEventListener('resize', resize);

    let pointerX = 0;
    let pointerY = 0;
    window.addEventListener('mousemove', (event) => {
      pointerX = event.clientX / window.innerWidth - 0.5;
      pointerY = event.clientY / window.innerHeight - 0.5;
    });

    let visible = true;
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
    }).observe(host);

    const tick = () => {
      requestAnimationFrame(tick);
      if (!visible) return;
      const t = performance.now() / 1000;
      const boost = 1 + state.burst * 7;
      const attr = geometry.attributes.position;
      for (let i = 0; i < count; i++) {
        const y = attr.getY(i) + speeds[i] * boost;
        attr.setY(i, y > 5.5 ? -5.5 : y);
      }
      attr.needsUpdate = true;
      points.rotation.y =
        Math.sin(t * 0.1) * 0.12 + pointerX * 0.25 + state.burst * 1.1;
      points.rotation.x = pointerY * 0.18;
      material.size = 0.14 + state.burst * 0.16;
      material.opacity = 0.85 - state.burst * 0.15;
      camera.position.z = 9 - state.burst * 4.5;
      renderer.render(scene, camera);
    };
    tick();
  }
</script>
<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: min(903px, 100svh);
    padding: 140px var(--page-gutter) 64px;
    overflow: clip;
  }
  .artwork {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .artwork-entrance,
  .artwork-stack {
    position: absolute;
    inset: 0;
  }
  .artwork :is(img, video) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .art-video {
    opacity: 0;
    transition: opacity 700ms ease;
  }
  .art-video.is-ready {
    opacity: 1;
  }
  .hero-content {
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 7svh, 96px);
    max-width: 1280px;
    margin-inline: auto;
    width: 100%;
  }
  .copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  h1 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 80px;
    font-weight: 400;
    line-height: 98px;
    background: linear-gradient(
      267.1deg,
      #fff 5.29%,
      #dfdfdf 46.05%,
      #dfdfdf 99.19%
    );
    background-clip: text;
    color: transparent;
  }
  h1 span {
    display: block;
  }
  p {
    margin: 0;
    max-width: 619px;
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    letter-spacing: -0.176px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    align-items: center;
  }
  .hero-veil,
  .hero-sweep {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hero-veil {
    z-index: 2;
    background: var(--color-background);
    opacity: 0;
  }
  .hero-sweep {
    z-index: 2;
    overflow: hidden;
  }
  .hero-sweep::before {
    content: '';
    position: absolute;
    top: -30%;
    bottom: -30%;
    left: 0;
    width: 38%;
    background: linear-gradient(
      90deg,
      transparent,
      rgb(216 209 240 / 12%),
      transparent
    );
    opacity: 0;
    transform: translate3d(-120%, 0, 0) skewX(-16deg);
  }
  .hero-flare {
    position: absolute;
    top: -40%;
    bottom: -40%;
    left: 0;
    z-index: 2;
    width: 26%;
    pointer-events: none;
    opacity: 0;
    background: linear-gradient(
      90deg,
      transparent,
      rgb(232 224 255 / 42%),
      transparent
    );
    transform: translate3d(-160%, 0, 0) skewX(-14deg);
  }
  .hero-canvas {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .hero-content {
    position: relative;
    z-index: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .artwork-entrance {
      animation: hero-art 1.6s cubic-bezier(0.22, 0.61, 0.36, 1) both;
    }
    .hero-veil {
      animation: hero-veil 1.1s ease-out both;
    }
    .hero-sweep::before {
      animation: hero-sweep 2.4s cubic-bezier(0.22, 0.61, 0.36, 1) 0.4s both;
    }
    h1 span {
      animation: hero-line 0.95s cubic-bezier(0.22, 0.61, 0.36, 1) both;
    }
    h1 span:nth-child(1) {
      animation-delay: 0.45s;
    }
    h1 span:nth-child(2) {
      animation-delay: 0.6s;
    }
    .copy p {
      animation: hero-up 0.9s cubic-bezier(0.22, 0.61, 0.36, 1) 0.78s both;
    }
    .actions {
      animation: hero-up 0.9s cubic-bezier(0.22, 0.61, 0.36, 1) 0.95s both;
    }
  }
  @keyframes hero-art {
    from {
      filter: blur(10px) brightness(0.72);
      transform: scale(1.1);
    }
    to {
      filter: blur(0) brightness(1);
      transform: scale(1);
    }
  }
  @keyframes hero-veil {
    from {
      opacity: 0.92;
    }
    to {
      opacity: 0;
    }
  }
  @keyframes hero-sweep {
    0% {
      opacity: 0;
      transform: translate3d(-120%, 0, 0) skewX(-16deg);
    }
    15% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translate3d(280%, 0, 0) skewX(-16deg);
    }
  }
  @keyframes hero-line {
    from {
      opacity: 0;
      transform: translateY(38px);
      filter: blur(10px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: blur(0);
    }
  }
  @keyframes hero-up {
    from {
      opacity: 0;
      transform: translateY(22px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (min-width: 1921px) {
    .artwork {
      left: 50%;
      right: auto;
      width: 1920px;
      transform: translateX(-50%);
      mask-image: linear-gradient(
        90deg,
        transparent,
        #000 12%,
        #000 88%,
        transparent
      );
    }
    .artwork :is(img, video) {
      object-position: center bottom;
    }
  }
  @media (max-width: 1100px) {
    h1 {
      font-size: clamp(42px, 6.5vw, 72px);
      line-height: 1.225;
    }
    .hero {
      min-height: min(820px, 100svh);
    }
  }
  @media (max-width: 600px) {
    .hero {
      min-height: 100vh;
      min-height: 100svh;
      padding-top: clamp(96px, 12svh, 120px);
      padding-bottom: clamp(64px, 9svh, 96px);
      align-items: center;
    }
    .artwork :is(img, video) {
      object-position: 61% center;
    }
    .artwork::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(
        180deg,
        rgb(5 5 7 / 25%),
        rgb(5 5 7 / 15%) 45%,
        transparent 70%
      );
    }
    .hero-content {
      gap: clamp(28px, 7vw, 48px);
    }
    .copy {
      gap: clamp(16px, 4.5vw, 24px);
    }
    h1 {
      font-size: clamp(28px, 7vw, 42px);
      line-height: 1.2;
    }
    p {
      max-width: 380px;
      font-size: clamp(15px, 3.9vw, 16px);
      line-height: 1.5;
    }
    .actions {
      gap: clamp(12px, 3.5vw, 20px);
    }
  }
  @media (max-width: 480px) {
    .actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
