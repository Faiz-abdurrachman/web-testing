---
import { projects } from '../data/projects';

const slides = projects.slice(0, 3);
// Render two copies of the ring so the wrap always happens between off-window
// slots. With a single copy (3 cards) the wrapping card slides visibly across
// the centre; with six, every visible card moves exactly one slot per step.
const deck = [...slides, ...slides];
const DECK = deck.length;
const slotOf = (index: number, active = 0) => {
  let slot = index - active;
  if (slot > DECK / 2) slot -= DECK;
  else if (slot < -DECK / 2) slot += DECK;
  return slot;
};
const slotClass = (slot: number) =>
  slot === 0
    ? 'is-center'
    : slot === -1
      ? 'is-left'
      : slot === 1
        ? 'is-right'
        : slot < 0
          ? 'is-far-left'
          : 'is-far-right';
---

<section class="hof-projects" aria-labelledby="hof-projects-title">
  <div class="projects-inner">
    <div class="projects-header">
      <div class="projects-head-top">
        <span class="projects-pill">Project Highlight</span>
        <h2 id="hof-projects-title">See What Our Sorcerers Create</h2>
      </div>
      <p>
        Discover ideas brought to life through curiosity, collaboration, and
        experimentation, from meaningful research to impactful digital products.
      </p>
    </div>
    <div
      class="projects-stage"
      tabindex="0"
      role="group"
      aria-roledescription="carousel"
      aria-label="Projects — use the arrow keys to browse"
    >
      <img
        class="projects-glow"
        src="/images/hof/projects/glow.webp"
        width="1200"
        height="487"
        alt=""
        aria-hidden="true"
        loading="lazy"
        decoding="async"
      />
      {deck.map((project, index) => {
        const slot = slotOf(index);
        return (
          <article
            class:list={[
              'hof-project-card',
              slotClass(slot),
              { 'is-active': slot === 0 },
            ]}
            data-index={index}
            aria-hidden={slot === 0 ? undefined : 'true'}
            aria-labelledby={`hof-project-${index}`}
          >
            <div class="hof-project-inner">
              <img
                class="project-shot"
                src="/images/hof/projects/shot.webp"
                srcset="/images/hof/projects/shot.webp 1x, /images/hof/projects/shot-2x.webp 2x"
                width="933"
                height="573"
                alt=""
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
              <span class="project-tint" aria-hidden="true" />
              <span class="project-bar" aria-hidden="true" />
              <div class="project-pills">
                {project.tags.map((tag) => (
                  <span>{tag}</span>
                ))}
              </div>
              <h3 id={`hof-project-${index}`}>{project.title}</h3>
              <p>{project.description}</p>
            </div>
          </article>
        );
      })}
      <button
        class="project-arrow prev"
        type="button"
        aria-label="Previous project"
        data-dir="-1"
        data-sfx="select"
        data-sfx-hover="hover"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M15 5l-7 7 7 7"></path>
        </svg>
      </button>
      <button
        class="project-arrow next"
        type="button"
        aria-label="Next project"
        data-dir="1"
        data-sfx="select"
        data-sfx-hover="hover"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M9 5l7 7-7 7"></path>
        </svg>
      </button>
    </div>
  </div>
  <div class="projects-dots" role="tablist" aria-label="Select project">
    {slides.map((project, index) => (
      <button
        class="dot"
        type="button"
        role="tab"
        aria-label={project.title}
        aria-selected={index === 0}
        data-index={index}
        data-sfx="click"
        data-sfx-hover="hover"
      />
    ))}
  </div>
</section>

<script>
  let projectsController: AbortController | undefined;
  const keyCue = () =>
    window.dispatchEvent(
      new CustomEvent('ds:sfx', { detail: { cue: 'select' } }),
    );

  const initHofProjects = () => {
    projectsController?.abort();
    const ac = new AbortController();
    projectsController = ac;
    const { signal } = ac;

    document
      .querySelectorAll<HTMLElement>('.hof-projects')
      .forEach((section) => {
        const stage = section.querySelector<HTMLElement>('.projects-stage');
        if (!stage) return;
        const cards = [
          ...stage.querySelectorAll<HTMLElement>('.hof-project-card'),
        ];
        const arrows = [
          ...stage.querySelectorAll<HTMLButtonElement>('.project-arrow'),
        ];
        const dots = [
          ...section.querySelectorAll<HTMLButtonElement>('.projects-dots .dot'),
        ];
        if (!cards.length) return;
        const count = cards.length;
        let active = 0;

        const slotOf = (index: number) => {
          let slot = index - active;
          if (slot > count / 2) slot -= count;
          else if (slot < -count / 2) slot += count;
          return slot;
        };

        const slotClass = (slot: number) =>
          slot === 0
            ? 'is-center'
            : slot === -1
              ? 'is-left'
              : slot === 1
                ? 'is-right'
                : slot < 0
                  ? 'is-far-left'
                  : 'is-far-right';
        const slots = [
          'is-center',
          'is-left',
          'is-right',
          'is-far-left',
          'is-far-right',
        ];
        const slideCount = dots.length || 1;
        const render = () => {
          cards.forEach((card, index) => {
            const slot = slotOf(index);
            card.classList.remove(...slots);
            card.classList.add(slotClass(slot));
            card.classList.toggle('is-active', slot === 0);
            card.setAttribute('aria-hidden', slot === 0 ? 'false' : 'true');
          });
          dots.forEach((dot, index) =>
            dot.setAttribute(
              'aria-selected',
              String(index === active % slideCount),
            ),
          );
        };

        const go = (delta: number) => {
          active = (active + delta + count) % count;
          render();
        };

        arrows.forEach((arrow) =>
          arrow.addEventListener(
            'click',
            () => {
              keyCue();
              go(Number(arrow.dataset.dir));
            },
            { signal },
          ),
        );
        dots.forEach((dot, index) =>
          dot.addEventListener(
            'click',
            () => {
              active = index;
              render();
            },
            { signal },
          ),
        );
        stage.addEventListener(
          'keydown',
          (event) => {
            if (event.key === 'ArrowLeft') {
              event.preventDefault();
              keyCue();
              go(-1);
            } else if (event.key === 'ArrowRight') {
              event.preventDefault();
              keyCue();
              go(1);
            }
          },
          { signal },
        );
        addEventListener(
          'keydown',
          (event) => {
            if (event.defaultPrevented) return;
            const target = event.target as HTMLElement | null;
            if (
              target?.closest(
                'input, textarea, select, [contenteditable="true"]',
              )
            )
              return;
            const rect = section.getBoundingClientRect();
            const center = innerHeight / 2;
            if (rect.top > center || rect.bottom < center) return;
            if (event.key === 'ArrowLeft') {
              event.preventDefault();
              keyCue();
              go(-1);
            } else if (event.key === 'ArrowRight') {
              event.preventDefault();
              keyCue();
              go(1);
            }
          },
          { signal },
        );
        let startX: number | null = null;
        stage.addEventListener('pointerdown', (event) => {
          startX = event.clientX;
        });
        stage.addEventListener('pointerup', (event) => {
          if (startX === null) return;
          const delta = event.clientX - startX;
          startX = null;
          if (Math.abs(delta) > 40) go(delta < 0 ? 1 : -1);
        });
        stage.addEventListener('pointercancel', () => {
          startX = null;
        });
        const io = new IntersectionObserver(
          ([entry]) =>
            section.classList.toggle('is-idle', !entry.isIntersecting),
          { rootMargin: '120px' },
        );
        io.observe(section);
        signal.addEventListener('abort', () => io.disconnect());
        render();
      });
  };

  document.addEventListener('astro:page-load', initHofProjects);
</script>

<style>
  /* Matches Figma node 1439:4655 (1440 × 1181): padding 80, header (803 wide,
     gap 24) + gap 80, stage 1280 × 730 (three browser-window cards: centre
     933 × 730 on top, sides 800 × 625.94), then the dots (gap 19).
     The stage is a `inline-size` container so the whole composition scales
     proportionally (1cqw = 12.8px at the 1280 reference). The stage also
     doubles as a 3D coverflow: each card's slot is a class + transform, so
     navigation animates smoothly (blur/rotation only under no-preference). */
  .hof-projects {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 19px;
    padding: 80px;
    background: #050507;
    overflow: clip;
  }

  .projects-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 80px;
    width: 100%;
  }

  .projects-header {
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 803px;
    max-width: 100%;
    text-align: center;
  }

  .projects-head-top {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .projects-pill {
    display: inline-flex;
    align-items: center;
    padding: 4px 12px;
    border-radius: 32px;
    background: rgb(255 255 255 / 15%);
    color: #fff;
    font-size: 12px;
    font-weight: 400;
    line-height: 18px;
  }

  .projects-header h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 56px;
    font-weight: 700;
    line-height: 67px;
    background: linear-gradient(181deg, #fff 15%, #999 42%, #fff 79%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .projects-header p {
    margin: 0;
    color: #fff;
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 500;
    line-height: 27px;
  }

  .projects-stage {
    position: relative;
    container-type: inline-size;
    width: 100%;
    max-width: 1280px;
    aspect-ratio: 1280 / 730;
  }

  .projects-glow {
    position: absolute;
    left: -18.63cqw;
    top: 1.016cqw;
    width: 137.27cqw;
    height: 55.74cqw;
    pointer-events: none;
  }

  .hof-project-card {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 72.891cqw;
    aspect-ratio: 933 / 730;
    container-type: inline-size;
    transform: translate(-50%, -50%) translate3d(0, 0, 0) rotateY(0deg) scale(1);
    transform-origin: center;
    backface-visibility: hidden;
    box-shadow:
      0.201cqw 0.134cqw 0.536cqw rgb(0 0 0 / 10%),
      0.871cqw 0.469cqw 1.005cqw rgb(0 0 0 / 9%),
      1.875cqw 1.139cqw 1.34cqw rgb(0 0 0 / 5%),
      3.35cqw 1.943cqw 1.541cqw rgb(0 0 0 / 1%);
  }
  .hof-project-card.is-left {
    transform: translate(-50%, -50%) translate3d(-18.75cqw, 0.625cqw, 0)
      rotateY(0deg) scale(0.85746);
    z-index: 1;
  }
  .hof-project-card.is-right {
    transform: translate(-50%, -50%) translate3d(18.75cqw, 1.17cqw, 0)
      rotateY(0deg) scale(0.85746);
    z-index: 1;
  }
  /* Cards parked outside the visible window (slot |n| ≥ 2). They stay in the
     DOM so stepping one slot animates (fade + slide) instead of popping. */
  .hof-project-card.is-far-left,
  .hof-project-card.is-far-right {
    opacity: 0;
    pointer-events: none;
  }
  .hof-project-card.is-center {
    /* Figma's centre card sits 0.5px right of the geometric centre (x174 at 1280). */
    transform: translate(-50%, -50%) translate3d(0.039cqw, 0, 0) rotateY(0deg)
      scale(1);
    z-index: 2;
  }
  /* Clip on an untransformed inner wrapper so the rounded corners stay round
     while the card itself is 3D-transformed (see pixel-precision SOP gotcha). */
  .hof-project-inner {
    position: absolute;
    inset: 0;
    border-radius: 1.929cqw;
    overflow: hidden;
    clip-path: inset(0 round 1.929cqw);
    background: #0e0626;
  }
  /* Gradient rim as an overlay so the shot fills the full 933px card (a real
     border would shrink the content box and shift the browser mockup). */
  .hof-project-inner::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 5;
    border-radius: inherit;
    padding: 0.214cqw;
    background: linear-gradient(
      136deg,
      #fff 0%,
      #707070 33%,
      #6c3bff 49%,
      #707070 66%,
      #fff 91%
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    pointer-events: none;
  }

  .project-shot {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    width: 100%;
    height: 61.41cqw;
    object-fit: cover;
    object-position: top center;
  }

  /* Figma's image fill stacks a 20% black over the screenshot
     (`[rgba(0,0,0,0.2), IMAGE]`), so the mockup reads greyer than the raw. */
  .project-tint {
    position: absolute;
    inset: 0 0 auto;
    height: 61.41cqw;
    background: rgb(0 0 0 / 20%);
    pointer-events: none;
  }

  .project-bar {
    position: absolute;
    inset: 59.16cqw 0 auto;
    height: 19.94cqw;
    background: #0e0626;
  }

  .project-pills {
    position: absolute;
    top: 54.88cqw;
    left: 3.537cqw;
    display: flex;
    gap: 1.5cqw;
  }
  .project-pills span {
    padding: 0.429cqw 1.286cqw;
    border-radius: 3.43cqw;
    background: #6c3bff;
    color: #fff;
    font-size: 1.286cqw;
    font-weight: 400;
    line-height: 1.929cqw;
    white-space: nowrap;
  }

  .hof-project-card h3 {
    position: absolute;
    top: 61.41cqw;
    left: 3.537cqw;
    margin: 0;
    color: #fff;
    font-family: var(--font-body);
    font-size: 2.787cqw;
    font-weight: 700;
    line-height: 4.18cqw;
  }

  .hof-project-card p {
    position: absolute;
    top: 67.09cqw;
    left: 3.537cqw;
    width: 84.46cqw;
    margin: 0;
    color: #fff;
    font-family: var(--font-body);
    font-size: 1.715cqw;
    font-weight: 400;
    line-height: 2.572cqw;
  }

  .project-arrow {
    position: absolute;
    top: 50%;
    z-index: 6;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    transform: translateY(-50%);
    border: 1px solid rgb(203 197 255 / 60%);
    border-radius: 50%;
    background: rgb(16 9 35 / 85%);
    backdrop-filter: blur(6px);
    cursor: pointer;
  }
  .project-arrow svg {
    width: 26px;
    height: 26px;
    fill: none;
    stroke: #fff;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .project-arrow.prev {
    left: 0;
  }
  .project-arrow.next {
    right: 0;
  }

  .projects-dots {
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .projects-dots .dot {
    width: 13px;
    height: 13px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #707070;
    cursor: pointer;
  }
  .projects-dots .dot[aria-selected='true'] {
    background: linear-gradient(153deg, #6c3bff 0%, #9483c6 100%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .projects-stage {
      perspective: 1600px;
    }
    .hof-project-card {
      transition:
        transform 0.7s cubic-bezier(0.16, 1, 0.3, 1),
        filter 0.45s ease,
        opacity 0.45s ease;
      will-change: transform, filter;
    }
    .hof-project-card.is-left {
      transform: translate(-50%, -50%) translate3d(-18.75cqw, 0.625cqw, -40px)
        rotateY(10deg) scale(0.85746);
      filter: blur(6px) brightness(0.72);
    }
    .hof-project-card.is-right {
      transform: translate(-50%, -50%) translate3d(18.75cqw, 1.17cqw, -40px)
        rotateY(-10deg) scale(0.85746);
      filter: blur(6px) brightness(0.72);
    }
    .hof-project-card.is-far-left {
      transform: translate(-50%, -50%) translate3d(-18.75cqw, 0.625cqw, -80px)
        rotateY(16deg) scale(0.72);
      filter: blur(8px) brightness(0.6);
    }
    .hof-project-card.is-far-right {
      transform: translate(-50%, -50%) translate3d(18.75cqw, 1.17cqw, -80px)
        rotateY(-16deg) scale(0.72);
      filter: blur(8px) brightness(0.6);
    }
    .projects-glow {
      animation: hof-glow 7s ease-in-out infinite alternate;
    }
    .hof-projects.is-idle .projects-glow {
      animation-play-state: paused;
    }
  }

  @keyframes hof-glow {
    from {
      opacity: 0.7;
      transform: scale(1) translateX(0);
    }
    to {
      opacity: 1;
      transform: scale(1.04) translateX(0.5%);
    }
  }

  @media (max-width: 1050px) {
    .project-arrow {
      top: auto;
      bottom: -66px;
      transform: none;
    }
  }

  @media (max-width: 900px) {
    .hof-project-card,
    .hof-project-card.is-center,
    .hof-project-card.is-left,
    .hof-project-card.is-right {
      position: relative;
      top: auto;
      left: auto;
      width: min(100%, 560px);
      transform: none;
      margin-inline: auto;
    }
    .hof-project-card:not(.is-center) {
      display: none;
    }
    .projects-stage {
      aspect-ratio: auto;
    }
  }

  @media (max-width: 560px) {
    .hof-projects {
      padding: 56px var(--page-gutter);
    }
    .projects-header p {
      font-size: 16px;
      line-height: 24px;
    }
    .project-arrow {
      width: 40px;
      height: 40px;
      bottom: -56px;
    }
    .project-arrow svg {
      width: 20px;
      height: 20px;
    }
  }
</style>
