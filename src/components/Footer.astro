---
const navigation = [
  'Home',
  'About Us',
  'Recruitment',
  'Hall of Frames',
  'Partners',
  'Contact',
];
const legal = ['Terms', 'Privacy', 'Cookies'];
---

<footer class="footer">
  <picture class="backdrop">
    <img
      src="/images/backgrounds/footer.webp"
      width="1440"
      height="556"
      alt=""
      loading="lazy"
      decoding="async"
    />
  </picture>
  <div class="top">
    <div class="brand">
      <div class="brand-copy">
        <div class="brand-lockup">
          <div class="brand-name">
            <span>DATA</span>
            <span>SORCERERS</span>
          </div>
          <p class="brand-tagline">Sorcery In Data, Magic In AI</p>
        </div>
        <p class="brand-desc">
          United by curiosity, driven by
          <br />
          technology, enchanted by
          <br />
          collaboration.
        </p>
      </div>
      <div class="socials">
        <span class="social" title="Instagram">
          <img
            src="/images/footer/instagram.svg"
            width="24"
            height="24"
            alt="Instagram"
          />
        </span>
        <span class="social" title="LinkedIn">
          <img
            src="/images/footer/linkedin.svg"
            width="24"
            height="24"
            alt="LinkedIn"
          />
        </span>
      </div>
    </div>
    <nav class="footer-nav" aria-label="Footer navigation">
      <h2>Navigation</h2>
      <ul>
        {navigation.map((label, index) => (
          <li>
            {index === 0 ? (
              <a href="/">{label}</a>
            ) : (
              <span aria-disabled="true">{label}</span>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <div class="footer-contact">
      <h2>Contact</h2>
      <ul>
        <li>Contact Person: +62 8572 -7246-733</li>
        <li>Email: datasorcerers@gmail.com</li>
      </ul>
    </div>
  </div>
  <div class="bottom">
    <hr class="divider" />
    <div class="legal">
      <p>© DATA SORCERERS 2026. All right reserved</p>
      <div class="legal-links">
        {legal.map((label) => (
          <span aria-disabled="true">{label}</span>
        ))}
      </div>
    </div>
  </div>
</footer>
<style>
  .footer {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 60px;
    min-height: 556px;
    padding: 80px var(--page-gutter) 28px;
    overflow: clip;
  }
  .backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .backdrop img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .brand {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .brand-copy {
    display: flex;
    flex-direction: column;
    gap: 26px;
  }
  .brand-lockup {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 206px;
  }
  .brand-name {
    font-family: var(--font-heading);
    font-size: 32px;
    font-weight: 400;
    line-height: 1.225;
    background: linear-gradient(270deg, #fff 0%, #ede8ff 100%);
    background-clip: text;
    color: transparent;
  }
  .brand-name span {
    display: block;
  }
  .brand-tagline {
    margin: 0;
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    letter-spacing: -0.176px;
    color: #fff;
  }
  .brand-desc {
    margin: 0;
    font-size: 17.5px;
    font-weight: 400;
    line-height: 28.44px;
    color: #cbc5ff;
  }
  .socials {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .social {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    padding: 12px;
    border: 0.75px solid #cbc5ff;
    border-radius: 31.5px;
  }
  .social img {
    display: block;
    width: 24px;
    height: 24px;
  }
  .footer-nav,
  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: 34px;
  }
  .footer-nav h2,
  .footer-contact h2 {
    margin: 0;
    font-size: 16px;
    font-weight: 700;
    line-height: 24px;
    letter-spacing: -0.176px;
    color: #fff;
  }
  .footer-nav ul,
  .footer-contact ul {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer-nav li,
  .footer-contact li {
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    letter-spacing: -0.176px;
    color: #fff;
    white-space: nowrap;
  }
  .bottom {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .divider {
    height: 1px;
    margin: 0;
    border: 0;
    background: rgb(203 197 255 / 30%);
  }
  .legal {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .legal p {
    margin: 0;
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    color: #fff;
    white-space: nowrap;
  }
  .legal-links {
    display: flex;
    align-items: center;
    gap: 30px;
  }
  .legal-links span {
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    color: #fff;
    white-space: nowrap;
  }
  @media (max-width: 1300px) {
    .top {
      gap: 60px;
    }
  }
  @media (max-width: 1050px) {
    .footer {
      gap: 48px;
      padding-top: 64px;
    }
    .top {
      flex-wrap: wrap;
      gap: 56px;
    }
    .brand {
      flex-basis: 100%;
    }
    .legal {
      justify-content: space-between;
      gap: 24px;
    }
  }
  @media (max-width: 600px) {
    .footer {
      gap: 40px;
      padding-top: 56px;
    }
    .top {
      flex-direction: column;
      gap: 44px;
    }
    .legal {
      flex-wrap: wrap;
    }
    .legal p,
    .legal-links span {
      white-space: normal;
    }
  }
</style>
