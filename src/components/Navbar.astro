---
import Button from './Button.astro';
interface Props {
  active?: string;
}
const { active = 'Home' } = Astro.props;
const links = [
  'Home',
  'About Us',
  'Recruitment',
  'Hall of Frames',
  'Partners',
  'Contact',
];
// Only pages that exist get a real destination; the rest stay unavailable.
const destinations: Record<string, string> = {
  Home: '/',
  Recruitment: '/recruitment',
};
---

<header class="navbar">
  <div class="navbar-inner">
    <a
      class="brand"
      href="/"
      aria-label="Data Sorcerers home"
      data-sfx="select"
      data-sfx-hover="hover"
      data-astro-prefetch
    >
      <img src="/images/logo.png" width="54" height="59" alt="Data Sorcerers" />
    </a>
    <div class="desktop-menu">
      <nav aria-label="Main navigation">
        {links.map((label, i) =>
          destinations[label] ? (
            <a
              class:list={['nav-link', { active: label === active }]}
              href={destinations[label]}
              aria-current={label === active ? 'page' : undefined}
              style={`--i:${i + 1}`}
              data-sfx="select"
              data-sfx-hover="hover"
              data-astro-prefetch
            >
              <span class="nav-label">{label}</span>
              <span class="nav-underline" aria-hidden="true" />
            </a>
          ) : (
            <span class="nav-link" aria-disabled="true" style={`--i:${i + 1}`}>
              <span class="nav-label">{label}</span>
              <span class="nav-underline" aria-hidden="true" />
            </span>
          ),
        )}
      </nav>
      <Button variant="white">Join Community</Button>
    </div>
    <details class="mobile-menu">
      <summary aria-label="Toggle navigation" data-sfx-hover="hover">
        <span></span>
        <span></span>
        <span></span>
      </summary>
      <nav aria-label="Mobile navigation">
        {links.map((label, i) =>
          destinations[label] ? (
            <a
              class:list={['nav-link', { active: label === active }]}
              href={destinations[label]}
              aria-current={label === active ? 'page' : undefined}
              style={`--i:${i + 1}`}
              data-sfx="select"
              data-sfx-hover="hover"
              data-astro-prefetch
            >
              <span class="nav-label">{label}</span>
              <span class="nav-underline" aria-hidden="true" />
            </a>
          ) : (
            <span class="nav-link" aria-disabled="true" style={`--i:${i + 1}`}>
              <span class="nav-label">{label}</span>
              <span class="nav-underline" aria-hidden="true" />
            </span>
          ),
        )}
        <Button variant="white">Join Community</Button>
      </nav>
    </details>
  </div>
</header>
<style>
  /* Matches Figma node 755:15178 (component set 530:13894): 1440-wide bar,
     padding 24px 80px, logo | menu → 90px → CTA, active tab = 1px gradient
     underline, inactive tabs #707070. Reference: assets/Navbar.png (5×). */
  .navbar {
    --nb-h: 106.8px;
    /* Lift the bar clear of the status bar / notch on installed PWAs. */
    --nb-safe: env(safe-area-inset-top, 0px);
    --nb-frame: 1440px;
    --nb-gutter: clamp(24px, 5.5556vw, 80px);
    --nb-gap: clamp(32px, 6.25vw, 90px);
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    background: transparent;
  }
  /* Figma's own fill: a faint violet wash at the top fading to nothing. */
  .navbar::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgb(108 59 255 / 10%) 0%,
      rgb(11 7 18 / 0%) 100%
    );
    transition: opacity 0.3s ease;
  }
  /* Solid backing only after scrolling so content never shines through the links. */
  .navbar::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0;
    pointer-events: none;
    background: rgb(6 5 10 / 45%);
    backdrop-filter: blur(12px) saturate(130%);
    -webkit-backdrop-filter: blur(12px) saturate(130%);
    transition: opacity 0.3s ease;
  }
  .navbar.is-scrolled::before {
    opacity: 0;
  }
  .navbar.is-scrolled::after {
    opacity: 1;
  }
  .navbar-inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: var(--nb-frame);
    height: var(--nb-h);
    margin-top: var(--nb-safe);
    margin-inline: auto;
    padding: 24px var(--nb-gutter);
  }
  .brand {
    position: relative;
    display: block;
  }
  .brand img {
    display: block;
    width: 54px;
    height: 58.8px;
  }
  /* Menu sits in a right-aligned group with the CTA (Figma auto-layout:
     logo + [menu → 90px → CTA] under space-between). */
  .desktop-menu {
    display: flex;
    align-items: center;
    gap: var(--nb-gap);
  }
  .desktop-menu nav {
    display: flex;
    align-items: center;
    gap: clamp(6px, 1.25vw, 18px);
  }
  .nav-link {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 8px clamp(8px, 0.9722vw, 14px);
    color: #707070;
    font-size: clamp(15px, 1.25vw, 18px);
    font-weight: 500;
    line-height: 27px;
    white-space: nowrap;
    transition: color 0.25s ease;
  }
  .nav-label {
    display: block;
  }
  .nav-underline {
    display: block;
    align-self: stretch;
    height: 1px;
    background: linear-gradient(163deg, #9b7bff 0%, #ede8ff 0%, #9b7bff 100%);
  }
  .nav-link:not(.active) .nav-underline {
    visibility: hidden;
  }
  .nav-link[aria-disabled='true'] {
    cursor: default;
    opacity: 0.82;
  }
  a.nav-link:hover,
  a.nav-link:focus-visible {
    color: #fff;
  }
  a.nav-link.active {
    color: #fff;
  }
  .mobile-menu {
    display: none;
  }
  /* Desktop >=1301px locks the exact Figma tab widths (component set 530:13894)
     so the menu is 753px wide and nobody depends on font rasterisation. */
  @media (min-width: 1301px) {
    .desktop-menu {
      gap: 90px;
    }
    .desktop-menu nav {
      gap: 18px;
    }
    .nav-link {
      padding: 8px 14px;
      font-size: 18px;
    }
    .desktop-menu nav > .nav-link:nth-child(1) {
      width: 78px;
    }
    .desktop-menu nav > .nav-link:nth-child(2) {
      width: 106px;
    }
    .desktop-menu nav > .nav-link:nth-child(3) {
      width: 134px;
    }
    .desktop-menu nav > .nav-link:nth-child(4) {
      width: 146px;
    }
    .desktop-menu nav > .nav-link:nth-child(5) {
      width: 101px;
    }
    .desktop-menu nav > .nav-link:nth-child(6) {
      width: 98px;
    }
  }
  @media (max-width: 1050px) {
    .navbar {
      --nb-h: 94px;
      --nb-gutter: var(--page-gutter);
    }
    .navbar-inner {
      height: var(--nb-h);
      padding: 18px var(--nb-gutter);
    }
    .desktop-menu {
      display: none;
    }
    .mobile-menu {
      display: block;
    }
    summary {
      position: relative;
      z-index: 3;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 4px;
      width: 44px;
      height: 44px;
      padding: 10px;
      cursor: pointer;
      background: none;
      border: 1px solid transparent;
      border-radius: 14px;
      list-style: none;
      transition:
        background-color 0.3s ease,
        border-color 0.3s ease;
    }
    /* Once the bar is backed, the burger reads as its own glass button. */
    .navbar.is-scrolled summary {
      background: rgb(255 255 255 / 8%);
      border-color: rgb(255 255 255 / 12%);
    }
    summary::-webkit-details-marker {
      display: none;
    }
    summary span {
      display: block;
      height: 2px;
      width: 22px;
      border-radius: 2px;
      background: white;
      filter: drop-shadow(0 1px 2px rgb(0 0 0 / 65%));
      transition:
        transform 0.4s cubic-bezier(0.68, -0.6, 0.32, 1.6),
        opacity 0.2s ease;
    }
    summary span:nth-child(2) {
      width: 14px;
    }
    .mobile-menu[open] summary span:nth-child(1) {
      transform: translateY(6px) rotate(45deg);
    }
    .mobile-menu[open] summary span:nth-child(2) {
      opacity: 0;
    }
    .mobile-menu[open] summary span:nth-child(3) {
      transform: translateY(-6px) rotate(-45deg);
    }
    .mobile-menu nav {
      position: fixed;
      inset: 0;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 4px;
      opacity: 1;
      transform: none;
      padding: calc(94px + 32px + env(safe-area-inset-top, 0px))
        var(--page-gutter) max(32px, env(safe-area-inset-bottom));
      overflow-y: auto;
      overscroll-behavior: contain;
      background: rgb(5 5 7 / 94%);
      border: 0;
      border-radius: 0;
      box-shadow: none;
      transition:
        opacity 0.32s ease,
        transform 0.32s ease;
    }
    .mobile-menu:not([open]) nav {
      display: none;
    }
    .mobile-menu.is-closing nav {
      opacity: 0;
      transform: translateY(-10px);
    }
    @starting-style {
      .mobile-menu[open] nav {
        opacity: 0;
        transform: translateY(-10px);
      }
    }
    .mobile-menu .nav-link {
      display: flex;
      flex-direction: row;
      gap: 0;
      padding: 16px 14px;
      font-size: 20px;
      line-height: 30px;
      color: #707070;
      border-radius: 14px;
    }
    .mobile-menu .nav-underline {
      display: none;
    }
    .mobile-menu .nav-link:not(.active):hover,
    .mobile-menu .nav-link:not(.active):focus-visible {
      color: #fff;
      background: rgb(255 255 255 / 8%);
    }
    .mobile-menu .nav-link.active {
      color: #fff;
      background: linear-gradient(
        90deg,
        rgb(108 59 255 / 30%),
        rgb(108 59 255 / 0%)
      );
    }
    .mobile-menu nav :global(.button) {
      width: 100%;
      margin-top: 32px;
    }
  }
  @media (max-width: 760px) {
    .mobile-menu nav {
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .navbar.is-ready .brand,
    .navbar.is-ready .desktop-menu .nav-link,
    .navbar.is-ready .desktop-menu .button {
      animation: nav-in 0.6s cubic-bezier(0.22, 0.61, 0.36, 1) both;
      animation-delay: calc(var(--i, 0) * 55ms + 80ms);
    }
    .navbar.is-ready .desktop-menu .button {
      animation-delay: 0.5s;
    }
  }
  @keyframes nav-in {
    from {
      opacity: 0;
      transform: translateY(-12px);
      filter: blur(6px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    summary span,
    .nav-link,
    .mobile-menu nav,
    .navbar,
    .navbar-inner,
    .brand,
    summary,
    .navbar::before,
    .navbar::after {
      transition: none;
    }
  }
  /* Premium hover for the navbar CTA only (keeps other white buttons as-is). */
  :global(.navbar .button.white) {
    transition:
      background 0.3s ease,
      color 0.3s ease,
      box-shadow 0.3s ease,
      transform 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.navbar .button.white:hover) {
      transform: translateY(-1px);
      box-shadow:
        inset -2px -2px 4px rgb(178 211 255 / 90%),
        inset -8px -6px 8px rgb(226 202 255 / 25%),
        inset -2px -2px 1.4px #97bfff,
        inset 0 2px 1.2px #cfdfff,
        0 10px 26px -10px rgb(108 59 255 / 75%);
    }
    :global(.navbar .button.white:active) {
      transform: translateY(0);
    }
  }
  :global(.navbar .button.white::before) {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    background: linear-gradient(
      105deg,
      transparent 34%,
      rgb(108 59 255 / 26%) 50%,
      transparent 66%
    );
    background-size: 240% 100%;
    background-position: 130% 0;
    background-repeat: no-repeat;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.navbar .button.white:hover::before) {
      animation: nav-sheen 0.7s ease both;
    }
  }
  @keyframes nav-sheen {
    0% {
      opacity: 0;
      background-position: 130% 0;
    }
    18% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      background-position: -30% 0;
    }
  }
  :global(body.menu-open) {
    overflow: hidden;
  }
</style>
<script>
  // Re-initialised after every client-side navigation: the navbar element is
  // replaced by the swap, and the `window`/`document` listeners must not pile up.
  let navController: AbortController | undefined;
  const initNavbar = () => {
    navController?.abort();
    navController = new AbortController();
    const { signal } = navController;

    const navbar = document.querySelector<HTMLElement>('.navbar');

    const syncScroll = () => {
      if (!navbar) return;
      const y = window.scrollY;
      // Small hysteresis so sitting on the threshold does not flicker the backing.
      const wasScrolled = navbar.classList.contains('is-scrolled');
      navbar.classList.toggle('is-scrolled', wasScrolled ? y > 6 : y > 10);
    };

    syncScroll();
    let scrollRaf = 0;
    addEventListener(
      'scroll',
      () => {
        if (scrollRaf) return;
        scrollRaf = requestAnimationFrame(() => {
          scrollRaf = 0;
          syncScroll();
        });
      },
      { passive: true, signal },
    );
    addEventListener('resize', syncScroll, { signal });

    const armNav = () => navbar?.classList.add('is-ready');
    if (document.documentElement.classList.contains('splash-done')) {
      armNav();
    } else {
      addEventListener('ds:splash-done', armNav, { once: true });
      setTimeout(armNav, 7000);
    }

    const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
    const nav = menu?.querySelector<HTMLElement>('nav');
    const summary = menu?.querySelector<HTMLElement>('summary');
    const reduceMotion = () =>
      matchMedia('(prefers-reduced-motion: reduce)').matches;

    let closeTimer: ReturnType<typeof setTimeout> | undefined;

    const openMenu = () => {
      if (!menu) return;
      clearTimeout(closeTimer);
      menu.classList.remove('is-closing');
      menu.open = true;
      window.dispatchEvent(
        new CustomEvent('ds:sfx', { detail: { cue: 'open' } }),
      );
      nav?.querySelector<HTMLElement>('a')?.focus();
    };

    const closeMenu = () => {
      if (!menu?.open) return;
      window.dispatchEvent(
        new CustomEvent('ds:sfx', { detail: { cue: 'close' } }),
      );
      if (reduceMotion() || !nav) {
        menu.classList.remove('is-closing');
        menu.open = false;
        return;
      }
      if (menu.classList.contains('is-closing')) return;
      menu.classList.add('is-closing');
      const finish = (event?: Event) => {
        if (event && event.target !== nav) return;
        nav.removeEventListener('transitionend', finish);
        clearTimeout(closeTimer);
        menu.classList.remove('is-closing');
        menu.open = false;
      };
      nav.addEventListener('transitionend', finish);
      closeTimer = setTimeout(finish, 450);
    };

    summary?.addEventListener('click', (event) => {
      event.preventDefault();
      if (menu?.open) closeMenu();
      else openMenu();
    });

    document.addEventListener(
      'keydown',
      (event) => {
        if (event.key === 'Escape' && menu?.open) {
          closeMenu();
          summary?.focus();
        }
      },
      { signal },
    );
    document.addEventListener(
      'click',
      (event) => {
        if (
          menu?.open &&
          event.target instanceof Node &&
          !menu.contains(event.target)
        )
          closeMenu();
      },
      { signal },
    );

    // Keep the obscured page out of the tab order while the full-screen menu is
    // open, so keyboard focus cannot leak behind the overlay.
    const background = [
      document.querySelector('main'),
      document.querySelector('.footer'),
      document.querySelector('.skip-link'),
    ].filter((el): el is HTMLElement => el instanceof HTMLElement);
    const syncLock = () => {
      const open = !!menu?.open;
      document.body.classList.toggle('menu-open', open);
      for (const el of background) el.toggleAttribute('inert', open);
    };
    menu?.addEventListener('toggle', syncLock);
    addEventListener(
      'resize',
      () => {
        if (menu?.open && innerWidth > 1050) {
          clearTimeout(closeTimer);
          menu.classList.remove('is-closing');
          menu.open = false;
        }
      },
      { signal },
    );
  };

  document.addEventListener('astro:page-load', initNavbar);
</script>
