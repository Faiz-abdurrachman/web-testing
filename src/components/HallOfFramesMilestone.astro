---
const blurb =
  'lorem ipsum dolor sit amet consectetur adipiscing elit voluptatum quibusdam in excepteur lorem assumenda dolore nam occaecat anim ex minim proident exercitation laborum eos tempor quod voluptas pariatur proident blanditiis aut est.';
const milestones = [
  { year: '2024', title: 'Our First Focused' },
  { year: '2025', title: 'Our First Focused' },
  { year: '2026', title: 'Our First Focused' },
];
---

<section class="hof-milestone" aria-labelledby="hof-milestone-title">
  <div class="milestone-header">
    <h2 id="hof-milestone-title">Community Milestone</h2>
    <p>{blurb}</p>
  </div>
  <div class="milestone-list">
    <img
      class="milestone-rail"
      src="/images/hof/milestone/rail.webp"
      srcset="/images/hof/milestone/rail.webp 1x, /images/hof/milestone/rail-2x.webp 2x"
      width="14"
      height="414"
      alt=""
      aria-hidden="true"
      loading="lazy"
      decoding="async"
    />
    {milestones.map((m) => (
      <div class="milestone-row">
        <span class="milestone-year">{m.year}</span>
        <div class="milestone-content">
          <h3>{m.title}</h3>
          <p>{blurb}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  /* Matches Figma node 1439:4699 (1440 × 987): padding 100px 80px, gap 80.
     Header 1108 wide (gap 24); timeline rows (gap 58) are `year (64) → 146 →
     content (944)` with an absolutely-placed gradient rail (node 1439:4709,
     exported as an image) at x130/y21. Content is placeholder lorem. */
  .hof-milestone {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 80px;
    padding: 100px 80px;
    /* Full-screen standard (#9): one screen (content 787 > viewport stays 987). */
    min-height: 100vh;
    min-height: 100svh;
    background: #050507;
  }

  .milestone-header {
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 1108px;
    max-width: 100%;
  }

  .milestone-header h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 56px;
    font-weight: 700;
    line-height: 84px;
    letter-spacing: -0.011em;
    background: linear-gradient(181deg, #fff 15%, #999 42%, #fff 79%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .milestone-header p {
    margin: 0;
    color: #fff;
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 500;
    line-height: 27px;
  }

  .milestone-list {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 58px;
  }

  .milestone-rail {
    position: absolute;
    left: 130px;
    top: 21px;
    width: 14px;
    height: 414px;
    pointer-events: none;
  }

  .milestone-row {
    display: flex;
    align-items: flex-start;
    gap: 146px;
  }

  .milestone-year {
    width: 64px;
    flex: none;
    font-family: var(--font-body);
    font-size: 26px;
    font-weight: 600;
    line-height: 42px;
    background: linear-gradient(180deg, #6c3bff 0%, #fff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .milestone-content {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 944px;
    max-width: 100%;
  }

  .milestone-content h3 {
    margin: 0;
    font-family: var(--font-body);
    font-size: 36px;
    font-weight: 600;
    line-height: 48px;
    background: linear-gradient(180deg, #6c3bff 0%, #fff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .milestone-content p {
    margin: 0;
    color: #fff;
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 500;
    line-height: 27px;
  }

  @media (max-width: 900px) {
    .hof-milestone {
      gap: 56px;
      padding: 64px var(--page-gutter);
    }
    .milestone-header h2 {
      font-size: clamp(34px, 7vw, 56px);
      line-height: 1.3;
    }
    .milestone-rail {
      display: none;
    }
    .milestone-row {
      flex-direction: column;
      gap: 12px;
    }
    .milestone-content {
      width: 100%;
    }
  }
</style>
