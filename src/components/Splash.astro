  role="status"
  aria-label="Loading Data Sorcerers"
>
  <svg class="splash-defs" width="0" height="0" aria-hidden="true">
    <defs>
      <linearGradient id="splash-arc-grad" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#e8c877"></stop>
        <stop offset="0.55" stop-color="#c9a4ff"></stop>
        <stop offset="1" stop-color="#9b7bff"></stop>
      </linearGradient>
      <linearGradient id="splash-crystal-grad" x1="0" y1="0" x2="0.6" y2="1">
        <stop offset="0" stop-color="#6b3fd6"></stop>
        <stop offset="0.42" stop-color="#2a1650"></stop>
        <stop offset="1" stop-color="#0a0614"></stop>
      </linearGradient>
    </defs>
  </svg>

  <div class="splash-beam" aria-hidden="true"></div>
  <div class="splash-smoke" aria-hidden="true"></div>
  <div class="splash-sky" aria-hidden="true">
    {sparks.map((spark) => (
      <span
        class="splash-spark"
        style={`--x:${spark.x}%;--y:${spark.y}%;--d:${spark.delay}s;--t:${spark.duration}s;--s:${spark.size}px`}
      />
    ))}
  </div>

  <div class="splash-floor" aria-hidden="true">
    <div class="splash-reflection"></div>
    <svg
      class="splash-ripples"
      viewBox="0 0 1000 300"
      preserveAspectRatio="none"
    >
      {ripples.map((ring) => (
        <ellipse
          class={ring.cls}
