---
interface Props {
  webm: string;
  mp4: string;
  poster: string;
}

const { webm, mp4, poster } = Astro.props;
---

<video
  class="art-video"
  data-poster={poster}
  muted
  loop
  playsinline
  preload="none"
  aria-hidden="true"
>
  <source src={webm} type="video/webm" />
  <source src={mp4} type="video/mp4" />
</video>
