---
import DomainCard from './DomainCard.astro';
import { domains } from '../data/domains';
---

<section id="domains" class="domains" aria-labelledby="domains-title">
  <header>
    <span class="eyebrow">House of Data Sorcerers</span>
    <h2 id="domains-title">Choose Your Domain</h2>
    <p>
      Every Sorcerer specializes. Find your domain and go deep with a community
      of experts.
    </p>
  </header>
  <div class="domain-carousel">
    <button
      class="rail-arrow prev"
      type="button"
      aria-label="Previous domains"
      data-dir="-1"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M15 5l-7 7 7 7"></path>
      </svg>
    </button>
    <div
      class="domain-rail"
      tabindex="0"
      role="region"
      aria-label="Domains — scroll horizontally to explore all six"
    >
      {domains.map((domain) => (
        <DomainCard domain={domain} />
      ))}
    </div>
    <button
      class="rail-arrow next"
      type="button"
      aria-label="Next domains"
      data-dir="1"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M9 5l7 7-7 7"></path>
      </svg>
    </button>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('.domain-rail').forEach((rail) => {
    const carousel = rail.closest('.domain-carousel');
    const arrows = carousel
      ? [...carousel.querySelectorAll<HTMLButtonElement>('.rail-arrow')]
      : [];
    const step = () =>
      (rail.querySelector('.domain-card')?.getBoundingClientRect().width ??
        394) + (parseFloat(getComputedStyle(rail).columnGap) || 0);

    arrows.forEach((arrow) =>
      arrow.addEventListener('click', () => {
        rail.scrollBy({
          left: Number(arrow.dataset.dir) * step(),
          behavior: 'smooth',
        });
      }),
    );

    const sync = () => {
      const max = rail.scrollWidth - rail.clientWidth;
      if (arrows[0]) arrows[0].disabled = rail.scrollLeft <= 1;
      if (arrows[1]) arrows[1].disabled = rail.scrollLeft >= max - 1;
    };
    rail.addEventListener('scroll', sync, { passive: true });
    sync();

    rail.addEventListener('keydown', (event) => {
      const positions: Record<string, number> = {
        ArrowLeft: rail.scrollLeft - step(),
        ArrowRight: rail.scrollLeft + step(),
        Home: 0,
        End: rail.scrollWidth,
      };
      if (event.key in positions) {
        event.preventDefault();
        rail.scrollTo({ left: positions[event.key], behavior: 'instant' });
      }
    });
  });
</script>
<style>
  .domains {
    padding-block: 80px;
    background: #050507;
  }
  header {
    padding-inline: var(--page-gutter);
    text-align: center;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 26px;
    padding: 4px 12px;
    border-radius: 32px;
    background: rgb(255 255 255 / 15%);
    box-shadow: inset 0 1px 1px rgb(255 255 255 / 40%);
    font-size: 12px;
    line-height: 18px;
  }
  h2 {
    margin: 14px 0 24px;
    font: 400 56px/68px var(--font-heading);
    background: linear-gradient(270deg, #fff, #ede8ff);
    background-clip: text;
    color: transparent;
  }
  header p {
    margin: 0;
    font-size: 16px;
    line-height: 24px;
    letter-spacing: -0.176px;
  }
  .domain-carousel {
    position: relative;
    margin-top: 74px;
  }
  .domain-rail {
    display: flex;
    gap: 40px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    padding-inline: max(var(--page-gutter), calc((100vw - 1280px) / 2));
    scrollbar-width: none;
  }
  .domain-rail::-webkit-scrollbar {
    display: none;
  }
  .domain-rail:focus-visible {
    outline: 2px solid #bba7ff;
    outline-offset: 6px;
  }
  .rail-arrow {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    transform: translateY(-50%);
    border: 1px solid rgb(203 197 255 / 45%);
    border-radius: 50%;
    background: rgb(16 9 35 / 72%);
    backdrop-filter: blur(6px);
    cursor: pointer;
  }
  .rail-arrow svg {
    width: 26px;
    height: 26px;
    fill: none;
    stroke: #fff;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .rail-arrow.prev {
    left: 20px;
  }
  .rail-arrow.next {
    right: 20px;
  }
  .rail-arrow:disabled {
    opacity: 0.3;
    cursor: default;
  }
  @media (max-width: 760px) {
    .domains {
      padding-block: 64px;
    }
    h2 {
      font-size: clamp(30px, 7vw, 48px);
      line-height: 1.214286;
    }
    .domain-carousel {
      margin-top: 40px;
    }
    .domain-rail {
      padding-inline: 24px;
      gap: 24px;
    }
    .rail-arrow {
      display: none;
    }
  }
</style>
