---
import Button from './Button.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="artwork" aria-hidden="true">
    <div class="artwork-entrance">
      <div class="artwork-stack">
        <img
          class="art-bg"
          src="/images/hero/background.webp"
          width="1583"
          height="993"
          alt=""
          fetchpriority="high"
          decoding="async"
        />
        <img
          class="art-figure"
          src="/images/hero/figure.webp"
          width="1583"
          height="993"
          alt=""
          decoding="async"
        />
        <video
          class="art-video"
          muted
          loop
          playsinline
          preload="none"
          poster="/images/hero/background.webp"
        >
          <source src="/images/hero/hero-bg.webm" type="video/webm" />
          <source src="/images/hero/hero-bg.mp4" type="video/mp4" />
        </video>
      </div>
    </div>
  </div>
  <canvas class="hero-canvas" aria-hidden="true"></canvas>
  <div class="hero-veil" aria-hidden="true"></div>
  <div class="hero-sweep" aria-hidden="true"></div>
  <div class="hero-content">
    <div class="copy">
      <div class="title-wrap">
        <h1 id="hero-title">
          <span>SORCERY IN DATA</span>
          <span>MAGIC IN AI</span>
        </h1>
        <div class="strike" aria-hidden="true">
          <svg
            class="bolt bolt-1"
            viewBox="0 0 600 60"
            preserveAspectRatio="none"
          >
            <defs>
              <linearGradient id="strike-grad-1" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="#9b7bff" stop-opacity="0" />
                <stop offset="0.1" stop-color="#9b7bff" stop-opacity="0.65" />
                <stop offset="0.55" stop-color="#e8e0ff" stop-opacity="1" />
                <stop offset="0.9" stop-color="#e8e0ff" stop-opacity="0.8" />
                <stop offset="1" stop-color="#e8e0ff" stop-opacity="0" />
              </linearGradient>
            </defs>
            <path
              class="halo"
              pathLength="100"
              d="M0 30 L77.5 12.3 L152.3 44.5 L205.2 13.4 L260.6 46.7 L333.5 16.4 L449.3 39.5 L492.1 22.9 L600 33.1"
            />
            <path
              class="core"
              pathLength="100"
              d="M0 30 L77.5 12.3 L152.3 44.5 L205.2 13.4 L260.6 46.7 L333.5 16.4 L449.3 39.5 L492.1 22.9 L600 33.1"
            />
          </svg>
          <svg
            class="bolt bolt-2"
            viewBox="0 0 600 60"
            preserveAspectRatio="none"
          >
            <defs>
              <linearGradient id="strike-grad-2" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="#9b7bff" stop-opacity="0" />
                <stop offset="0.1" stop-color="#9b7bff" stop-opacity="0.65" />
                <stop offset="0.55" stop-color="#e8e0ff" stop-opacity="1" />
                <stop offset="0.9" stop-color="#e8e0ff" stop-opacity="0.8" />
                <stop offset="1" stop-color="#e8e0ff" stop-opacity="0" />
              </linearGradient>
            </defs>
            <path
              class="halo"
              pathLength="100"
              d="M0 30 L80.7 22.2 L128 36.4 L213.1 18.9 L301.3 39.4 L351.6 18.4 L393.4 47.3 L441.2 22.2 L526.7 43.8 L600 32.5"
            />
            <path
              class="core"
              pathLength="100"
              d="M0 30 L80.7 22.2 L128 36.4 L213.1 18.9 L301.3 39.4 L351.6 18.4 L393.4 47.3 L441.2 22.2 L526.7 43.8 L600 32.5"
            />
          </svg>
          <span class="strike-burst"></span>
        </div>
      </div>
      <p>
        An AI &amp; Data Innovation Community where people learn, experiment,
        research, and build meaningful technology together.
      </p>
    </div>
    <div class="actions" aria-label="Community actions">
      <Button>Join the Community</Button>
      <Button variant="glass">Explore Our Project</Button>
    </div>
  </div>
</section>
<script>
  // Three.js particle field over the hero art. Dynamically imported so it stays
  // out of the initial bundle, and skipped entirely under reduced motion. The
  // scroll sequence in `motion.ts` drives `window.__heroParticles.burst` so the
  // field rushes toward the viewer as the hero zooms in.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Assets the splash should await before lifting (see Splash.astro).
  const preload = (window as unknown as { __dsPreload?: Promise<unknown>[] })
    .__dsPreload;

  // Animated background. Only fetched on larger, motion-OK viewports; under
  // reduced motion (or ≤600px) the static art stays and the clip is never
  // downloaded, so the fallback is always the reference art. It plays on a
  // continuous loop (the clip is a seamless ping-pong boomerang), and is never
  // scrubbed by scroll, so it keeps moving whether or not the visitor scrolls.
  const video = document.querySelector<HTMLVideoElement>('.art-video');
  if (video) {
    const wide = window.matchMedia('(min-width: 601px)').matches;
    const conn = (
      navigator as unknown as {
        connection?: { saveData?: boolean; effectiveType?: string };
      }
    ).connection;
    const constrained =
      conn?.saveData === true ||
      conn?.effectiveType === 'slow-2g' ||
      conn?.effectiveType === '2g';
    if (!reduce && wide && !constrained) {
      const start = () => {
        video.classList.add('is-ready');
        void video.play().catch(() => {});
      };
      if (video.readyState >= 2) start();
      else video.addEventListener('loadeddata', start, { once: true });
      const load = () => {
        video.preload = 'auto';
        video.load();
      };
      const armed = document.documentElement.classList.contains('splash-armed');
      if (armed) {
        // Fetch during the splash and let it wait for the first frame, so the
        // clip is ready instead of competing with the reveal.
        preload?.push(
          new Promise<void>((resolve) => {
            if (video.readyState >= 2) resolve();
            else
              video.addEventListener('loadeddata', () => resolve(), {
                once: true,
              });
          }),
        );
        load();
      } else if (typeof window.requestIdleCallback === 'function') {
        window.requestIdleCallback(load, { timeout: 2000 });
      } else {
        window.setTimeout(load, 300);
      }
    }
  }

  const canvas = document.querySelector<HTMLCanvasElement>('.hero-canvas');
  const host = canvas?.parentElement;

  if (canvas && host && !reduce) {
    const threeImport = import('three');
    preload?.push(threeImport);
    const THREE = await threeImport;
    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.75));

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(60, 1, 0.1, 100);
    camera.position.z = 9;

    const count = 700;
    const positions = new Float32Array(count * 3);
    const colors = new Float32Array(count * 3);
    const speeds = new Float32Array(count);
    const palette = [
      new THREE.Color(0x9b7bff),
      new THREE.Color(0xd9c7ff),
      new THREE.Color(0xffffff),
      new THREE.Color(0x6c3bff),
    ];
    for (let i = 0; i < count; i++) {
      positions[i * 3] = (Math.random() - 0.5) * 20;
      positions[i * 3 + 1] = (Math.random() - 0.5) * 11;
      positions[i * 3 + 2] = (Math.random() - 0.5) * 8;
      speeds[i] = 0.002 + Math.random() * 0.008;
      const color = palette[i % palette.length];
      colors[i * 3] = color.r;
      colors[i * 3 + 1] = color.g;
      colors[i * 3 + 2] = color.b;
    }
    const geometry = new THREE.BufferGeometry();
    geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));

    // A soft radial sprite so points read as glowing motes, not squares.
    const sprite = (() => {
      const size = 64;
      const el = document.createElement('canvas');
      el.width = el.height = size;
      const ctx = el.getContext('2d');
      if (!ctx) return null;
      const grad = ctx.createRadialGradient(
        size / 2,
        size / 2,
        0,
        size / 2,
        size / 2,
        size / 2,
      );
      grad.addColorStop(0, 'rgba(255,255,255,1)');
      grad.addColorStop(0.35, 'rgba(206,186,255,0.65)');
      grad.addColorStop(1, 'rgba(120,80,255,0)');
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, size, size);
      return new THREE.CanvasTexture(el);
    })();

    const material = new THREE.PointsMaterial({
      size: 0.14,
      map: sprite,
      vertexColors: true,
      transparent: true,
      opacity: 0.85,
      depthWrite: false,
      blending: THREE.AdditiveBlending,
    });
    const points = new THREE.Points(geometry, material);
    scene.add(points);

    const state = { burst: 0 };
    (
      window as unknown as { __heroParticles?: { burst: number } }
    ).__heroParticles = state;

    const resize = () => {
      const width = host.clientWidth;
      const height = host.clientHeight;
      renderer.setSize(width, height, false);
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
    };
    resize();
    window.addEventListener('resize', resize);

    let pointerX = 0;
    let pointerY = 0;
    window.addEventListener('mousemove', (event) => {
      pointerX = event.clientX / window.innerWidth - 0.5;
      pointerY = event.clientY / window.innerHeight - 0.5;
    });

    let visible = true;
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
    }).observe(host);

    const tick = () => {
      requestAnimationFrame(tick);
      if (!visible) return;
      const t = performance.now() / 1000;
      const boost = 1 + state.burst * 7;
      const attr = geometry.attributes.position;
      for (let i = 0; i < count; i++) {
        const y = attr.getY(i) + speeds[i] * boost;
        attr.setY(i, y > 5.5 ? -5.5 : y);
      }
      attr.needsUpdate = true;
      points.rotation.y =
        Math.sin(t * 0.1) * 0.12 + pointerX * 0.25 + state.burst * 1.1;
      points.rotation.x = pointerY * 0.18;
      material.size = 0.14 + state.burst * 0.16;
      material.opacity = 0.85 - state.burst * 0.15;
      camera.position.z = 9 - state.burst * 4.5;
      renderer.render(scene, camera);
    };
    tick();
  }
</script>
<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: min(903px, 100svh);
    padding: 140px var(--page-gutter) 64px;
    overflow: clip;
  }
  .artwork {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .artwork-entrance,
  .artwork-stack {
    position: absolute;
    inset: 0;
  }
  .artwork :is(img, video) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .art-video {
    opacity: 0;
    object-position: 80% center;
    transition: opacity 700ms ease;
  }
  .art-video.is-ready {
    opacity: 1;
  }
  .hero-content {
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 7svh, 96px);
    max-width: 1280px;
    margin-inline: auto;
    width: 100%;
  }
  .copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  h1 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 80px;
    font-weight: 400;
    line-height: 98px;
    background: linear-gradient(
      267.1deg,
      #fff 5.29%,
      #dfdfdf 46.05%,
      #dfdfdf 99.19%
    );
    background-clip: text;
    color: transparent;
  }
  h1 span {
    display: block;
  }
  /* Lightning strike that flashes as each headline line resolves. Sits behind
     the text (h1 is lifted on its own layer) and is invisible until the
     hero-ready animations run, so the reduced-motion render is untouched. */
  .title-wrap {
    position: relative;
    isolation: isolate;
  }
  h1 {
    position: relative;
    z-index: 1;
  }
  .strike {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .bolt {
    position: absolute;
    left: 0;
    width: 100%;
    height: 52px;
    overflow: visible;
  }
  .bolt path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    opacity: 0;
  }
  .bolt-1 :is(.halo, .core) {
    stroke: url(#strike-grad-1);
  }
  .bolt-2 :is(.halo, .core) {
    stroke: url(#strike-grad-2);
  }
  .bolt .halo {
    stroke-width: 13;
    stroke-opacity: 0.4;
    filter: blur(4px);
  }
  .bolt .core {
    stroke-width: 2;
    stroke-opacity: 1;
    filter: blur(0.4px);
  }
  .bolt-1 {
    top: 14%;
  }
  .bolt-2 {
    top: 62%;
  }
  .strike-burst {
    position: absolute;
    top: 14%;
    right: 6%;
    width: 280px;
    height: 280px;
    opacity: 0;
    filter: blur(12px);
    background: radial-gradient(
      circle,
      rgb(216 200 255 / 45%),
      transparent 64%
    );
    transform: translate(30%, -50%) scale(0.6);
  }
  p {
    margin: 0;
    max-width: 619px;
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    letter-spacing: -0.176px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    align-items: center;
  }
  .hero-veil,
  .hero-sweep {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hero-veil {
    z-index: 2;
    background: var(--color-background);
    opacity: 0;
  }
  .hero-sweep {
    z-index: 2;
    overflow: hidden;
  }
  .hero-sweep::before {
    content: '';
    position: absolute;
    top: -30%;
    bottom: -30%;
    left: 0;
    width: 38%;
    background: linear-gradient(
      90deg,
      transparent,
      rgb(216 209 240 / 12%),
      transparent
    );
    opacity: 0;
    transform: translate3d(-120%, 0, 0) skewX(-16deg);
  }
  .hero-canvas {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .hero-content {
    position: relative;
    z-index: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.hero-ready) .artwork-entrance {
      animation: hero-art 1.6s cubic-bezier(0.22, 0.61, 0.36, 1) both;
    }
    :global(html.hero-ready) .hero-veil {
      animation: hero-veil 1.1s ease-out both;
    }
    :global(html.hero-ready) .hero-sweep::before {
      animation: hero-sweep 2.4s cubic-bezier(0.22, 0.61, 0.36, 1) 0.4s both;
    }
    :global(html.hero-ready) h1 span {
      animation: hero-line 0.95s cubic-bezier(0.22, 0.61, 0.36, 1) both;
    }
    :global(html.hero-ready) h1 span:nth-child(1) {
      animation-delay: 0.45s;
    }
    :global(html.hero-ready) h1 span:nth-child(2) {
      animation-delay: 0.6s;
    }
    :global(html.hero-ready) .copy p {
      animation: hero-up 0.9s cubic-bezier(0.22, 0.61, 0.36, 1) 0.78s both;
    }
    :global(html.hero-ready) .actions {
      animation: hero-up 0.9s cubic-bezier(0.22, 0.61, 0.36, 1) 0.95s both;
    }
    :global(html.hero-ready) .bolt path {
      animation: strike-draw 0.5s ease-out both;
    }
    :global(html.hero-ready) .bolt-1 path {
      animation-delay: 0.42s;
    }
    :global(html.hero-ready) .bolt-2 path {
      animation-delay: 0.57s;
    }
    :global(html.hero-ready) .strike-burst {
      animation: strike-burst 0.5s ease-out 0.58s both;
    }
  }
  @keyframes hero-art {
    from {
      filter: blur(10px) brightness(0.72);
      transform: scale(1.1);
    }
    to {
      filter: blur(0) brightness(1);
      transform: scale(1);
    }
  }
  @keyframes hero-veil {
    from {
      opacity: 0.92;
    }
    to {
      opacity: 0;
    }
  }
  @keyframes hero-sweep {
    0% {
      opacity: 0;
      transform: translate3d(-120%, 0, 0) skewX(-16deg);
    }
    15% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translate3d(280%, 0, 0) skewX(-16deg);
    }
  }
  @keyframes hero-line {
    from {
      opacity: 0;
      transform: translateY(38px);
      filter: blur(10px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: blur(0);
    }
  }
  @keyframes hero-up {
    from {
      opacity: 0;
      transform: translateY(22px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes strike-draw {
    0% {
      opacity: 0;
      stroke-dashoffset: 100;
    }
    8% {
      opacity: 0.95;
    }
    55% {
      opacity: 0.95;
      stroke-dashoffset: 0;
    }
    68% {
      opacity: 0.2;
    }
    80% {
      opacity: 0.9;
    }
    100% {
      opacity: 0;
      stroke-dashoffset: 0;
    }
  }
  @keyframes strike-burst {
    0% {
      opacity: 0;
      transform: translate(30%, -50%) scale(0.6);
    }
    22% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translate(30%, -50%) scale(1.25);
    }
  }
  @media (min-width: 1921px) {
    .artwork {
      left: 50%;
      right: auto;
      width: 1920px;
      transform: translateX(-50%);
      mask-image: linear-gradient(
        90deg,
        transparent,
        #000 12%,
        #000 88%,
        transparent
      );
    }
    .artwork :is(img, video) {
      object-position: center bottom;
    }
  }
  @media (max-width: 1100px) {
    h1 {
      font-size: clamp(42px, 6.5vw, 72px);
      line-height: 1.225;
    }
    .hero {
      min-height: min(820px, 100svh);
    }
  }
  @media (max-width: 900px) {
    .actions {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  @media (max-width: 600px) {
    .hero {
      min-height: 100vh;
      min-height: 100svh;
      /* Track the visible viewport so the next section cannot peek under the mobile address bar. */
      min-height: 100dvh;
      padding-top: clamp(96px, 12svh, 120px);
      padding-bottom: clamp(64px, 9svh, 96px);
      align-items: center;
    }
    .artwork :is(img, video) {
      object-position: 61% center;
    }
    .artwork::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(
        180deg,
        rgb(5 5 7 / 25%),
        rgb(5 5 7 / 15%) 45%,
        transparent 70%
      );
    }
    .hero-content {
      gap: clamp(28px, 7vw, 48px);
    }
    .copy {
      gap: clamp(16px, 4.5vw, 24px);
    }
    h1 {
      font-size: clamp(28px, 7vw, 42px);
      line-height: 1.2;
    }
    p {
      max-width: 380px;
      font-size: clamp(15px, 3.9vw, 16px);
      line-height: 1.5;
    }
    .actions {
      gap: clamp(12px, 3.5vw, 20px);
    }
  }
  @media (max-width: 600px) and (min-height: 561px) {
    .artwork .art-figure {
      top: auto;
      bottom: 0;
      height: 80%;
      object-position: 50.5% bottom;
    }
  }
  @media (min-width: 400px) and (max-width: 600px) and (min-height: 561px) {
    .artwork .art-figure {
      height: 74%;
      object-position: 54% bottom;
    }
  }
  @media (min-width: 381px) and (max-width: 399px) and (min-height: 561px) {
    .artwork .art-figure {
      height: 74%;
      object-position: 52.5% bottom;
    }
  }
  @media (max-width: 360px) and (min-height: 561px) {
    .artwork .art-figure {
      height: 72%;
      object-position: 46% bottom;
    }
  }
  @media (min-width: 341px) and (max-width: 360px) and (min-height: 561px) {
    .artwork .art-figure {
      object-position: 47% bottom;
    }
  }
  @media (max-width: 340px) and (min-height: 561px) {
    .artwork .art-figure {
      height: 72%;
      object-position: 38.5% bottom;
    }
  }
  @media (max-width: 480px) {
    .actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
  @media (max-height: 560px) {
    .hero {
      padding-top: clamp(56px, 13svh, 96px);
      padding-bottom: clamp(28px, 7svh, 64px);
    }
    .hero-content {
      gap: clamp(14px, 4.5svh, 32px);
    }
    .copy {
      gap: 12px;
    }
    h1 {
      font-size: clamp(22px, 8.5svh, 52px);
      line-height: 1.15;
    }
    p {
      font-size: clamp(13px, 3.6svh, 16px);
      line-height: 1.4;
    }
    .artwork :is(img, video) {
      object-position: 61% bottom;
    }
  }
</style>
