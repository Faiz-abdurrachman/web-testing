---
import Button from './Button.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <picture class="artwork">
    <img
      src="/images/backgrounds/hero.webp"
      width="1440"
      height="903"
      alt=""
      fetchpriority="high"
      decoding="async"
    />
  </picture>
  <div class="hero-content">
    <div class="copy">
      <h1 id="hero-title">
        <span>SORCERY IN DATA</span>
        <span>MAGIC IN AI</span>
      </h1>
      <p>
        An AI &amp; Data Innovation Community where people learn, experiment,
        research, and build meaningful technology together.
      </p>
    </div>
    <div class="actions" aria-label="Community actions">
      <Button>Join the Community</Button>
      <Button variant="glass">Explore Our Project</Button>
    </div>
  </div>
</section>
<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: min(903px, 100svh);
    padding: 140px var(--page-gutter) 64px;
    overflow: clip;
  }
  .artwork {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .artwork img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-content {
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 7svh, 96px);
    max-width: 1280px;
    margin-inline: auto;
    width: 100%;
  }
  .copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  h1 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 80px;
    font-weight: 400;
    line-height: 98px;
    background: linear-gradient(
      267.1deg,
      #fff 5.29%,
      #dfdfdf 46.05%,
      #dfdfdf 99.19%
    );
    background-clip: text;
    color: transparent;
  }
  h1 span {
    display: block;
  }
  p {
    margin: 0;
    max-width: 619px;
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    letter-spacing: -0.176px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    align-items: center;
  }
  @media (min-width: 1921px) {
    .artwork {
      left: 50%;
      right: auto;
      width: 1920px;
      transform: translateX(-50%);
      mask-image: linear-gradient(
        90deg,
        transparent,
        #000 12%,
        #000 88%,
        transparent
      );
    }
    .artwork img {
      object-position: center bottom;
    }
  }
  @media (max-width: 1100px) {
    h1 {
      font-size: clamp(42px, 6.5vw, 72px);
      line-height: 1.225;
    }
    .hero {
      min-height: min(820px, 100svh);
    }
  }
  @media (max-width: 600px) {
    .hero {
      min-height: min(800px, 100svh);
      padding-top: 130px;
      padding-bottom: 180px;
      align-items: flex-start;
    }
    .artwork img {
      object-position: 61% center;
    }
    .artwork::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(
        180deg,
        rgb(5 5 7 / 25%),
        rgb(5 5 7 / 15%) 45%,
        transparent 70%
      );
    }
    .hero-content {
      gap: 40px;
    }
    .copy {
      gap: 22px;
    }
    h1 {
      font-size: clamp(27px, 6.5vw, 39px);
      line-height: 1.3;
    }
    p {
      max-width: 380px;
      font-size: 15px;
      line-height: 24px;
    }
    .actions {
      gap: 16px;
    }
  }
</style>
