---
---

<section class="partners-hero" aria-labelledby="partners-hero-title">
  <div class="artwork" aria-hidden="true">
    <picture>
      <source
        type="image/webp"
        srcset="/images/partners/hero-bg.webp 1x, /images/partners/hero-bg-2x.webp 2x"
        width="1440"
        height="665"
      />
      <img
        class="art-bg"
        src="/images/partners/hero-bg.webp"
        width="1440"
        height="665"
        alt=""
        fetchpriority="high"
        decoding="async"
      />
    </picture>
  </div>
  <div class="hero-content">
    <span class="pill">Create · Collaborate · Make an impact</span>
    <h1 id="partners-hero-title">
      <span>Let's Build Something</span>
      <span>Meaningful Together.</span>
    </h1>
  </div>
</section>

<style>
  /* Matches Figma node 1301:3740 (1440 x 665): padding 242px 80px 160px,
     gap 14px, centred. Pill 12/18 Manrope 400 on rgba(255,255,255,.15),
     headline 80/102 Nasalization. Background = the two-hand artwork. */
  .partners-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    min-height: 665px;
    padding: 242px 80px 160px;
    box-sizing: border-box;
    overflow: clip;
    background: var(--color-background);
    text-align: center;
  }
  .artwork {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .artwork picture,
  .artwork .art-bg {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    width: 100%;
    max-width: 1280px;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px 12px;
    border-radius: 32px;
    background: rgb(255 255 255 / 15%);
    color: #fff;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 400;
    line-height: 18px;
    white-space: nowrap;
  }
  h1 {
    margin: 0;
    width: 100%;
    font-family: var(--font-heading);
    font-size: 80px;
    font-weight: 400;
    line-height: 102px;
    letter-spacing: normal;
    color: #fff;
    text-align: center;
  }
  h1 span {
    display: block;
  }

  @media (max-width: 1100px) {
    .partners-hero {
      min-height: min(760px, 100svh);
      padding: calc(94px + 64px) 48px 96px;
    }
    h1 {
      font-size: clamp(40px, 6.5vw, 68px);
      line-height: 1.2;
    }
  }
  @media (max-width: 760px) {
    h1 span {
      display: inline;
    }
  }
  @media (max-width: 600px) {
    .partners-hero {
      min-height: 100vh;
      min-height: 100svh;
      justify-content: center;
      padding: clamp(110px, 18svh, 150px) 24px clamp(48px, 10svh, 72px);
    }
    h1 {
      font-size: clamp(30px, 8.4vw, 44px);
      line-height: 1.2;
    }
  }
</style>
