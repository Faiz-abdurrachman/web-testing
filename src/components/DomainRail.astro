---
import DomainCard from './DomainCard.astro';
import { domains } from '../data/domains';
interface Props {
  base?: string;
  suffix?: string;
}
const { base = '/hods', suffix = '' } = Astro.props;
---

<div class="domain-carousel">
  <button
    class="rail-arrow prev"
    type="button"
    aria-label="Previous domains"
    data-dir="-1"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M15 5l-7 7 7 7"></path>
    </svg>
  </button>
  <div
    class="domain-rail"
    tabindex="0"
    role="region"
    aria-label="Domains — scroll horizontally to explore all six"
  >
    {domains.map((domain, index) => (
      <DomainCard
        domain={domain}
        href={`${base}/${domain.id}${suffix}`}
        index={index}
      />
    ))}
  </div>
  <button
    class="rail-arrow next"
    type="button"
    aria-label="Next domains"
    data-dir="1"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M9 5l7 7-7 7"></path>
    </svg>
  </button>
</div>
<script>
  document.querySelectorAll<HTMLElement>('.domain-rail').forEach((rail) => {
    const carousel = rail.closest('.domain-carousel');
    const arrows = carousel
      ? [...carousel.querySelectorAll<HTMLButtonElement>('.rail-arrow')]
      : [];
    const step = () =>
      (rail.querySelector('.domain-card')?.getBoundingClientRect().width ??
        394) + (parseFloat(getComputedStyle(rail).columnGap) || 0);

    arrows.forEach((arrow) =>
      arrow.addEventListener('click', () => {
        rail.scrollBy({
          left: Number(arrow.dataset.dir) * step(),
          behavior: matchMedia('(prefers-reduced-motion: reduce)').matches
            ? 'auto'
            : 'smooth',
        });
      }),
    );

    const sync = () => {
      const max = rail.scrollWidth - rail.clientWidth;
      if (arrows[0]) arrows[0].disabled = rail.scrollLeft <= 1;
      if (arrows[1]) arrows[1].disabled = rail.scrollLeft >= max - 1;
    };
    rail.addEventListener('scroll', sync, { passive: true });
    sync();
    new ResizeObserver(sync).observe(rail);

    // Touch already scrolls natively; add click-drag for mouse users.
    let dragging = false;
    let pressed = false;
    let suppressClick = false;
    let startX = 0;
    let startLeft = 0;
    rail.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'mouse' || event.button !== 0) return;
      pressed = true;
      dragging = false;
      suppressClick = false;
      startX = event.clientX;
      startLeft = rail.scrollLeft;
    });
    rail.addEventListener('pointermove', (event) => {
      if (!pressed) return;
      if (!dragging && Math.abs(event.clientX - startX) < 6) return;
      if (!dragging) {
        dragging = true;
        suppressClick = true;
        rail.classList.add('is-dragging');
        rail.setPointerCapture(event.pointerId);
      }
      rail.scrollLeft = startLeft - (event.clientX - startX);
    });
    const endDrag = (event: PointerEvent) => {
      pressed = false;
      dragging = false;
      rail.classList.remove('is-dragging');
      if (rail.hasPointerCapture(event.pointerId))
        rail.releasePointerCapture(event.pointerId);
    };
    rail.addEventListener('pointerup', endDrag);
    rail.addEventListener('pointercancel', endDrag);
    rail.addEventListener('pointerleave', (event) => {
      if (!dragging) endDrag(event);
    });
    rail.addEventListener('dragstart', (event) => event.preventDefault());
    rail.addEventListener(
      'click',
      (event) => {
        if (suppressClick && event.detail !== 0) {
          event.preventDefault();
          event.stopPropagation();
          suppressClick = false;
        }
      },
      true,
    );

    rail.addEventListener('keydown', (event) => {
      const positions: Record<string, number> = {
        ArrowLeft: rail.scrollLeft - step(),
        ArrowRight: rail.scrollLeft + step(),
        Home: 0,
        End: rail.scrollWidth,
      };
      if (event.key in positions) {
        event.preventDefault();
        rail.scrollTo({ left: positions[event.key], behavior: 'instant' });
      }
    });

    // Arrow keys also drive the rail when its section is the one at the
    // viewport centre, without needing to focus it first.
    const section = rail.closest('section') ?? rail;
    addEventListener('keydown', (event) => {
      if (event.defaultPrevented) return;
      const target = event.target as HTMLElement | null;
      if (target?.closest('input, textarea, select, [contenteditable="true"]'))
        return;
      const rect = section.getBoundingClientRect();
      const center = innerHeight / 2;
      if (rect.top > center || rect.bottom < center) return;
      const behavior: ScrollBehavior = matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches
        ? 'auto'
        : 'smooth';
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        rail.scrollBy({ left: -step(), behavior });
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        rail.scrollBy({ left: step(), behavior });
      }
    });
  });
</script>
<style>
  .domain-carousel {
    position: relative;
    margin: 74px auto 0;
    width: min(1280px, calc(100% - 2 * var(--page-gutter)));
  }
  .domain-rail {
    display: flex;
    gap: 40px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    padding: 0;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 0;
    scrollbar-width: none;
    cursor: grab;
  }
  .domain-rail :global(.domain-card) {
    flex-basis: calc((100% - 80px) / 3);
    scroll-snap-align: start;
  }
  .domain-rail.is-dragging {
    scroll-snap-type: none;
    user-select: none;
    cursor: grabbing;
  }
  .domain-rail::-webkit-scrollbar {
    display: none;
  }
  .domain-rail:focus-visible {
    outline: 2px solid #bba7ff;
    outline-offset: 6px;
  }
  .rail-arrow {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    transform: translateY(-50%);
    border: 1px solid rgb(203 197 255 / 60%);
    border-radius: 50%;
    background: rgb(16 9 35 / 85%);
    backdrop-filter: blur(6px);
    cursor: pointer;
  }
  .rail-arrow svg {
    width: 26px;
    height: 26px;
    fill: none;
    stroke: #fff;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .rail-arrow.prev {
    left: -64px;
  }
  .rail-arrow.next {
    right: -64px;
  }
  .rail-arrow:disabled {
    opacity: 0.3;
    cursor: default;
  }
  @media (max-width: 1200px) {
    .domain-carousel {
      margin-bottom: 66px;
    }
    .domain-rail :global(.domain-card) {
      flex-basis: calc((100% - 40px) / 2);
    }
    .rail-arrow {
      top: auto;
      bottom: -66px;
      transform: none;
    }
    .rail-arrow.prev {
      left: 0;
    }
    .rail-arrow.next {
      right: 0;
    }
  }
  @media (max-width: 760px) {
    .domain-rail :global(.domain-card) {
      flex-basis: 100%;
      max-width: none;
    }
    .domain-rail {
      padding-inline: 0;
      gap: 24px;
    }
    .rail-arrow {
      top: auto;
      bottom: -52px;
      width: 40px;
      height: 40px;
      transform: none;
    }
    .rail-arrow svg {
      width: 20px;
      height: 20px;
    }
    .rail-arrow.prev {
      left: 0;
    }
    .rail-arrow.next {
      right: 0;
    }
  }
</style>
