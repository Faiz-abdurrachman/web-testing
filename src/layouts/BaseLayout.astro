---
import '../styles/global.css';
interface Props {
  title?: string;
}
const { title = 'Data Sorcerers — Sorcery in Data, Magic in AI' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="An AI & Data Innovation Community where people learn, experiment, research, and build meaningful technology together."
    />
    <meta name="theme-color" content="#050507" />
    <link rel="icon" href="/images/logo.png" type="image/png" />
    <link
      rel="preload"
      href="/fonts/manrope-400.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/manrope-500.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/manrope-600.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <slot />
  </body>
</html>
