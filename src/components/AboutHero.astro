---
---

<section class="about-hero" aria-labelledby="about-hero-title">
  <div class="artwork" aria-hidden="true">
    <picture>
      <source
        type="image/webp"
        media="(max-width: 600px)"
        srcset="/images/about/hero-bg-mobile.webp"
        width="960"
        height="602"
      />
      <source
        type="image/webp"
        srcset="/images/about/hero-bg.webp 1x, /images/about/hero-bg-2x.webp 2x"
        width="1440"
        height="903"
      />
      <img
        class="art-bg"
        src="/images/about/hero-bg.webp"
        width="1440"
        height="903"
        alt=""
        fetchpriority="high"
        decoding="async"
      />
    </picture>
  </div>
  <div class="hero-content">
    <h1 id="about-hero-title">
      <span>Architecting the Future of</span>
      <span>AI &amp; Data Innovation.</span>
    </h1>
    <p>
      Data Sorcerers is an AI &amp; Data Innovation Community dedicated to
      developing people, knowledge, research, and technology through
      collaborative learning and real-world experimentation.
    </p>
  </div>
</section>

<style>
  /* Matches Figma node 1248:14725 (1440 x 903).
     Centered Frame 2607 (1280 x 287) at y = 308px:
     Headline 80px/95.2px Nasalization, Subtitle 18px/27px Manrope 500,
     gap 16px. Background = high-definition cosmic portal artwork. */
  .about-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 903px;
    padding: 0 var(--page-gutter);
    overflow: clip;
    text-align: center;
  }

  .artwork {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .artwork picture,
  .artwork .art-bg {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
  }

  h1 {
    margin: 0;
    width: 100%;
    max-width: 1124px;
    font-family: var(--font-heading);
    font-size: 80px;
    font-weight: 400;
    line-height: 95.2px;
    letter-spacing: -0.88px;
    color: #ffffff;
    text-align: center;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  h1 span {
    display: block;
  }

  p {
    margin: 0;
    width: 100%;
    max-width: 680px;
    color: #ffffff;
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 500;
    line-height: 27px;
    letter-spacing: 0;
    text-align: center;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  @media (max-width: 1100px) {
    .about-hero {
      min-height: min(780px, 100svh);
      padding-top: calc(94px + 32px);
    }
    h1 {
      font-size: clamp(40px, 5.5vw, 68px);
      line-height: 1.18;
      letter-spacing: -0.5px;
    }
    p {
      font-size: clamp(16px, 1.8vw, 18px);
      line-height: 1.5;
    }
  }

  @media (max-width: 760px) {
    h1 span {
      display: inline;
    }
  }

  @media (max-width: 600px) {
    .about-hero {
      /* svh, not dvh — dvh reflows with the address bar */
      min-height: 100vh;
      min-height: 100svh;
      justify-content: center;
      padding-top: clamp(100px, 15svh, 130px);
      padding-bottom: clamp(40px, 8svh, 60px);
    }
    .hero-content {
      gap: 16px;
    }
    h1 {
      font-size: clamp(26px, 7.5vw, 40px);
      line-height: 1.2;
      letter-spacing: -0.3px;
    }
    p {
      font-size: clamp(14px, 3.8vw, 16px);
      line-height: 1.55;
    }
  }
</style>
